  "version": 2,
  "buildCommand": "node scripts/dwac-cycle69-exit-probe.mjs",
  "functions": { "api/*.mjs": { "maxDuration": 60 } },
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp.mjs" },
