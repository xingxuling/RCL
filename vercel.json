{
  "version": 2,
  "buildCommand": "mkdir -p public && (node scripts/verify-version-contract.mjs > public/cycle88-version-contract-diagnostic.json || true)",
  "functions": {
    "api/mcp.mjs": {
      "maxDuration": 30
    },
    "api/health.mjs": {
      "maxDuration": 30
    },
    "api/capability-truth.mjs": {
      "maxDuration": 30
    },
    "api/bridge-statepath-truth.mjs": {
      "maxDuration": 30
    },
    "api/release-runtime-truth.mjs": {
      "maxDuration": 30
    },
    "api/runtime-health.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp.mjs" },
    { "src": "/health", "dest": "/api/runtime-health.mjs" },
    { "src": "/capability-truth", "dest": "/api/capability-truth.mjs" },
    { "src": "/bridge-statepath-truth", "dest": "/api/bridge-statepath-truth.mjs" },
    { "src": "/release-runtime-truth", "dest": "/api/release-runtime-truth.mjs" },
    { "src": "/", "dest": "/api/runtime-health.mjs" }
  ]
}
