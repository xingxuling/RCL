{
  "version": 2,
  "buildCommand": "node scripts/build-vercel-native.mjs",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/mcp",
      "dest": "/api/mcp.mjs"
    },
    {
      "src": "/health",
      "dest": "/api/health.mjs"
    },
    {
      "src": "/",
      "dest": "/api/health.mjs"
    }
  ]
}
