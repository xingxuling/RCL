{
  "version": 2,
  "buildCommand": "node scripts/dwac-cycle59-exit-probe.mjs",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/mcp",
      "dest": "/api/mcp.mjs"
    },
    {
      "src": "/health",
      "dest": "/api/health.mjs"
    },
    {
      "src": "/capability-truth",
      "dest": "/api/capability-truth.mjs"
    },
    {
      "src": "/",
      "dest": "/api/health.mjs"
    }
  ]
}
