__constant uint SHA_K[64]={0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
uint sha_rotr(uint x,int n){return (x>>n)|(x<<(32-n));}
int sha256_text(Heap* h,int input,Control* m){text_flat(h,input,m);Value value=h->v[input];if(value.type!=3){m->error=9;return 0;}uint digest[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};int blocks=(value.length+9+63)/64;ulong bits=(ulong)value.length*8;
  for(int block=0;block<blocks;block++){uint w[64];for(int i=0;i<16;i++){uint word=0;for(int j=0;j<4;j++){int p=block*64+i*4+j;uchar b=p<value.length?h->text[value.first+p]:p==value.length?128:p>=blocks*64-8?(uchar)(bits>>((blocks*64-1-p)*8)):0;word=(word<<8)|b;}w[i]=word;}for(int i=16;i<64;i++){uint a=w[i-15],b=w[i-2];w[i]=(sha_rotr(a,7)^sha_rotr(a,18)^(a>>3))+w[i-16]+(sha_rotr(b,17)^sha_rotr(b,19)^(b>>10))+w[i-7];}uint a=digest[0],b=digest[1],c=digest[2],d=digest[3],e=digest[4],f=digest[5],g=digest[6],v=digest[7];for(int i=0;i<64;i++){uint t=v+(sha_rotr(e,6)^sha_rotr(e,11)^sha_rotr(e,25))+((e&f)^(~e&g))+SHA_K[i]+w[i];uint u=(sha_rotr(a,2)^sha_rotr(a,13)^sha_rotr(a,22))+((a&b)^(a&c)^(b&c));v=g;g=f;f=e;e=d+t;d=c;c=b;b=a;a=t+u;}digest[0]+=a;digest[1]+=b;digest[2]+=c;digest[3]+=d;digest[4]+=e;digest[5]+=f;digest[6]+=g;digest[7]+=v;}
  char result[64];__constant const char* hex="0123456789abcdef";for(int i=0;i<32;i++){uint byte=digest[i/4]>>((3-i%4)*8);result[i*2]=hex[(byte>>4)&15];result[i*2+1]=hex[byte&15];}return text_private_new(h,result,64,m);
}
int text_constant_matches(Heap* h,int id,__constant const char* word,int length){Value v=h->v[id];if(v.type!=3||v.length!=length)return 0;for(int i=0;i<length;i++)if(h->text[v.first+i]!=(uchar)word[i])return 0;return 1;}
int decimal_syntax(const char* text,int length,int* nonzero){int i=0,digits=0;*nonzero=0;if(i<length&&text[i]=='-')i++;while(i<length&&text[i]>='0'&&text[i]<='9'){*nonzero|=text[i]!='0';i++;digits++;}if(i<length&&text[i]=='.'){i++;while(i<length&&text[i]>='0'&&text[i]<='9'){*nonzero|=text[i]!='0';i++;digits++;}}if(!digits)return 0;if(i<length&&(text[i]=='e'||text[i]=='E')){i++;if(i<length&&(text[i]=='-'||text[i]=='+'))i++;int exponent_digits=0;while(i<length&&text[i]>='0'&&text[i]<='9'){i++;exponent_digits++;}if(!exponent_digits)return 0;}return i==length;}
int device_builtin(Heap* h,Control* m,__global Machine* machine,int builtin,int argc,int* args){Value a=h->v[argc?args[0]:0];
  if(builtin==12)return seq_empty(h,m);
  if(builtin==13)return seq_append(h,args[0],args[1],m);
  if(builtin==62)return seq_concat(h,args[0],args[1],m);
  if(builtin==14){Value b=h->v[args[1]];if(b.type!=1||!isfinite(b.number)||floor(b.number)!=b.number||b.number<0||b.number>=a.length){m->error=2;return 0;}return seq_item(h,args[0],(int)b.number,m);}
  if(builtin==4)return value_length(h,args[0],m);
  if(builtin==7)return scalar_text(h,args[0],m);
  if(builtin==21){for(int i=0;i<4;i++)if(h->v[args[i]].type!=1||floor(h->v[args[i]].number)!=h->v[args[i]].number||h->v[args[i]].number<(i==1||i==2?1:0)||h->v[args[i]].number>2147483647){m->error=28;return 0;}int id=value_new(h,5,0);if(!id){m->error=1;return 0;}h->v[id].first=(int)h->v[args[0]].number;h->v[id].length=(int)h->v[args[1]].number;h->v[id].parent=(int)h->v[args[2]].number;h->v[id].tail=(int)h->v[args[3]].number;return id;}
  if(builtin==46){if(a.type!=2||h->v[args[1]].type!=3||h->v[args[2]].type!=3||h->v[args[3]].type!=5){m->error=9;return 0;}if(!a.number){text_flat(h,args[1],m);text_flat(h,args[2],m);if(m->error)return 0;m->diagnostic_code=keep(h,args[1]);m->diagnostic_detail=keep(h,args[2]);m->diagnostic_line=h->v[args[3]].length;m->diagnostic_column=h->v[args[3]].parent;m->error=26;return 0;}return boolean(h,1,m);}
  if(builtin>=63&&builtin<=67){if(a.type!=1||!isfinite(a.number)){m->error=9;return 0;}uchar bytes[8];int length=builtin==63?1:builtin==64?2:builtin==67?8:4;ulong bits=0;if(builtin==67)bits=as_ulong(a.number);else{double low=builtin==66?-2147483648.:0,high=builtin==63?255.:builtin==64?65535.:builtin==66?2147483647.:4294967295.;if(a.number<low||a.number>high||floor(a.number)!=a.number){m->error=29;return 0;}bits=builtin==66?(ulong)(uint)(int)a.number:(ulong)a.number;}for(int i=0;i<length;i++)bytes[i]=(uchar)(bits>>(i*8));return byte_private_sequence(h,m,machine,bytes,length);}
  if(a.type!=3){m->error=9;return 0;}text_flat(h,args[0],m);if(m->error)return 0;a=h->v[args[0]];
  if(builtin==68)return byte_sequence(h,m,machine,h->text+a.first,a.length);
  if(builtin==70)return sha256_text(h,args[0],m);
  if(builtin==69){if(a.length%2){m->error=30;return 0;}int id=value_new(h,4,0),at=block_new(h,a.length/2,1);if(!id||at<0){m->error=1;return 0;}h->v[id].length=a.length/2;h->v[id].cache=at;h->v[id].aux=3;for(int i=0;i<a.length/2;i++){int n=0;for(int j=0;j<2;j++){int c=h->text[a.first+i*2+j],v=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:-1;if(v<0){m->error=30;break;}n=n*16+v;}h->index[at+i]=machine->byte_value[n];}return id;}
  if(builtin==11){int start=0,end=a.length;while(start<end&&ascii_space(h->text[a.first+start]))start++;while(end>start&&ascii_space(h->text[a.first+end-1]))end--;if(start==end)return numeric(h,0,m);if(h->text[a.first+start]=='+')start++;if(end-start>127){m->error=31;return 0;}char buffer[128];for(int i=start;i<end;i++)buffer[i-start]=(char)h->text[a.first+i];int nonzero=0;if(!decimal_syntax(buffer,end-start,&nonzero)){m->error=31;return 0;}double number=0;enum Status status=s2d_n(buffer,end-start,&number);if(status!=SUCCESS||!isfinite(number)||(nonzero&&fabs(number)<0x1p-1022)){m->error=31;return 0;}return numeric(h,number,m);}
  if(builtin>=1&&builtin<=3){text_flat(h,args[1],m);Value b=h->v[args[1]];if(b.type!=3){m->error=9;return 0;}int at=text_find(h,args[0],args[1],m),matched=at>=0;if(builtin==2)matched=at==0;if(builtin==3){matched=a.length>=b.length;for(int i=0;matched&&i<b.length;i++)if(h->text[a.first+a.length-b.length+i]!=h->text[b.first+i])matched=0;}return boolean(h,matched,m);}
  if(builtin==5||builtin==6){int id=text_new(h,a.length,m);if(m->error)return 0;for(int i=0;i<a.length;i++){int c=h->text[a.first+i];h->text[h->v[id].first+i]=(uchar)(builtin==5&&c>='A'&&c<='Z'?c+32:builtin==6&&c>='a'&&c<='z'?c-32:c);}return id;}
  if(builtin==8){int start=0,end=a.length;while(start<end&&ascii_space(h->text[a.first+start]))start++;while(end>start&&ascii_space(h->text[a.first+end-1]))end--;return text_bytes_view(h,args[0],start,end-start,m);}
  if(builtin==9||builtin==10){Value b=h->v[args[1]];if(b.type!=3){m->error=9;return 0;}int at=text_find(h,args[0],args[1],m),first=builtin==9?0:at<0?a.length:at+b.length,length=builtin==9?(at<0?a.length:at):a.length-first;return text_bytes_view(h,args[0],first,length,m);}
  if(builtin==15||builtin==16){Value start=h->v[args[1]];if(start.type!=1||!isfinite(start.number)||floor(start.number)!=start.number){m->error=9;return 0;}int count=text_chars(h,args[0],m);if(builtin==15){if(start.number<0||start.number>=count){char empty[1];return text_private_new(h,empty,0,m);}int at=text_offset(h,args[0],(int)start.number);if(h->text[at]<128)return machine->ascii_text[h->text[at]];return text_view(h,args[0],(int)start.number,1,m);}Value length=h->v[args[2]];if(length.type!=1||!isfinite(length.number)||floor(length.number)!=length.number){m->error=9;return 0;}if(start.number<0||length.number<0){m->error=25;return 0;}return text_view(h,args[0],(int)fmin(start.number,(double)count),(int)fmin(length.number,(double)count),m);}
  if(builtin>=17&&builtin<=20){int c=a.length?h->text[a.first]:0,count=text_chars(h,args[0],m),matched=0;if(builtin==17)matched=a.length==1&&ascii_space(c);if(builtin==18)matched=a.length==1&&c>='0'&&c<='9';if(builtin==19||builtin==20)matched=count==1&&((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_'||c>=128||(builtin==20&&c>='0'&&c<='9'));return boolean(h,matched,m);}
  m->error=10;return 0;
}
