* text=auto eol=lf

*.exe binary
*.a binary
*.dll binary
*.lib binary
*.rbc binary
*.wasm binary
native/linux/rclvm binary
native/linux/rclc binary
# Runtime receipts bind these manifests byte for byte, including captured CRLF.
native/wasi/build-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
native/linux/build-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the exact licensed upstream bytes recorded by PROVENANCE.json.
src/vendor/browser-wasi-shim/* -text
# Freeze upstream RNCS bytes exactly as identified in PROVENANCE.json.
src/vendor/rncs-reality-branch/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Retain the exact licensed Ryu upstream bytes identified by its provenance.
native/gpu-text-runtime/vendor/ryu/** -text
# Generated, hash-bound Ryu output retains its concatenated source separators.
native/gpu-text-runtime/ryu-opencl.cl whitespace=-blank-at-eof
# Preserve the actual captured verification log bytes and their recorded hashes.
docs/evidence/selfhost-runtime/* -text whitespace=cr-at-eol
docs/evidence/cold-selfhost/* -text whitespace=cr-at-eol
docs/evidence/sqlite-selfhost/* -text whitespace=cr-at-eol
docs/evidence/worker-selfhost/* -text whitespace=cr-at-eol
docs/evidence/dataflow-selfhost/* -text whitespace=cr-at-eol
docs/evidence/phase-selfhost/* -text whitespace=cr-at-eol
docs/evidence/application-selfhost/* -text whitespace=cr-at-eol
docs/evidence/rncs-selfhost/* -text whitespace=cr-at-eol
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
