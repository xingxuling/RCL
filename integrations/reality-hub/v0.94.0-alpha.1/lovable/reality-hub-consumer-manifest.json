  "compilerAdapters": [
    {
      "id": "demo-simulated",
      "kind": "teaching-demo",
      "availability": "available",
      "canonical": false,
      "mayExecute": false,
      "requiredLabel": "教学模拟，不代表真实 RCL 编译器执行"
    },
    {
      "id": "rcl-mcp-0.94.0-alpha.1",
      "kind": "mcp-json-rpc-http",
      "availability": "configuration-required",
      "canonical": true,
      "serverSideOnly": true,
      "endpointEnvironmentVariable": "RCL_MCP_ENDPOINT",
      "healthEnvironmentVariable": "RCL_MCP_HEALTH_ENDPOINT",
      "defaultOperation": "rcl_compile_source",
      "defaultArguments": {
        "runNative": false
      },
      "nativeExecutionRequiresExplicitUserAction": true,
      "silentFallbackToDemoForbidden": true
    }
  ],
  "selectionPolicy": {
    "defaultAdapter": "demo-simulated",
    "canonicalAdapterMayActivateWhen": [
      "server environment contains RCL_MCP_ENDPOINT",
      "MCP initialize succeeds",
      "tools/list contains rcl_compile_source",
      "rcl_status reports version 0.94.0-alpha.1"
    ],
    "onCanonicalFailure": "block-and-report",
    "never": [
      "silently fall back to demo after a canonical request",
      "show private Release URLs as anonymous public downloads",
      "claim full self-hosting",
      "claim a complete native runtime",
      "treat check as execution"
    ]
  },
  "truthBoundary": {
    "canonicalSource": true,
    "referenceCompiler": "javascript",
    "nativeCoreCompilerSelfHosting": "verified-declared-subset",
    "fullSelfHosting": false,
    "completeNativeRuntime": false,
    "javascriptReferenceRuntimeStillRequired": true,
    "checkNeverExecutesProgram": true
  },
  "verificationCommands": [
    "rcl version --json",
    "rcl doctor",
    "rcl check ./hello-reality.rcl",
    "rcl run ./hello-reality.rcl"
  ],
  "uiStates": [
    "demo-ready",
    "canonical-not-configured",
    "canonical-connecting",
    "canonical-ready",
    "canonical-version-mismatch",
    "canonical-unavailable",
    "private-release-auth-required"
  ]
