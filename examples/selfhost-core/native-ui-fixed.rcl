reality FixedUI {
  ui Frame {
    view Root {
      layout vertical {
        width fill
        height intrinsic
        gap 0
        padding 0
        align stretch
        distribute start
      }
      view Panel {
        layout overlay {
          width fixed 320
          height fixed 180
          gap 8
          padding 12
          align center
          distribute center
          overflow clip
        }
      }
    }
  }
}
