{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DonorMeasurement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "value": {
      "type": "number",
      "required": true,
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "enum": ["kg", "mg/dL", "ml/dL", "mmol/L", "ug/dL"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false,
  "required": ["id", "value", "unit", "confidence"]
}
