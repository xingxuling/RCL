# RCL-owned candidate contract for GQA and RoPE topology over the explicit
# AMD OpenCL matmul hybrid lowering.
reality GpuGqaRopeCandidate {
  reckon positive(value : Number) -> Truth = value > 0

  facet contract.id : Text = "rcl-k08-r-gpu-gqa-rope-v0.1"
  facet contract.canonical_owner : Text = "RCL"
  facet contract.backend : Text = "opencl-amd-hybrid"
  facet contract.gpu_operation_set : Text = "matmul"
  facet contract.topology : Text = "two-query-heads-shared-kv-with-rope"
  facet contract.host_reference_placement : Text = "explicit-per-node"
  facet contract.precision_policy : Text = "BF16_RNE_FORWARD_FP32_REVERSE_ADAMW"
  facet contract.fallback_policy : Text = "FAIL_CLOSED_NO_CPU_FALLBACK"
  facet contract.model_special_opcodes : Truth = false
  facet evaluation.query_heads : Truth = positive(2)
  facet evaluation.shared_kv_path : Truth = true
  facet evaluation.rope_frame_bound : Truth = true
  facet evaluation.gpu_training_claim_closed : Truth = true
  facet evaluation.rcl10m_claim_closed : Truth = true
  facet evidence.authority : Text = "CANDIDATE_ONLY_BOUNDED_GQA_ROPE_OPENCL_FORWARD_MATMULS"
}
