# K08-S: RCL-owned BF16 Autodiff and AdamW semantic genome.
# The CPU binary is an execution organ; dtype, cast, gradient, state and
# checkpoint authority remain explicit RCL semantics.
reality Bf16AutodiffAdamwGenomeCandidate {
  reckon valid_steps(value : Number) -> Truth = value > 0 and value <= 16384
  reckon valid_parameter_order(size : Number) -> Truth = size > 0 and size <= 256
  reckon cast_backward_rule() -> Text = "STRAIGHT_THROUGH_FP32"

  facet contract.id : Text = "k08-s-bf16-autodiff-adamw-genome-v0.2"
  facet contract.canonical_owner : Text = "RCL"
  facet contract.precision_policy : Text = "BF16_RNE_FORWARD_FP32_ACCUMULATION_FP32_GRADIENT_MASTER_STATE"
  facet contract.parameter_compute_dtype : Text = "BF16"
  facet contract.activation_compute_dtype : Text = "BF16"
  facet contract.accumulation_dtype : Text = "FP32"
  facet contract.gradient_dtype : Text = "FP32"
  facet contract.master_weight_dtype : Text = "FP32"
  facet contract.optimizer_state_dtype : Text = "FP32"
  facet contract.bf16_rounding : Text = "ROUND_TO_NEAREST_TIES_TO_EVEN"
  facet contract.cast_backward : Text = cast_backward_rule()
  facet contract.checkpoint_authority : Text = "EXACT_FP32_BITS_CANONICAL_PARAMETER_ORDER"
  facet contract.accelerator_fallback : Text = "NO_SILENT_FALLBACK"
  facet contract.cpu_reference_is_gpu_claim : Truth = false

  facet evaluation.steps_valid : Truth = valid_steps(16)
  facet evaluation.parameter_order_valid : Truth = valid_parameter_order(2)
  facet evaluation.zero_steps_rejected : Truth = not valid_steps(0)
  facet evaluation.excess_steps_rejected : Truth = not valid_steps(16385)
  facet evaluation.gpu_claim_closed : Truth = not contract.cpu_reference_is_gpu_claim

  facet evidence.authority : Text = "CANDIDATE_ONLY_NO_GPU_MULTI_BLOCK_BF16_RCL10M_OR_RCL1B_PROMOTION"
}
