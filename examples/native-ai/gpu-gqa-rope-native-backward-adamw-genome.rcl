# RCL-owned candidate contract for a two-block generic GQA+RoPE graph whose
# matmul gradients and FP32 AdamW updates are lowered to AMD OpenCL.
reality GpuGqaRopeNativeBackwardAdamwCandidate {
  reckon positive(value : Number) -> Truth = value > 0

  facet contract.id : Text = "rcl-k08-r-gpu-gqa-rope-native-backward-adamw-v0.1"
  facet contract.canonical_owner : Text = "RCL"
  facet contract.backend : Text = "opencl-amd-gpu-training"
  facet contract.graph_profile : Text = "TWO_BLOCK_GENERIC_GQA_ROPE"
  facet contract.gpu_primitives : Text = "matmul-gradient-left,matmul-gradient-right,adamw-update"
  facet contract.host_reference_placement : Text = "explicit-per-node"
  facet contract.precision_policy : Text = "BF16_FORWARD_FP32_GRADIENT_FP32_ADAMW"
  facet contract.fallback_policy : Text = "FAIL_CLOSED_NO_CPU_FALLBACK"
  facet contract.model_special_opcodes : Truth = false
  facet evaluation.two_blocks : Truth = positive(2)
  facet evaluation.shared_kv_query_heads : Truth = true
  facet evaluation.gpu_forward_matmul : Truth = true
  facet evaluation.gpu_gradient_primitives : Truth = positive(2)
  facet evaluation.gpu_optimizer_primitive : Truth = true
  facet evaluation.cpu_differential_required : Truth = true
  facet evaluation.gpu_training_claim_closed : Truth = true
  facet evaluation.rcl10m_claim_closed : Truth = true
  facet evidence.authority : Text = "CANDIDATE_ONLY_BOUNDED_TWO_BLOCK_GQA_ROPE_GPU_REVERSE_ADAMW"
}
