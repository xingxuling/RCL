reality CompilerMicrobench {
  facet input.seed : Number = 17
  facet input.scale : Number = 23
  facet stage.s01 : Number = input.seed * input.scale + 11
  facet stage.s02 : Number = stage.s01 * input.scale - input.seed
  facet stage.s03 : Number = stage.s02 + input.scale * 3
  facet stage.s04 : Number = stage.s03 / 5 + input.seed
  facet stage.s05 : Number = stage.s04 / 2 + input.seed
  facet stage.s06 : Number = stage.s05 * input.scale - input.seed
  facet stage.s07 : Number = stage.s06 + input.scale * 3
  facet stage.s08 : Number = stage.s07 / 5 + input.seed
  facet stage.s09 : Number = stage.s08 / 2 + input.seed
  facet stage.s10 : Number = stage.s09 * input.scale - input.seed
  facet stage.s11 : Number = stage.s10 + input.scale * 3
  facet stage.s12 : Number = stage.s11 / 5 + input.seed
  facet stage.s13 : Number = stage.s12 / 2 + input.seed
  facet stage.s14 : Number = stage.s13 * input.scale - input.seed
  facet stage.s15 : Number = stage.s14 + input.scale * 3
  facet stage.s16 : Number = stage.s15 / 5 + input.seed
  facet stage.s17 : Number = stage.s16 / 2 + input.seed
  facet stage.s18 : Number = stage.s17 * input.scale - input.seed
  facet stage.s19 : Number = stage.s18 + input.scale * 3
  facet stage.s20 : Number = stage.s19 / 5 + input.seed
  facet stage.s21 : Number = stage.s20 / 2 + input.seed
  facet stage.s22 : Number = stage.s21 * input.scale - input.seed
  facet stage.s23 : Number = stage.s22 + input.scale * 3
  facet stage.s24 : Number = stage.s23 / 5 + input.seed
  facet result.output : Number = stage.s24
}
