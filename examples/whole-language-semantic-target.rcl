reality WholeLanguageSemanticTarget {
  dialect release {
    layer semantic
    domain execution
    description "Whole language semantic lowering target dialect."
    lowers_to authority, machine
    operation declare_release {
      output ReleasePlan
      effect Evidence
      lowers_to authority
    }
    invariant "release dialect must preserve source program and authority roots"
  }

  effect AlterReality {
    deterministic true
    replay "transition-delta"
    evidence_required true
  }

  effect HostCall {
    deterministic false
    replay "requires-provider-receipt"
    evidence_required true
  }

  capability_policy safe_release {
    allow_effect Warrant, Authority, AlterReality, Preserve, Evidence
    deny_effect HostCall
    allow world.publish on world
    allow computer.invoke on console
    budget max_alterations 3
    budget max_host_calls 1
    budget max_rules 1
    require_deterministic_replay false
  }

  store absorption_reality {
    branch main
    commit "whole language semantic materialized"
  }

  facet world.status : Text = "draft"
  facet world.score : Number = 0
  facet world.receipt : Text = "none"

  reckon ready(value : Number) -> Truth = value >= 0

  host console {
    offers emit -> Text
  }

  subject founder {
    warrant world.publish on world
    warrant computer.invoke on console
  }

  emergence publish {
    cause founder
    when ready(world.score)
    needs world.publish on world
    needs computer.invoke on console
    alter world.status <- "published"
    alter world.score <- world.score + 1
    alter world.receipt <- "pending"
    call console.emit("published") -> world.receipt
    preserve world.score >= 0
    witness "rcl:whole-language-semantic:published"
  }

  foresee publish
  realize publish
  verify safe_release
  snapshot absorption_reality
}
