reality RCLSelfHostDualNeedStage40 {
  facet selfhost.stage : Text = "stage40_rcl_owned_dual_need_warrant_lowering_subset"
  facet selfhost.stage_status : Text = "UNVERIFIED"
  facet selfhost.claim : Text = "rcl_lowers_dual_needs_clauses_to_warrant_bytecode"
  facet selfhost.boundary : Text = "dual_need_warrant_lowering_subset_not_complete_rule_parser_compiler_or_runtime"
  facet selfhost.next_rewrite_target : Text = "rcl_owned_rule_parser_completion_and_compiler_self_emission"

  facet gate.full_self_hosting : Truth = false
  facet gate.rcl_owned_general_expression_parser_subset : Truth = true
  facet gate.rcl_owned_rule_lowering_loop : Truth = true
  facet gate.rcl_owned_facet_warrant_parser_subset : Truth = true
  facet gate.rcl_owned_general_rule_directive_scaling_subset : Truth = true
  facet gate.rcl_owned_multisubject_warrant_parser_subset : Truth = true
  facet gate.rcl_owned_equality_expression_lowering_subset : Truth = true
  facet gate.rcl_owned_comparison_operator_lowering_subset : Truth = true
  facet gate.rcl_owned_arithmetic_operator_lowering_subset : Truth = true
  facet gate.rcl_owned_boolean_connective_lowering_subset : Truth = true
  facet gate.rcl_owned_unary_not_lowering_subset : Truth = true
  facet gate.rcl_owned_dual_need_warrant_lowering_subset : Truth = true
  facet gate.rcl_owned_runtime_complete : Truth = false
  facet gate.rcl_owned_multirule_expression_source_lowering_subset : Truth = true
  facet gate.rcl_owned_rule_expression_source_lowering_subset : Truth = true
