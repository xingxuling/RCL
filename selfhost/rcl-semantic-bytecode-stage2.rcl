reality RCLSelfHostSemanticBytecodeStage2 {
  facet source.core : Text = "module core\nfacet world.value : Number = 7\nfacet world.name : Text = \"Aster\""
  facet source.app : Text = "module app\nimport core\nrequire core world.value : Number\nrequire core world.name : Text\nfacet app.ready : Truth = true"
  facet source.program : Text = "RCLSelfHostedStage2Target"
  facet source.root : Text = "rcl:selfhost-stage2-semantic-bytecode"

  facet selfhost.stage : Text = "stage2_rcl_owned_semantic_ir_bytecode_subset"
  facet selfhost.stage_status : Text = "UNVERIFIED"
  facet selfhost.claim : Text = "rcl_executes_module_semantics_ir_and_rbc_encoding_subset"
  facet selfhost.boundary : Text = "module_facets_import_require_only_js_runtime_still_hosts_execution"
  facet selfhost.next_rewrite_target : Text = "whole_language_parser_surface_and_rule_semantics"

  facet gate.full_self_hosting : Truth = false
  facet gate.rcl_owned_semantic_subset : Truth = true
  facet gate.rcl_owned_ir_subset : Truth = true
  facet gate.rcl_owned_rbc_encoder_subset : Truth = true
  facet gate.js_runtime_still_required : Truth = true

  reckon scan_identifier_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(is_identifier_part(char_at(source, index)),
        scan_identifier_end(source, index + 1),
        index))

  reckon scan_number_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(is_digit(char_at(source, index)),
        scan_number_end(source, index + 1),
        index))

  reckon scan_string_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(char_at(source, index) == "\"",
        index,
        scan_string_end(source, index + 1)))

  reckon tokenize_from(source : Text, index : Number, line : Number, column : Number, output : Sequence) -> Sequence =
    choose(index >= length(source),
      sequence_append(output, make_token("EOF", "<eof>", make_span(index, line, column, 0))),
      choose(is_whitespace(char_at(source, index)),
        choose(char_at(source, index) == "\n",
          tokenize_from(source, index + 1, line + 1, 1, output),
          tokenize_from(source, index + 1, line, column + 1, output)),
        choose(is_identifier_start(char_at(source, index)),
          tokenize_from(
            source,
            scan_identifier_end(source, index + 1),
            line,
            column + scan_identifier_end(source, index + 1) - index,
            sequence_append(output,
              make_token(
                "IDENT",
                slice_text(source, index, scan_identifier_end(source, index + 1) - index),
                make_span(index, line, column, scan_identifier_end(source, index + 1) - index)))),
          choose(is_digit(char_at(source, index)),
            tokenize_from(
              source,
              scan_number_end(source, index + 1),
              line,
              column + scan_number_end(source, index + 1) - index,
              sequence_append(output,
                make_token(
                  "NUMBER",
                  slice_text(source, index, scan_number_end(source, index + 1) - index),
                  make_span(index, line, column, scan_number_end(source, index + 1) - index)))),
            choose(char_at(source, index) == "\"",
              tokenize_from(
                source,
                scan_string_end(source, index + 1) + 1,
                line,
                column + scan_string_end(source, index + 1) - index + 1,
                sequence_append(output,
                  make_token(
                    "STRING",
                    slice_text(source, index + 1, scan_string_end(source, index + 1) - index - 1),
                    make_span(index, line, column, scan_string_end(source, index + 1) - index + 1)))),
              tokenize_from(
                source,
                index + 1,
                line,
                column + 1,
                sequence_append(output,
                  make_token("SYMBOL", char_at(source, index), make_span(index, line, column, 1)))))))))

  reckon literal_kind(item : Token) -> Text =
    choose(token_kind(item) == "NUMBER", "Number",
      choose(token_kind(item) == "STRING", "Text", "Truth"))

  reckon module_name(tokens : Sequence) -> Text =
    choose(
      semantic_assert(
        token_text(expect_token(sequence_get(tokens, 0), "IDENT", "module")) == "module",
        "RCL_MODULE_HEADER_REQUIRED",
        "module",
        token_span(sequence_get(tokens, 0))),
      token_text(expect_token(sequence_get(tokens, 1), "IDENT", "")),
      "")

  reckon collect_imports(tokens : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(token_text(sequence_get(tokens, index)) == "import",
      collect_imports(
        tokens,
        index + 2,
        sequence_append(output, token_text(expect_token(sequence_get(tokens, index + 1), "IDENT", "")))),
      output)

  reckon after_imports(tokens : Sequence, index : Number) -> Number =
    choose(token_text(sequence_get(tokens, index)) == "import",
      after_imports(tokens, index + 2),
      index)

  reckon after_requires(tokens : Sequence, index : Number) -> Number =
    choose(token_text(sequence_get(tokens, index)) == "require",
      after_requires(tokens, index + 7),
      index)

  reckon literal_span(tokens : Sequence, index : Number) -> Span =
    make_span(
      span_offset(token_span(expect_token(sequence_get(tokens, index), "IDENT", "facet"))),
      span_line(token_span(expect_token(sequence_get(tokens, index), "IDENT", "facet"))),
      span_column(token_span(expect_token(sequence_get(tokens, index), "IDENT", "facet"))),
      span_offset(token_span(sequence_get(tokens, index + 7)))
        + span_length(token_span(sequence_get(tokens, index + 7)))
        - span_offset(token_span(sequence_get(tokens, index))))

  reckon parse_facet(tokens : Sequence, index : Number) -> AstNode =
    facet_ast(
      token_text(expect_token(sequence_get(tokens, index + 1), "IDENT", ""))
        + token_text(expect_token(sequence_get(tokens, index + 2), "SYMBOL", "."))
        + token_text(expect_token(sequence_get(tokens, index + 3), "IDENT", "")),
      token_text(expect_token(sequence_get(tokens, index + 5), "IDENT", "")),
      literal_kind(expect_token(sequence_get(tokens, index + 7), token_kind(sequence_get(tokens, index + 7)), "")),
      token_text(expect_token(sequence_get(tokens, index + 7), token_kind(sequence_get(tokens, index + 7)), "")),
      literal_span(tokens, index))

  reckon parse_facets(tokens : Sequence, index : Number, nodes : Sequence) -> ParseState =
    choose(token_kind(sequence_get(tokens, index)) == "EOF",
      make_parse_state(index, nodes),
      parse_facets(tokens, index + 8, sequence_append(nodes, parse_facet(tokens, index))))

  reckon find_text(items : Sequence, index : Number, text_value : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(items, index) == text_value,
        index,
        find_text(items, index + 1, text_value)))

  reckon find_symbol(symbols : Sequence, index : Number, path : Text) -> Number =
    choose(index >= length(symbols), -1,
      choose(symbol_path(sequence_get(symbols, index)) == path,
        index,
        find_symbol(symbols, index + 1, path)))

  reckon qualified(module : Text, path : Text) -> Text = module + "::" + path

  reckon unique_module_symbol(module : Text, symbols : Sequence, node : AstNode) -> Truth =
    semantic_assert(
      find_symbol(symbols, 0, qualified(module, ast_path(node))) < 0,
      "RCL_SEMANTIC_DUPLICATE",
      qualified(module, ast_path(node)),
      ast_span(node))

  reckon resolve_module_symbol(module : Text, node : AstNode, slot : Number, symbols : Sequence) -> Symbol =
    choose(unique_module_symbol(module, symbols, node),
      make_symbol(qualified(module, ast_path(node)), ast_value_type(node), slot, ast_span(node)),
      make_symbol(qualified(module, ast_path(node)), ast_value_type(node), slot, ast_span(node)))

  reckon resolve_module_symbols(module : Text, nodes : Sequence, index : Number, base_slot : Number, symbols : Sequence) -> Sequence =
    choose(index >= length(nodes), symbols,
      resolve_module_symbols(
        module,
        nodes,
        index + 1,
        base_slot,
        sequence_append(symbols, resolve_module_symbol(module, sequence_get(nodes, index), base_slot + index, symbols))))

  reckon append_all(source : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(source), output,
      append_all(source, index + 1, sequence_append(output, sequence_get(source, index))))

  reckon validate_imports(imports : Sequence, index : Number, modules : Sequence, owner_span : Span) -> Truth =
    choose(index >= length(imports), true,
      choose(
        semantic_assert(
          find_text(modules, 0, sequence_get(imports, index)) >= 0,
          "RCL_MODULE_MISSING",
          sequence_get(imports, index),
          owner_span),
        validate_imports(imports, index + 1, modules, owner_span),
        false))

  reckon validate_requirements(tokens : Sequence, index : Number, imports : Sequence, symbols : Sequence) -> Truth =
    choose(token_text(sequence_get(tokens, index)) != "require", true,
      choose(
        semantic_assert(
          find_text(imports, 0, token_text(expect_token(sequence_get(tokens, index + 1), "IDENT", ""))) >= 0,
          "RCL_MODULE_NOT_IMPORTED",
          token_text(sequence_get(tokens, index + 1)),
          token_span(sequence_get(tokens, index))),
        choose(
          semantic_assert(
            find_symbol(
              symbols,
              0,
              qualified(
                token_text(sequence_get(tokens, index + 1)),
                token_text(expect_token(sequence_get(tokens, index + 2), "IDENT", ""))
                  + token_text(expect_token(sequence_get(tokens, index + 3), "SYMBOL", "."))
                  + token_text(expect_token(sequence_get(tokens, index + 4), "IDENT", "")))) >= 0,
            "RCL_MODULE_SYMBOL_MISSING",
            token_text(sequence_get(tokens, index + 1)) + "::" + token_text(sequence_get(tokens, index + 2)) + "." + token_text(sequence_get(tokens, index + 4)),
            token_span(sequence_get(tokens, index))),
          choose(
            semantic_assert(
              symbol_type(sequence_get(
                symbols,
                find_symbol(
                  symbols,
                  0,
                  qualified(
                    token_text(sequence_get(tokens, index + 1)),
                    token_text(sequence_get(tokens, index + 2)) + "." + token_text(sequence_get(tokens, index + 4))))))
                == token_text(expect_token(sequence_get(tokens, index + 6), "IDENT", "")),
              "RCL_MODULE_TYPE_MISMATCH",
              token_text(sequence_get(tokens, index + 1)) + "::" + token_text(sequence_get(tokens, index + 2)) + "." + token_text(sequence_get(tokens, index + 4)),
              token_span(sequence_get(tokens, index))),
            validate_requirements(tokens, index + 7, imports, symbols),
            false),
          false),
        false))

  reckon type_valid(node : AstNode) -> Truth =
    semantic_assert(
      ast_value_type(node) == ast_literal_kind(node),
      "RCL_SEMANTIC_TYPE_MISMATCH",
      ast_path(node) + ":" + ast_value_type(node) + "<-" + ast_literal_kind(node),
      ast_span(node))

  reckon semantic_module_facet(module : Text, node : AstNode, symbols : Sequence) -> SemanticNode =
    choose(type_valid(node),
      make_semantic_facet(
        qualified(module, ast_path(node)),
        ast_value_type(node),
        ast_literal_kind(node),
        ast_literal_text(node),
        symbol_slot(sequence_get(symbols, find_symbol(symbols, 0, qualified(module, ast_path(node))))),
        ast_span(node)),
      make_semantic_facet(qualified(module, ast_path(node)), ast_value_type(node), ast_literal_kind(node), ast_literal_text(node), 0, ast_span(node)))

  reckon analyze_module(module : Text, nodes : Sequence, symbols : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(nodes), output,
      analyze_module(
        module,
        nodes,
        symbols,
        index + 1,
        sequence_append(output, semantic_module_facet(module, sequence_get(nodes, index), symbols))))

  reckon lower_store(node : SemanticNode) -> IrNode =
    make_ir_store(
      "STORE_FACET",
      semantic_path(node),
      semantic_type(node),
      semantic_literal_kind(node),
      semantic_literal_text(node),
      semantic_slot(node),
      semantic_span(node))

  reckon lower_ir(nodes : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(nodes), output,
      lower_ir(nodes, index + 1, sequence_append(output, lower_store(sequence_get(nodes, index)))))


  reckon find_number(items : Sequence, index : Number, value : Number) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(items, index) == value,
        index,
        find_number(items, index + 1, value)))

  reckon append_unique_text(items : Sequence, value : Text) -> Sequence =
    choose(find_text(items, 0, value) >= 0, items, sequence_append(items, value))

  reckon append_unique_number(items : Sequence, value : Number) -> Sequence =
    choose(find_number(items, 0, value) >= 0, items, sequence_append(items, value))

  reckon collect_rbc_strings(nodes : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(nodes), output,
      choose(ir_literal_kind(sequence_get(nodes, index)) == "Text",
        collect_rbc_strings(
          nodes,
          index + 1,
          append_unique_text(
            append_unique_text(output, ir_literal_text(sequence_get(nodes, index))),
            ir_path(sequence_get(nodes, index)))),
        collect_rbc_strings(
          nodes,
          index + 1,
          append_unique_text(output, ir_path(sequence_get(nodes, index))))))

  reckon collect_rbc_numbers(nodes : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(nodes), output,
      choose(ir_literal_kind(sequence_get(nodes, index)) == "Number",
        collect_rbc_numbers(nodes, index + 1, append_unique_number(output, number_from_text(ir_literal_text(sequence_get(nodes, index))))),
        collect_rbc_numbers(nodes, index + 1, output)))

  reckon encode_string_record(value : Text) -> Sequence =
    sequence_concat(bytes_u32le(length(utf8_bytes(value))), utf8_bytes(value))

  reckon encode_string_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_string_pool(items, index + 1, sequence_concat(output, encode_string_record(sequence_get(items, index)))))

  reckon encode_number_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_number_pool(items, index + 1, sequence_concat(output, bytes_f64le(sequence_get(items, index)))))

  reckon encode_instruction(op : Number, a : Number, b : Number, c : Number) -> Sequence =
    sequence_concat(
      bytes_u8(op),
      sequence_concat(
        bytes_u8(0),
        sequence_concat(
          bytes_u16le(0),
          sequence_concat(
            bytes_i32le(a),
            sequence_concat(bytes_i32le(b), bytes_i32le(c))))))

  reckon push_opcode(node : IrNode) -> Number =
    choose(ir_literal_kind(node) == "Number", 1,
      choose(ir_literal_kind(node) == "Truth", 2, 3))

  reckon push_operand(node : IrNode, strings : Sequence, numbers : Sequence) -> Number =
    choose(ir_literal_kind(node) == "Number",
      find_number(numbers, 0, number_from_text(ir_literal_text(node))),
      choose(ir_literal_kind(node) == "Truth",
        choose(ir_literal_text(node) == "true", 1, 0),
        find_text(strings, 0, ir_literal_text(node))))

  reckon encode_ir_instructions(nodes : Sequence, index : Number, strings : Sequence, numbers : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(nodes),
      sequence_concat(output, encode_instruction(31, 0, 0, 0)),
      encode_ir_instructions(
        nodes,
        index + 1,
        strings,
        numbers,
        sequence_concat(
          output,
          sequence_concat(
            encode_instruction(
              push_opcode(sequence_get(nodes, index)),
              push_operand(sequence_get(nodes, index), strings, numbers),
              0,
              0),
            encode_instruction(5, find_text(strings, 0, ir_path(sequence_get(nodes, index))), 0, 0)))))

  reckon encode_rbc_header(program_index : Number, root_index : Number, string_count : Number, number_count : Number, instruction_count : Number) -> Sequence =
    sequence_concat(
      utf8_bytes("RCLB"),
      sequence_concat(
        bytes_u16le(1),
        sequence_concat(
          bytes_u16le(1),
          sequence_concat(
            bytes_u32le(3),
            sequence_concat(
              bytes_u32le(program_index),
              sequence_concat(
                bytes_u32le(root_index),
                sequence_concat(
                  bytes_u32le(string_count),
                  sequence_concat(
                    bytes_u32le(number_count),
                    sequence_concat(bytes_u32le(instruction_count), bytes_u32le(0))))))))))

  reckon encode_rbc(program : Text, root : Text, nodes : Sequence) -> Sequence =
    sequence_concat(
      encode_rbc_header(
        find_text(collect_rbc_strings(nodes, 0, append_unique_text(append_unique_text(empty_sequence(), program), root)), 0, program),
        find_text(collect_rbc_strings(nodes, 0, append_unique_text(append_unique_text(empty_sequence(), program), root)), 0, root),
        length(collect_rbc_strings(nodes, 0, append_unique_text(append_unique_text(empty_sequence(), program), root))),
        length(collect_rbc_numbers(nodes, 0, empty_sequence())),
        length(nodes) * 2 + 1),
      sequence_concat(
        encode_string_pool(
          collect_rbc_strings(nodes, 0, append_unique_text(append_unique_text(empty_sequence(), program), root)),
          0,
          empty_sequence()),
        sequence_concat(
          encode_number_pool(collect_rbc_numbers(nodes, 0, empty_sequence()), 0, empty_sequence()),
          encode_ir_instructions(
            nodes,
            0,
            collect_rbc_strings(nodes, 0, append_unique_text(append_unique_text(empty_sequence(), program), root)),
            collect_rbc_numbers(nodes, 0, empty_sequence()),
            empty_sequence()))))

  facet compiler.core_tokens : Sequence = tokenize_from(source.core, 0, 1, 1, empty_sequence())
  facet compiler.app_tokens : Sequence = tokenize_from(source.app, 0, 1, 1, empty_sequence())
  facet compiler.core_module : Text = module_name(compiler.core_tokens)
  facet compiler.app_module : Text = module_name(compiler.app_tokens)
  facet compiler.modules : Sequence = sequence_append(sequence_append(empty_sequence(), compiler.core_module), compiler.app_module)
  facet compiler.core_imports : Sequence = collect_imports(compiler.core_tokens, 2, empty_sequence())
  facet compiler.app_imports : Sequence = collect_imports(compiler.app_tokens, 2, empty_sequence())
  facet compiler.core_start : Number = after_requires(compiler.core_tokens, after_imports(compiler.core_tokens, 2))
  facet compiler.app_start : Number = after_requires(compiler.app_tokens, after_imports(compiler.app_tokens, 2))
  facet compiler.core_parse : ParseState = parse_facets(compiler.core_tokens, compiler.core_start, empty_sequence())
  facet compiler.app_parse : ParseState = parse_facets(compiler.app_tokens, compiler.app_start, empty_sequence())
  facet compiler.core_ast : Sequence = parse_nodes(compiler.core_parse)
  facet compiler.app_ast : Sequence = parse_nodes(compiler.app_parse)
  facet compiler.core_symbols : Sequence = resolve_module_symbols(compiler.core_module, compiler.core_ast, 0, 0, empty_sequence())
  facet compiler.app_symbols : Sequence = resolve_module_symbols(compiler.app_module, compiler.app_ast, 0, length(compiler.core_symbols), empty_sequence())
  facet compiler.symbols : Sequence = append_all(compiler.app_symbols, 0, compiler.core_symbols)
  facet compiler.core_imports_valid : Truth = validate_imports(compiler.core_imports, 0, compiler.modules, token_span(sequence_get(compiler.core_tokens, 0)))
  facet compiler.app_imports_valid : Truth = validate_imports(compiler.app_imports, 0, compiler.modules, token_span(sequence_get(compiler.app_tokens, 0)))
  facet compiler.app_requirements_valid : Truth = validate_requirements(compiler.app_tokens, after_imports(compiler.app_tokens, 2), compiler.app_imports, compiler.symbols)
  facet compiler.core_semantic : Sequence = analyze_module(compiler.core_module, compiler.core_ast, compiler.symbols, 0, empty_sequence())
  facet compiler.app_semantic : Sequence = analyze_module(compiler.app_module, compiler.app_ast, compiler.symbols, 0, empty_sequence())
  facet compiler.semantic : Sequence = append_all(compiler.app_semantic, 0, compiler.core_semantic)
  facet compiler.ir : Sequence = lower_ir(compiler.semantic, 0, empty_sequence())
  facet compiler.rbc_strings : Sequence = collect_rbc_strings(compiler.ir, 0, append_unique_text(append_unique_text(empty_sequence(), source.program), source.root))
  facet compiler.rbc_numbers : Sequence = collect_rbc_numbers(compiler.ir, 0, empty_sequence())
  facet compiler.rbc_bytes : Sequence = encode_rbc(source.program, source.root, compiler.ir)
  facet compiler.rbc_size : Number = length(compiler.rbc_bytes)

  facet stage2.symbol_count : Number = length(compiler.symbols)
  facet stage2.semantic_count : Number = length(compiler.semantic)
  facet stage2.ir_count : Number = length(compiler.ir)
  facet stage2.string_count : Number = length(compiler.rbc_strings)
  facet stage2.number_count : Number = length(compiler.rbc_numbers)
  facet stage2.instruction_count : Number = length(compiler.ir) * 2 + 1
  facet stage2.rbc_magic_0 : Number = sequence_get(compiler.rbc_bytes, 0)
  facet stage2.rbc_magic_1 : Number = sequence_get(compiler.rbc_bytes, 1)
  facet stage2.rbc_magic_2 : Number = sequence_get(compiler.rbc_bytes, 2)
  facet stage2.rbc_magic_3 : Number = sequence_get(compiler.rbc_bytes, 3)
  facet stage2.first_ir_path : Text = ir_path(sequence_get(compiler.ir, 0))
  facet stage2.second_ir_path : Text = ir_path(sequence_get(compiler.ir, 1))
  facet stage2.third_ir_path : Text = ir_path(sequence_get(compiler.ir, 2))

  subject selfhost_agent {
    warrant selfhost.write on selfhost
    warrant stage2.audit on stage2
    warrant compiler.audit on compiler
    warrant gate.audit on gate
  }

  emergence verify_stage2_semantic_bytecode_subset {
    cause selfhost_agent
    when gate.rcl_owned_semantic_subset == true and gate.rcl_owned_ir_subset == true and gate.rcl_owned_rbc_encoder_subset == true
    needs selfhost.write on selfhost

    alter selfhost.stage_status <- "RCL_OWNED_SEMANTIC_BYTECODE_SUBSET_VERIFIED"

    preserve compiler.core_imports_valid == true
      and compiler.app_imports_valid == true
      and compiler.app_requirements_valid == true
      and stage2.symbol_count == 3
      and stage2.semantic_count == 3
      and stage2.ir_count == 3
      and stage2.string_count == 6
      and stage2.number_count == 1
      and stage2.instruction_count == 7
      and compiler.rbc_size == 294
      and stage2.rbc_magic_0 == 82
      and stage2.rbc_magic_1 == 67
      and stage2.rbc_magic_2 == 76
      and stage2.rbc_magic_3 == 66
      and stage2.first_ir_path == "core::world.value"
      and stage2.second_ir_path == "core::world.name"
      and stage2.third_ir_path == "app::app.ready"
      and gate.full_self_hosting == false
      and gate.js_runtime_still_required == true

    witness "rcl:selfhost-stage2-rcl-owned-semantic-ir-bytecode-subset"
  }

  foresee verify_stage2_semantic_bytecode_subset
  realize verify_stage2_semantic_bytecode_subset
}
