  reckon instruction_a_at(index : Number, strings : Sequence, numbers : Sequence) -> Number =
    choose(index == 0, 1,
      choose(index == 1, string_index(strings, facet_path_of(compiler.ready_facet)),
        choose(index == 2, number_index(numbers, number_from_text(expr_text_of(facet_expr_of(compiler.score_facet)))),
          choose(index == 3, string_index(strings, facet_path_of(compiler.score_facet)),
            choose(index == 4, number_index(numbers, number_from_text(expr_text_of(facet_expr_of(compiler.level_facet)))),
              choose(index == 5, string_index(strings, facet_path_of(compiler.level_facet)),
                choose(index == 6, string_index(strings, subject_name_of(compiler.subject)),
