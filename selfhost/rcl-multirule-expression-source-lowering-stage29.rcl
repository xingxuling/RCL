          sequence_append(empty_sequence(), number_from_text(expr_text_of(facet_expr_of(compiler.score_facet)))),
          number_from_text(expr_text_of(facet_expr_of(compiler.level_facet)))),
        number_from_text(rule_alter_right_of(compiler.rule_one))),
      number_from_text(rule_preserve_right_of(compiler.rule_one)))

  reckon string_index(strings : Sequence, value : Text) -> Number =
    find_text(strings, 0, value)

  reckon number_index(numbers : Sequence, value : Number) -> Number =
    choose(sequence_get(numbers, 0) == value, 0,
      choose(sequence_get(numbers, 1) == value, 1,
        choose(sequence_get(numbers, 2) == value, 2,
          choose(sequence_get(numbers, 3) == value, 3, -1))))

  reckon instruction_group_at(index : Number) -> Number =
    choose(index >= 62, 3,
      choose(index >= 44, 2,
        choose(index >= 26, 1, 0)))

  reckon instruction_local_at(index : Number) -> Number =
    choose(index >= 62, index - 62,
      choose(index >= 44, index - 44,
        choose(index >= 26, index - 26, index - 8)))

  reckon instruction_uses_rule_two(index : Number) -> Truth =
    instruction_group_at(index) >= 2

  reckon instruction_mode_at(index : Number) -> Number =
    choose(instruction_group_at(index) == 1, 1,
      choose(instruction_group_at(index) == 3, 1, 0))

  reckon instruction_jump_target_at(index : Number) -> Number =
    choose(instruction_group_at(index) == 0, 26,
      choose(instruction_group_at(index) == 1, 44,
        choose(instruction_group_at(index) == 2, 62, 80)))

  reckon instruction_when_left_at(index : Number) -> Text =
