  reckon instruction_b_at(index : Number, strings : Sequence) -> Number =
    choose(index == 6, string_index(strings, subject_capability_one_of(compiler.subject)),
      choose(index == 7, string_index(strings, subject_capability_two_of(compiler.subject)),
        choose(index == 80, 0,
          choose(instruction_local_at(index) == 4, string_index(strings, instruction_rule_name_at(index)),
            choose(instruction_local_at(index) == 5, string_index(strings, instruction_need_capability_at(index)), 0)))))

  reckon instruction_c_at(index : Number, strings : Sequence) -> Number =
    choose(index == 6, string_index(strings, subject_target_one_of(compiler.subject)),
      choose(index == 7, string_index(strings, subject_target_two_of(compiler.subject)),
        choose(index == 80, 0,
          choose(instruction_local_at(index) == 4, string_index(strings, instruction_rule_cause_at(index)),
            choose(instruction_local_at(index) == 5, string_index(strings, instruction_need_target_at(index)), 0)))))

  reckon build_instruction_values(index : Number, strings : Sequence, numbers : Sequence, selector : Number, output : Sequence) -> Sequence =
    choose(index >= 81, output,
      build_instruction_values(
        index + 1,
        strings,
        numbers,
        selector,
        sequence_append(
          output,
          choose(selector == 0, instruction_op_at(index),
            choose(selector == 1, instruction_a_at(index, strings, numbers),
              choose(selector == 2, instruction_b_at(index, strings), instruction_c_at(index, strings)))))))

  reckon encode_string_record(value : Text) -> Sequence =
    sequence_concat(bytes_u32le(length(utf8_bytes(value))), utf8_bytes(value))

  reckon encode_string_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_string_pool(items, index + 1, sequence_concat(output, encode_string_record(sequence_get(items, index)))))

  reckon encode_instruction(op : Number, a : Number, b : Number, c : Number) -> Sequence =
    sequence_concat(
      bytes_u8(op),
      sequence_concat(
        bytes_u8(0),
        sequence_concat(
          bytes_u16le(0),
          sequence_concat(
            bytes_i32le(a),
            sequence_concat(bytes_i32le(b), bytes_i32le(c))))))

  reckon encode_instruction_plan(op_values : Sequence, a_values : Sequence, b_values : Sequence, c_values : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(op_values), output,
      encode_instruction_plan(
        op_values,
        a_values,
        b_values,
        c_values,
        index + 1,
        sequence_concat(
          output,
          encode_instruction(
            sequence_get(op_values, index),
            sequence_get(a_values, index),
            sequence_get(b_values, index),
            sequence_get(c_values, index)))))

  reckon encode_number_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_number_pool(items, index + 1, sequence_concat(output, bytes_f64le(sequence_get(items, index)))))

  reckon encode_rbc_header(program_index : Number, root_index : Number, string_count : Number, number_count : Number, instruction_count : Number) -> Sequence =
    sequence_concat(
      utf8_bytes("RCLB"),
      sequence_concat(
        bytes_u16le(1),
        sequence_concat(
          bytes_u16le(1),
          sequence_concat(
            bytes_u32le(0),
            sequence_concat(
              bytes_u32le(program_index),
              sequence_concat(
                bytes_u32le(root_index),
                sequence_concat(
                  bytes_u32le(string_count),
                  sequence_concat(
                    bytes_u32le(number_count),
                    sequence_concat(bytes_u32le(instruction_count), bytes_u32le(0))))))))))

  reckon encode_target_rbc(strings : Sequence, numbers : Sequence, ops : Sequence, a_values : Sequence, b_values : Sequence, c_values : Sequence) -> Sequence =
    sequence_concat(
      encode_rbc_header(0, 1, length(strings), length(numbers), length(ops)),
      sequence_concat(
        encode_string_pool(strings, 0, empty_sequence()),
        sequence_concat(
          encode_number_pool(numbers, 0, empty_sequence()),
          encode_instruction_plan(ops, a_values, b_values, c_values, 0, empty_sequence()))))

  facet parser.tokens : Sequence = tokenize_from(source.full, 0, 1, 1, empty_sequence())
  facet parser.token_count : Number = length(parser.tokens)
  facet parser.first_token : Text = token_text(sequence_get(parser.tokens, 0))
  facet parser.program_token : Text = token_text(sequence_get(parser.tokens, 1))
  facet parser.body_open : Text = token_text(sequence_get(parser.tokens, 2))
  facet parser.subject_start : Number = find_token_text(parser.tokens, 3, "subject")
  facet parser.emergence_one_start : Number = find_token_text(parser.tokens, 3, "emergence")
  facet parser.emergence_two_start : Number = find_token_text_after(parser.tokens, parser.emergence_one_start, "emergence")
  facet parser.foresee_one_start : Number = find_token_text(parser.tokens, 3, "foresee")
  facet parser.realize_one_start : Number = find_token_text_after(parser.tokens, parser.foresee_one_start, "realize")
  facet parser.foresee_two_start : Number = find_token_text_after(parser.tokens, parser.realize_one_start, "foresee")
  facet parser.realize_two_start : Number = find_token_text_after(parser.tokens, parser.foresee_two_start, "realize")
  facet parser.body_close : Text = token_text(sequence_get(parser.tokens, 129))
  facet parser.eof_kind : Text = token_kind(sequence_get(parser.tokens, 130))

  facet compiler.program : Text = checked_ident(parser.tokens, 1, "")
  facet compiler.ready_facet : Sequence = parse_literal_facet(parser.tokens, 3)
  facet compiler.score_facet : Sequence = parse_literal_facet(parser.tokens, after_literal_facet(parser.tokens, 3))
  facet compiler.level_facet : Sequence = parse_literal_facet(parser.tokens, after_literal_facet(parser.tokens, after_literal_facet(parser.tokens, 3)))
  facet compiler.subject : Sequence = parse_subject(parser.tokens, parser.subject_start)
  facet compiler.rule_one : Sequence = parse_emergence(parser.tokens, parser.emergence_one_start)
  facet compiler.rule_two : Sequence = parse_emergence(parser.tokens, parser.emergence_two_start)
  facet compiler.foresee_rule_one : Text = checked_ident(parser.tokens, parser.foresee_one_start + 1, "")
  facet compiler.realize_rule_one : Text = checked_ident(parser.tokens, parser.realize_one_start + 1, "")
  facet compiler.foresee_rule_two : Text = checked_ident(parser.tokens, parser.foresee_two_start + 1, "")
  facet compiler.realize_rule_two : Text = checked_ident(parser.tokens, parser.realize_two_start + 1, "")
  facet compiler.facet_count : Number = 3
  facet compiler.subject_count : Number = 1
  facet compiler.warrant_count : Number = 2
  facet compiler.emergence_count : Number = 2
  facet compiler.directive_count : Number = 4
  facet compiler.rule_source_lowering_supported : Truth =
    semantic_assert(
      compiler.facet_count == 3
        and compiler.subject_count == 1
        and compiler.warrant_count == 2
        and compiler.emergence_count == 2
        and compiler.directive_count == 4
        and facet_path_of(compiler.ready_facet) == "world.ready"
        and expr_text_of(facet_expr_of(compiler.ready_facet)) == "true"
        and facet_path_of(compiler.score_facet) == "world.score"
        and expr_value_type_of(facet_expr_of(compiler.score_facet)) == "Number"
        and expr_text_of(facet_expr_of(compiler.score_facet)) == "1"
        and facet_path_of(compiler.level_facet) == "world.level"
        and expr_value_type_of(facet_expr_of(compiler.level_facet)) == "Number"
        and expr_text_of(facet_expr_of(compiler.level_facet)) == "0"
        and subject_name_of(compiler.subject) == "founder"
        and subject_capability_one_of(compiler.subject) == "world.publish"
        and subject_target_one_of(compiler.subject) == "world"
        and subject_capability_two_of(compiler.subject) == "world.promote"
        and subject_target_two_of(compiler.subject) == "world"
        and rule_name_of(compiler.rule_one) == "publish"
        and rule_cause_of(compiler.rule_one) == "founder"
        and rule_when_left_of(compiler.rule_one) == "world.score"
        and rule_when_operator_of(compiler.rule_one) == ">="
        and rule_when_right_of(compiler.rule_one) == "1"
        and rule_need_capability_of(compiler.rule_one) == "world.publish"
        and rule_need_target_of(compiler.rule_one) == "world"
        and rule_alter_target_of(compiler.rule_one) == "world.score"
        and rule_alter_left_of(compiler.rule_one) == "world.score"
        and rule_alter_operator_of(compiler.rule_one) == "+"
        and rule_alter_right_of(compiler.rule_one) == "2"
        and rule_preserve_left_of(compiler.rule_one) == "world.score"
        and rule_preserve_operator_of(compiler.rule_one) == ">="
        and rule_preserve_right_of(compiler.rule_one) == "3"
        and rule_witness_of(compiler.rule_one) == "rcl:stage29:score"
        and rule_name_of(compiler.rule_two) == "promote"
        and rule_cause_of(compiler.rule_two) == "founder"
        and rule_when_left_of(compiler.rule_two) == "world.score"
        and rule_when_operator_of(compiler.rule_two) == ">="
        and rule_when_right_of(compiler.rule_two) == "3"
        and rule_need_capability_of(compiler.rule_two) == "world.promote"
        and rule_need_target_of(compiler.rule_two) == "world"
        and rule_alter_target_of(compiler.rule_two) == "world.level"
        and rule_alter_left_of(compiler.rule_two) == "world.level"
        and rule_alter_operator_of(compiler.rule_two) == "+"
        and rule_alter_right_of(compiler.rule_two) == "1"
        and rule_preserve_left_of(compiler.rule_two) == "world.level"
        and rule_preserve_operator_of(compiler.rule_two) == ">="
        and rule_preserve_right_of(compiler.rule_two) == "1"
        and rule_witness_of(compiler.rule_two) == "rcl:stage29:level"
        and compiler.foresee_rule_one == rule_name_of(compiler.rule_one)
        and compiler.realize_rule_one == rule_name_of(compiler.rule_one)
        and compiler.foresee_rule_two == rule_name_of(compiler.rule_two)
        and compiler.realize_rule_two == rule_name_of(compiler.rule_two)
        and source.root == "e4be3c20798ec925987d9aa2bf24e714bc39f82999e280fc206d19fca7fb982c",
      "RCL_STAGE29_MULTIRULE_EXPRESSION_SOURCE_LOWERING_MISMATCH",
      selfhost.stage,
      token_span(sequence_get(parser.tokens, 0)))

  facet target.rbc_strings : Sequence = build_target_strings()
  facet target.rbc_numbers : Sequence = build_target_numbers()
  facet target.rbc_instruction_ops : Sequence = build_instruction_values(0, target.rbc_strings, target.rbc_numbers, 0, empty_sequence())
  facet target.rbc_instruction_a_values : Sequence = build_instruction_values(0, target.rbc_strings, target.rbc_numbers, 1, empty_sequence())
  facet target.rbc_instruction_b_values : Sequence = build_instruction_values(0, target.rbc_strings, target.rbc_numbers, 2, empty_sequence())
  facet target.rbc_instruction_c_values : Sequence = build_instruction_values(0, target.rbc_strings, target.rbc_numbers, 3, empty_sequence())
  facet target.rbc_bytes : Sequence = encode_target_rbc(target.rbc_strings, target.rbc_numbers, target.rbc_instruction_ops, target.rbc_instruction_a_values, target.rbc_instruction_b_values, target.rbc_instruction_c_values)
  facet target.rbc_size : Number = length(target.rbc_bytes)
  facet target.bytecode_magic_0 : Number = sequence_get(target.rbc_bytes, 0)
  facet target.bytecode_magic_1 : Number = sequence_get(target.rbc_bytes, 1)
  facet target.bytecode_magic_2 : Number = sequence_get(target.rbc_bytes, 2)
  facet target.bytecode_magic_3 : Number = sequence_get(target.rbc_bytes, 3)

  subject selfhost_agent {
    warrant selfhost.write on selfhost
    warrant parser.audit on parser
    warrant compiler.audit on compiler
    warrant target.audit on target
    warrant gate.audit on gate
  }

  emergence verify_stage29_multirule_expression_source_lowering_subset {
    cause selfhost_agent
    when gate.rcl_owned_multirule_expression_source_lowering_subset == true
    needs selfhost.write on selfhost

    alter selfhost.stage_status <- "RCL_OWNED_MULTIRULE_EXPRESSION_SOURCE_LOWERING_SUBSET_VERIFIED"

    preserve parser.token_count == 131
      and parser.first_token == "reality"
      and parser.program_token == compiler.program
      and parser.body_open == char_at("{}", 0)
      and parser.subject_start == 27
      and parser.emergence_one_start == 43
      and parser.emergence_two_start == 82
      and parser.foresee_one_start == 121
      and parser.realize_one_start == 123
      and parser.foresee_two_start == 125
      and parser.realize_two_start == 127
      and parser.body_close == char_at("{}", 1)
      and parser.eof_kind == "EOF"
      and compiler.rule_source_lowering_supported == true
      and target.rbc_size == 1645
      and length(target.rbc_strings) == 13
      and length(target.rbc_numbers) == 4
      and length(target.rbc_instruction_ops) == 81
      and sequence_get(target.rbc_strings, 0) == compiler.program
      and sequence_get(target.rbc_strings, 1) == source.root
      and sequence_get(target.rbc_strings, 2) == "world.ready"
      and sequence_get(target.rbc_strings, 3) == "world.score"
      and sequence_get(target.rbc_strings, 4) == "world.level"
      and sequence_get(target.rbc_strings, 5) == "founder"
      and sequence_get(target.rbc_strings, 6) == "world.publish"
      and sequence_get(target.rbc_strings, 7) == "world"
      and sequence_get(target.rbc_strings, 8) == "world.promote"
      and sequence_get(target.rbc_strings, 9) == "publish"
      and sequence_get(target.rbc_strings, 10) == "rcl:stage29:score"
      and sequence_get(target.rbc_strings, 11) == "promote"
      and sequence_get(target.rbc_strings, 12) == "rcl:stage29:level"
      and sequence_get(target.rbc_numbers, 0) == 1
      and sequence_get(target.rbc_numbers, 1) == 0
      and sequence_get(target.rbc_numbers, 2) == 2
      and sequence_get(target.rbc_numbers, 3) == 3
      and sequence_get(target.rbc_instruction_ops, 2) == 1
      and sequence_get(target.rbc_instruction_ops, 4) == 1
      and sequence_get(target.rbc_instruction_ops, 6) == 22
      and sequence_get(target.rbc_instruction_ops, 7) == 22
      and sequence_get(target.rbc_instruction_ops, 10) == 15
      and sequence_get(target.rbc_instruction_ops, 11) == 21
      and sequence_get(target.rbc_instruction_ops, 16) == 6
      and sequence_get(target.rbc_instruction_ops, 21) == 15
      and sequence_get(target.rbc_instruction_ops, 29) == 21
      and sequence_get(target.rbc_instruction_ops, 34) == 6
      and sequence_get(target.rbc_instruction_ops, 39) == 15
      and sequence_get(target.rbc_instruction_ops, 47) == 21
      and sequence_get(target.rbc_instruction_ops, 52) == 6
      and sequence_get(target.rbc_instruction_ops, 57) == 15
      and sequence_get(target.rbc_instruction_ops, 65) == 21
      and sequence_get(target.rbc_instruction_ops, 70) == 6
      and sequence_get(target.rbc_instruction_ops, 75) == 15
      and sequence_get(target.rbc_instruction_ops, 80) == 31
      and sequence_get(target.rbc_instruction_a_values, 11) == 26
      and sequence_get(target.rbc_instruction_a_values, 29) == 44
      and sequence_get(target.rbc_instruction_a_values, 47) == 62
      and sequence_get(target.rbc_instruction_a_values, 65) == 80
      and sequence_get(target.rbc_instruction_a_values, 12) == 0
      and sequence_get(target.rbc_instruction_a_values, 30) == 1
      and sequence_get(target.rbc_instruction_a_values, 48) == 0
      and sequence_get(target.rbc_instruction_a_values, 66) == 1
      and sequence_get(target.rbc_instruction_a_values, 24) == 10
      and sequence_get(target.rbc_instruction_a_values, 42) == 10
      and sequence_get(target.rbc_instruction_a_values, 60) == 12
      and sequence_get(target.rbc_instruction_a_values, 78) == 12
      and target.bytecode_magic_0 == 82
      and target.bytecode_magic_1 == 67
      and target.bytecode_magic_2 == 76
      and target.bytecode_magic_3 == 66
      and gate.full_self_hosting == false
      and gate.rcl_owned_rule_expression_source_lowering_subset == true
      and gate.rcl_owned_multirule_expression_source_lowering_subset == true
      and gate.rcl_owned_parser_complete == false
      and gate.rcl_owned_expression_ast_complete == false
      and gate.rcl_owned_rule_bytecode_lowering_complete == false
      and gate.rcl_compiler_self_emits_without_stage0 == false
      and gate.rcl_owned_runtime_complete == false
      and gate.native_vm_host_still_required == true

    witness "rcl:selfhost-stage29-multirule-expression-source-lowering-subset"
  }

  foresee verify_stage29_multirule_expression_source_lowering_subset
  realize verify_stage29_multirule_expression_source_lowering_subset
}
