  reckon session_directives(rules : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(rules), output,
      session_directives(rules, index + 1,
        sequence_append(sequence_append(output, make_directive("Realize", rule_name(sequence_get(rules, index)))), make_directive("Foresee", rule_name(sequence_get(rules, index))))))

  reckon session_pool_program(program : Sequence) -> Sequence =
    make_program(program_name(program), program_facets(program), program_reckons(program), program_subjects(program), program_warrants(program), program_rules(program),
      session_directives(program_rules(program), 0, empty_sequence()), program_extras(program))

  reckon session_input_type(value_type : Text) -> Number =
    choose(value_type == "Number", 1, choose(value_type == "Truth", 2, 3))

  reckon session_input_count(items : Sequence, index : Number, count : Number) -> Number =
    choose(index >= length(items), count,
      session_input_count(items, index + 1, count + choose(facet_input(sequence_get(items, index)), 1, 0)))

  reckon session_entry_count(items : Sequence, index : Number, program : Sequence, count : Number) -> Number =
    choose(index >= length(items), count,
      session_entry_count(items, index + 1, program, count + 2 + dynamic_warrant_count(program_warrants(program), 0, 1)
        + rule_instruction_count(find_rule(program_rules(program), 0, directive_name(sequence_get(items, index))))))

  reckon session_main_count(program : Sequence) -> Number =
    facet_instruction_count(program_facets(program), 0, 0) + session_input_count(program_facets(program), 0, 0) + 1
      + session_entry_count(session_directives(program_rules(program), 0, empty_sequence()), 0, program, 0)

  reckon emit_session_facet(node : Sequence, program : Sequence, strings : Sequence, numbers : Sequence, start : Number) -> Sequence =
    append_all(choose(facet_input(node), one_instruction(46, find_text(strings, 0, facet_path(node)), session_input_type(facet_type(node)), 0), empty_sequence()),
      append_all(one_instruction(5, find_text(strings, 0, facet_path(node)), 0, 0),
        emit_expression(facet_expression(node), empty_sequence(), program_reckons(program), strings, numbers, session_main_count(program), start)))

  reckon emit_session_facets(items : Sequence, index : Number, program : Sequence, strings : Sequence, numbers : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_session_facets(items, index + 1, program, strings, numbers,
        append_all(emit_session_facet(sequence_get(items, index), program, strings, numbers, length(output)), output)))

  reckon emit_session_entry(node : Sequence, program : Sequence, strings : Sequence, numbers : Sequence, start : Number) -> Sequence =
    append_all(one_instruction(31, 0, 0, 0),
      append_all(emit_rule_invocation(find_rule(program_rules(program), 0, directive_name(node)), choose(directive_kind(node) == "Realize", 1, 0),
          program_reckons(program), strings, numbers, session_main_count(program), start + 1 + dynamic_warrant_count(program_warrants(program), 0, 1)),
        append_all(emit_warrant_refresh(program_warrants(program), program_reckons(program), strings, numbers, session_main_count(program), start + 1),
          one_instruction(45, find_text(strings, 0, directive_name(node)), choose(directive_kind(node) == "Realize", 1, 0), 0))))

  reckon emit_session_entries(items : Sequence, index : Number, program : Sequence, strings : Sequence, numbers : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_session_entries(items, index + 1, program, strings, numbers,
        append_all(emit_session_entry(sequence_get(items, index), program, strings, numbers, length(output)), output)))

  reckon build_session_instructions(program : Sequence, strings : Sequence, numbers : Sequence) -> Sequence =
    append_all(emit_reckons(program_reckons(program), 0, program_reckons(program), strings, numbers, session_main_count(program), session_main_count(program), empty_sequence()),
      emit_session_entries(session_directives(program_rules(program), 0, empty_sequence()), 0, program, strings, numbers,
        append_all(one_instruction(31, 0, 0, 0), emit_session_facets(program_facets(program), 0, program, strings, numbers, empty_sequence()))))

  reckon validate_session_facets(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(semantic_check_at((facet_type(sequence_get(items, index)) == "Number" or facet_type(sequence_get(items, index)) == "Truth" or facet_type(sequence_get(items, index)) == "Text"
          or (facet_type(sequence_get(items, index)) == "Sequence" and not facet_input(sequence_get(items, index)))),
          "RCL_SESSION_FACET_TYPE_UNSUPPORTED", facet_path(sequence_get(items, index)),
          make_span(0, facet_line(sequence_get(items, index)), facet_column(sequence_get(items, index)), 0)), validate_session_facets(items, index + 1), false))

  reckon validate_session_rule_effects(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(semantic_check(length(rule_calls(sequence_get(items, index))) == 0, "RCL_SESSION_EXTERNAL_EFFECT_UNSUPPORTED", rule_name(sequence_get(items, index))),
        validate_session_rule_effects(items, index + 1), false))

  reckon session_expression_list_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(session_expression_pure(sequence_get(items, index)), session_expression_list_pure(items, index + 1), false))

  reckon session_expression_pure(node : Sequence) -> Truth =
    choose(length(node) == 0, true,
      choose(expr_kind(node) == "CallExpr",
        choose(semantic_check_at(expr_text(node) != "provider_call", "RCL_SESSION_EXTERNAL_EFFECT_UNSUPPORTED", expr_text(node), expr_span(node)),
          choose(semantic_check_at(expr_text(node) != "typed_ref" and expr_text(node) != "typed_deref" and expr_text(node) != "typed_ref_id",
              "RCL_SESSION_REF_OPERATION_UNSUPPORTED", expr_text(node), expr_span(node)),
            session_expression_list_pure(expr_args(node), 0), false), false),
        choose(expr_kind(node) == "UnaryExpr", session_expression_pure(expr_left(node)),
          choose(expr_kind(node) == "BinaryExpr",
            choose(session_expression_pure(expr_left(node)), session_expression_pure(expr_right(node)), false), true))))

  reckon session_facet_expressions_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(session_expression_pure(facet_expression(sequence_get(items, index))), session_facet_expressions_pure(items, index + 1), false))

  reckon session_reckon_expressions_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(session_expression_pure(reckon_expression(sequence_get(items, index))), session_reckon_expressions_pure(items, index + 1), false))

  reckon session_warrant_expressions_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(choose(warrant_conditional(sequence_get(items, index)), session_expression_pure(warrant_condition(sequence_get(items, index))), true),
        session_warrant_expressions_pure(items, index + 1), false))

  reckon session_alter_expressions_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(session_expression_pure(alter_expression(sequence_get(items, index))), session_alter_expressions_pure(items, index + 1), false))

  reckon session_rule_expressions_pure(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), true,
      choose(session_expression_pure(rule_when(sequence_get(items, index))),
        choose(session_alter_expressions_pure(rule_alters(sequence_get(items, index)), 0),
          choose(session_expression_list_pure(rule_preserves(sequence_get(items, index)), 0),
            session_rule_expressions_pure(items, index + 1), false), false), false))

  reckon session_program_expressions_pure(program : Sequence) -> Truth =
    choose(session_facet_expressions_pure(program_facets(program), 0),
      choose(session_reckon_expressions_pure(program_reckons(program), 0),
        choose(session_warrant_expressions_pure(program_warrants(program), 0),
          session_rule_expressions_pure(program_rules(program), 0), false), false), false)

  reckon validated_session_program(program : Sequence) -> Sequence =
    choose(validate_session_rule_effects(program_rules(program), 0),
      choose(session_program_expressions_pure(program),
        choose(validate_session_facets(program_facets(program), 0), program, program), program), program)

  reckon encode_session_rbc(program : Sequence, root : Text, strings : Sequence, numbers : Sequence, instructions : Sequence) -> Sequence =
    sequence_concat(encode_header_with_flags(find_text(strings, 0, program_name(program)), find_text(strings, 0, root), length(strings), length(numbers), length(instructions), choose(instructions_require_v13(instructions, 0), 3, choose(instructions_require_v12(instructions, 0), 2, 1)), 4),
      sequence_concat(encode_string_pool(strings, 0, empty_sequence()), sequence_concat(encode_number_pool(numbers, 0, empty_sequence()), encode_instructions(instructions, 0, empty_sequence()))))
