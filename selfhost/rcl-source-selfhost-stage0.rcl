  facet source.runtime_sha : Text = "fff0e84bf95c4afde9d79bf04a35157c24681792533da9e5048a295da902a505"
  facet source.bytecode_sha : Text = "eacf04d52889e23cc08303f39059e5713b24291181b4090c97764cd871e900c2"
  facet source.bootstrap_sha : Text = "b0fa390362597c7fdc90e987f3271bac24ea71327886fe21ea2982a57ef92877"
  facet source.native_vm_sha : Text = "6dda9ed40e04ece24774f25005ac93d8f84b5d91f0e2dedaaf4ed2bebd20b91f"
  facet source.v094_file_emission_sha : Text = "ef5198d23beeb143b18535043f279227cf7ab26fbb66ad8d2b0026d381463fdb"

  facet source.core_module_count : Number = 8
  facet source.bootstrap_stage_count : Number = 9
  facet source.rcl_owned_runtime_count : Number = 0
  facet source.js_reference_runtime_count : Number = 8

  facet selfhost.stage : Text = "stage0_source_truth_model"
  facet selfhost.frontier : Text = "rcl_describes_and_audits_core_before_rewriting_runtime"
  facet selfhost.stage_status : Text = "UNVERIFIED"
  facet selfhost.next_rewrite_target : Text = "lexer_parser_facet_subset"
  facet selfhost.native_boundary : Text = "unchecked"
