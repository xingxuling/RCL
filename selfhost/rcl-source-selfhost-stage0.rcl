  facet module.lexer_status : Text = "JS_REFERENCE"
  facet module.parser_status : Text = "JS_REFERENCE"
  facet module.compiler_status : Text = "JS_REFERENCE"
  facet module.runtime_status : Text = "JS_REFERENCE"
  facet module.bytecode_status : Text = "JS_REFERENCE"
  facet module.bootstrap_status : Text = "RCL_PARTIAL_NATIVE_DEPENDENT"
  facet module.native_vm_status : Text = "WINDOWS_NATIVE_VM_VERIFIED"
  facet module.v094_status : Text = "RCL_MODELED_DETERMINISTIC_SANDBOX"

  facet platform.windows_native_status : Text = "NATIVE_WINDOWS_VERIFIED"
  facet platform.native_posix_artifact : Text = "native/rclvm"
  facet platform.native_windows_artifact : Text = "native/rclvm.exe"
  facet platform.package_status : Text = "WINDOWS_ZIP_HAS_INVALID_COLON_PATHS"

  facet gate.full_self_hosting : Truth = false
  facet gate.rcl_stage0_model_compiles : Truth = true
  facet gate.rcl_stage0_model_runs_on_js_runtime : Truth = true
  facet gate.native_selfhost_runs_on_windows : Truth = false
