  subject selfhost_agent {
    warrant selfhost.write on selfhost
    warrant source.audit on source
    warrant platform.audit on platform
    warrant gate.audit on gate
  }

  emergence establish_stage0_truth_model {
    cause selfhost_agent
    when source.core_module_count == 8
    needs selfhost.write on selfhost

    alter selfhost.stage_status <- "PROXY_VERIFIED"
    alter selfhost.native_boundary <- platform.windows_native_status
    alter selfhost.claim <- "rcl_source_is_modeled_not_rewritten"

    preserve source.rcl_owned_runtime_count == 0
      and source.js_reference_runtime_count == 8
      and platform.windows_native_status == "NATIVE_WINDOWS_VERIFIED"
      and gate.full_self_hosting == false
      and gate.rcl_stage0_model_compiles == true
      and gate.rcl_stage0_model_runs_on_js_runtime == true
      and gate.native_selfhost_runs_on_windows == false

    witness "rcl:selfhost-stage0-source-truth-model"
