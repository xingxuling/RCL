reality RCLGeneralSelfHostCompiler {
  facet selfhost.splice_format : Text = "rcl-open-module-v1: concatenate compiler-core.rcl, newline, compiler-main.rcl"

  reckon make_token_node(kind : Text, value : Text, line : Number, column : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), kind), value), line), column)

  reckon token_span_at(tokens : Sequence, index : Number) -> Span =
    make_span(0, sequence_get(sequence_get(tokens,  index), 2), sequence_get(sequence_get(tokens,  index), 3), 0)

  reckon require_token(tokens : Sequence, index : Number, expected : Text, code : Text) -> Truth =
    semantic_assert(sequence_get(sequence_get(tokens,  index), 1) == expected, code, expected, token_span_at(tokens, index))

  reckon require_kind(tokens : Sequence, index : Number, expected : Text, code : Text) -> Truth =
    semantic_assert(sequence_get(sequence_get(tokens,  index), 0) == expected, code, expected, token_span_at(tokens, index))

  reckon syntax_failure(tokens : Sequence, index : Number, code : Text) -> Sequence =
    choose(semantic_assert(false, code, sequence_get(sequence_get(tokens,  index), 1), token_span_at(tokens, index)),
      make_node_state(index, empty_sequence()), make_node_state(index, empty_sequence()))

  reckon make_text_state(index : Number, value : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), index), value)

  reckon make_node_state(index : Number, value : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), index), value)

  reckon append_all(items : Sequence, output : Sequence) -> Sequence = sequence_concat(output, items)

  reckon find_text(items : Sequence, index : Number, value : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(items, index) == value, index, find_text(items, index + 1, value)))

  reckon find_number(items : Sequence, index : Number, value : Number) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(items, index) == value, index, find_number(items, index + 1, value)))

  reckon append_unique_number(items : Sequence, value : Number) -> Sequence =
    choose(find_number(items, 0, value) >= 0, items, sequence_append(items, value))

  reckon either(left : Truth, right : Truth) -> Truth = choose(left, true, right)
  reckon both(left : Truth, right : Truth) -> Truth = choose(left, right, false)
  reckon minus_operator() -> Text = char_at("-x", 0)
  reckon not_operator() -> Text = slice_text("notx", 0, 3)

  reckon scan_identifier_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(is_identifier_part(char_at(source, index)), scan_identifier_end(source, index + 1), index))

  reckon scan_number_end(source : Text, index : Number, seen_dot : Truth) -> Number =
    choose(index >= length(source), index,
      choose(is_digit(char_at(source, index)), scan_number_end(source, index + 1, seen_dot),
        choose(both(char_at(source, index) == char_at(".", 0), not seen_dot),
          scan_number_end(source, index + 1, true), index)))

  reckon scan_string_end(source : Text, index : Number, escaped : Truth) -> Number =
    choose(index >= length(source), index,
      choose(escaped, scan_string_end(source, index + 1, false),
        choose(char_at(source, index) == char_at("\\", 0), scan_string_end(source, index + 1, true),
          choose(char_at(source, index) == char_at("\"", 0), index,
            scan_string_end(source, index + 1, false)))))

  reckon decoded_escape(value : Text) -> Text =
    choose(value == "n", "\n",
      choose(value == "r", "\r",
        choose(value == "t", "\t",
          choose(value == "\"", "\"", choose(value == "\\", "\\", value)))))

  reckon decode_string_from(source : Text, index : Number, end : Number, output : Text) -> Text =
    choose(index >= end, output,
      choose(char_at(source, index) == char_at("\\", 0),
        decode_string_from(source, index + 2, end, output + decoded_escape(char_at(source, index + 1))),
        decode_string_from(source, index + 1, end, output + char_at(source, index))))

  reckon scan_comment_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(char_at(source, index) == "\n", index, scan_comment_end(source, index + 1)))

  reckon position_after(source : Text, index : Number, end : Number, line : Number, column : Number) -> Sequence =
    choose(index >= end, sequence_append(sequence_append(empty_sequence(), line), column),
      choose(char_at(source, index) == "\n",
        position_after(source, index + 1, end, line + 1, 1),
        position_after(source, index + 1, end, line, column + choose(length(utf8_bytes(char_at(source, index))) == 4, 2, 1))))

  reckon is_two_symbol(value : Text) -> Truth =
    value == "<-" or value == "->" or value == "==" or value == "!=" or value == "<=" or value == ">="

  reckon concat_token_chunks(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      concat_token_chunks(items, index + 1, sequence_concat(output, sequence_get(items, index))))

  reckon tokenize_emit(source : Text, index : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence, token : Sequence) -> Sequence =
    choose(length(chunk) >= 127,
      tokenize_from(source, index, line, column, sequence_append(chunks, chunk),
        sequence_append(empty_sequence(), token)),
      tokenize_from(source, index, line, column, chunks, sequence_append(chunk, token)))


  reckon indexed_identifier_emit(source : Text, index : Number, end : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence) -> Sequence =
    tokenize_emit(source, end, line, column + end - index, chunks, chunk,
      make_token_node("IDENT", slice_text(source, index, end - index), line, column))
  reckon indexed_number_emit(source : Text, index : Number, end : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence) -> Sequence =
    tokenize_emit(source, end, line, column + end - index, chunks, chunk,
      make_token_node("NUMBER", slice_text(source, index, end - index), line, column))
  reckon indexed_comment_emit(source : Text, index : Number, end : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence) -> Sequence =
    tokenize_from(source, end, line, column + end - index, chunks, chunk)
  reckon indexed_string_position_emit(source : Text, index : Number, end : Number, line : Number, column : Number, position : Sequence, chunks : Sequence, chunk : Sequence) -> Sequence =
    tokenize_emit(source, end + 1, sequence_get(position, 0), sequence_get(position, 1), chunks, chunk,
      make_token_node("STRING", decode_string_from(source, index + 1, end, ""), line, column))
  reckon indexed_string_emit(source : Text, index : Number, end : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence) -> Sequence =
    indexed_string_position_emit(source, index, end, line, column, position_after(source, index, end + 1, line, column), chunks, chunk)

  reckon tokenize_from(source : Text, index : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence) -> Sequence =
    choose(index >= length(source),
      concat_token_chunks(sequence_append(chunks, sequence_append(chunk, make_token_node("EOF", "<eof>", line, column))), 0, empty_sequence()),
      indexed_tokenize_character(source, index, line, column, chunks, chunk, char_at(source, index)))

  reckon indexed_tokenize_character(source : Text, index : Number, line : Number, column : Number, chunks : Sequence, chunk : Sequence, character : Text) -> Sequence =
    choose(is_whitespace(character),
        choose(character == "\n",
          tokenize_from(source, index + 1, line + 1, 1, chunks, chunk),
          tokenize_from(source, index + 1, line, column + 1, chunks, chunk)),
        choose(either(character == char_at("#", 0), slice_text(source, index, 2) == "//"),
          indexed_comment_emit(source, index, scan_comment_end(source, index), line, column, chunks, chunk),
          choose(is_identifier_start(character),
            indexed_identifier_emit(source, index, scan_identifier_end(source, index + 1), line, column, chunks, chunk),
            choose(is_digit(character),
              indexed_number_emit(source, index, scan_number_end(source, index + 1, false), line, column, chunks, chunk),
              choose(character == char_at("\"", 0),
                indexed_string_emit(source, index, scan_string_end(source, index + 1, false), line, column, chunks, chunk),
                choose(is_two_symbol(slice_text(source, index, 2)),
                  tokenize_emit(source, index + 2, line, column + 2, chunks, chunk,
                    make_token_node("SYMBOL", slice_text(source, index, 2), line, column)),
                  tokenize_emit(source, index + 1, line, column + 1, chunks, chunk,
                    make_token_node("SYMBOL", character, line, column))))))))

  reckon tokenize(source : Text) -> Sequence = tokenize_from(source, 0, 1, 1, empty_sequence(), empty_sequence())

  reckon parse_path_tail(tokens : Sequence, index : Number, value : Text) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == ".",
      parse_path_tail(tokens, index + 2, value + "." + sequence_get(sequence_get(tokens,  index + 1), 1)),
      make_text_state(index, value))

  reckon parse_path(tokens : Sequence, index : Number) -> Sequence =
    parse_path_tail(tokens, index + 1, sequence_get(sequence_get(tokens,  index), 1))

  reckon literal_node(value_type : Text, value : Text) -> Sequence =
    indexed_counted_node(sequence_append(sequence_append(sequence_append(empty_sequence(), "LiteralExpr"), value_type), value))

  reckon path_node(path : Text) -> Sequence =
    indexed_counted_node(sequence_append(sequence_append(empty_sequence(), "PathExpr"), path))

  reckon unary_node(operator : Text, expression : Sequence) -> Sequence =
    indexed_counted_node(sequence_append(sequence_append(sequence_append(empty_sequence(), "UnaryExpr"), operator), expression))

  reckon binary_node(operator : Text, left : Sequence, right : Sequence) -> Sequence =
    indexed_counted_node(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), "BinaryExpr"), operator), left), right))

  reckon call_node(name : Text, args : Sequence) -> Sequence =
    indexed_counted_node(sequence_append(sequence_append(sequence_append(empty_sequence(), "CallExpr"), name), args))

  reckon binary_precedence(operator : Text) -> Number =
    choose(operator == "or", 1,
      choose(operator == "and", 2,
        choose(operator == "==" or operator == "!=", 3,
          choose(operator == "<" or operator == "<=" or operator == ">" or operator == ">=", 4,
            choose(operator == "+" or operator == minus_operator(), 5,
              choose(operator == "*" or operator == "/" or operator == "%", 6, 0))))))

  reckon parse_call_args(tokens : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == ")", make_node_state(index + 1, output),
      parse_call_args_after(tokens, parse_expression(tokens, index, 0), output))

  reckon parse_call_args_after(tokens : Sequence, item_state : Sequence, output : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  sequence_get(item_state, 0)), 1) == ",",
      parse_call_args(tokens, sequence_get(item_state, 0) + 1, sequence_append(output, sequence_get(item_state, 1))),
      make_node_state(sequence_get(item_state, 0) + 1, sequence_append(output, sequence_get(item_state, 1))))

  reckon parse_prefix(tokens : Sequence, index : Number) -> Sequence =
    choose(either(sequence_get(sequence_get(tokens,  index), 1) == not_operator(), sequence_get(sequence_get(tokens,  index), 1) == minus_operator()),
      parse_unary_after(tokens, index, parse_expression(tokens, index + 1, 7)),
      choose(sequence_get(sequence_get(tokens,  index), 0) == "NUMBER",
        make_node_state(index + 1, literal_node("Number", text(number_from_text(sequence_get(sequence_get(tokens,  index), 1))))),
        choose(sequence_get(sequence_get(tokens,  index), 0) == "STRING",
          make_node_state(index + 1, literal_node("Text", sequence_get(sequence_get(tokens,  index), 1))),
          choose(either(sequence_get(sequence_get(tokens,  index), 1) == "true", sequence_get(sequence_get(tokens,  index), 1) == "false"),
            make_node_state(index + 1, literal_node("Truth", sequence_get(sequence_get(tokens,  index), 1))),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "(",
              parse_parenthesized_after(parse_expression(tokens, index + 1, 0)),
              parse_identifier_expression(tokens, parse_path(tokens, index)))))))

  reckon parse_unary_after(tokens : Sequence, index : Number, expression_state : Sequence) -> Sequence =
    make_node_state(sequence_get(expression_state, 0), unary_node(sequence_get(sequence_get(tokens,  index), 1), sequence_get(expression_state, 1)))

  reckon parse_parenthesized_after(expression_state : Sequence) -> Sequence =
    make_node_state(sequence_get(expression_state, 0) + 1, sequence_get(expression_state, 1))

  reckon parse_identifier_expression(tokens : Sequence, path_state : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  sequence_get(path_state, 0)), 1) == "(",
      parse_identifier_call_after(sequence_get(path_state, 1), parse_call_args(tokens, sequence_get(path_state, 0) + 1, empty_sequence())),
      make_node_state(sequence_get(path_state, 0), path_node(sequence_get(path_state, 1))))

  reckon parse_identifier_call_after(name : Text, args_state : Sequence) -> Sequence =
    make_node_state(sequence_get(args_state, 0), call_node(name, sequence_get(args_state, 1)))

  reckon parse_binary_tail(tokens : Sequence, left : Sequence, index : Number, minimum : Number) -> Sequence =
    indexed_parse_binary_tail(tokens, left, index, minimum, binary_precedence(sequence_get(sequence_get(tokens,  index), 1)))

  reckon indexed_parse_binary_tail(tokens : Sequence, left : Sequence, index : Number, minimum : Number, precedence : Number) -> Sequence =
    choose(precedence < minimum or precedence == 0,
      make_node_state(index, left),
      parse_binary_right(tokens, left, index, minimum,
        parse_expression(tokens, index + 1, precedence + 1)))


  reckon parse_binary_right(tokens : Sequence, left : Sequence, operator_index : Number, minimum : Number, right_state : Sequence) -> Sequence =
    parse_binary_tail(tokens,
      binary_node(sequence_get(sequence_get(tokens,  operator_index), 1), left, sequence_get(right_state, 1)),
      sequence_get(right_state, 0), minimum)

  reckon parse_expression(tokens : Sequence, index : Number, minimum : Number) -> Sequence =
    parse_expression_after_prefix(tokens, minimum, parse_prefix(tokens, index))

  reckon parse_expression_after_prefix(tokens : Sequence, minimum : Number, prefix_state : Sequence) -> Sequence =
    parse_binary_tail(tokens, sequence_get(prefix_state, 1), sequence_get(prefix_state, 0), minimum)

  reckon make_param(name : Text, value_type : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), name), value_type)

  reckon parse_params(tokens : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == ")", make_node_state(index + 1, output),
      parse_param_type(tokens, index, parse_path(tokens, index + 2), output))

  reckon parse_param_type(tokens : Sequence, name_index : Number, type_state : Sequence, output : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  sequence_get(type_state, 0)), 1) == ",",
      parse_params(tokens, sequence_get(type_state, 0) + 1,
        sequence_append(output, make_param(sequence_get(sequence_get(tokens,  name_index), 1), sequence_get(type_state, 1)))),
      make_node_state(sequence_get(type_state, 0) + 1,
        sequence_append(output, make_param(sequence_get(sequence_get(tokens,  name_index), 1), sequence_get(type_state, 1)))))

  reckon make_facet(path : Text, value_type : Text, expression : Sequence, owner : Text, line : Number, column : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), path), value_type), expression), owner), line), column)

  reckon facet_input(node : Sequence) -> Truth = choose(length(node) > 6, sequence_get(node, 6), false)
  reckon mark_input(node : Sequence, input : Truth) -> Sequence = choose(input, sequence_append(node, true), node)

  reckon make_reckon(name : Text, params : Sequence, return_type : Text, expression : Sequence) -> Sequence =
    sequence_append(
      sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), params), return_type), expression),
      expression_count(expression))

  reckon parse_facet_after_path(tokens : Sequence, start : Number, path_state : Sequence) -> Sequence =
    parse_facet_after_type(tokens, start, sequence_get(path_state, 1), parse_path(tokens, sequence_get(path_state, 0) + 1))

  reckon parse_facet_after_type(tokens : Sequence, start : Number, path : Text, type_state : Sequence) -> Sequence =
    parse_facet_after_expression(tokens, start, path, sequence_get(type_state, 1),
      parse_expression(tokens, sequence_get(type_state, 0) + 1, 0))

  reckon parse_facet_after_expression(tokens : Sequence, start : Number, path : Text, value_type : Text, expression_state : Sequence) -> Sequence =
    make_node_state(sequence_get(expression_state, 0),
      mark_input(make_facet(path, value_type, sequence_get(expression_state, 1), "", sequence_get(sequence_get(tokens,  start), 2), sequence_get(sequence_get(tokens,  start), 3)), sequence_get(sequence_get(tokens,  start), 1) == "input"))

  reckon parse_facet(tokens : Sequence, index : Number) -> Sequence =
    parse_facet_after_path(tokens, index, parse_path(tokens, index + 1))

  reckon parse_reckon_after_params(tokens : Sequence, name : Text, params_state : Sequence) -> Sequence =
    parse_reckon_after_type(tokens, name, sequence_get(params_state, 1), parse_path(tokens, sequence_get(params_state, 0) + 1))

  reckon parse_reckon_after_type(tokens : Sequence, name : Text, params : Sequence, type_state : Sequence) -> Sequence =
    parse_reckon_after_expression(name, params, sequence_get(type_state, 1),
      parse_expression(tokens, sequence_get(type_state, 0) + 1, 0))

  reckon parse_reckon_after_expression(name : Text, params : Sequence, return_type : Text, expression_state : Sequence) -> Sequence =
    make_node_state(sequence_get(expression_state, 0), make_reckon(name, params, return_type, sequence_get(expression_state, 1)))

  reckon parse_reckon(tokens : Sequence, index : Number) -> Sequence =
    parse_reckon_after_params(tokens, sequence_get(sequence_get(tokens,  index + 1), 1), parse_params(tokens, index + 3, empty_sequence()))

  reckon own_facet(node : Sequence, owner : Text) -> Sequence =
    mark_input(make_facet(owner + "." + sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), owner, sequence_get(node, 4), sequence_get(node, 5)), facet_input(node))

  reckon parse_owned_facet_after(owner : Text, item_state : Sequence) -> Sequence =
    make_node_state(sequence_get(item_state, 0), own_facet(sequence_get(item_state, 1), owner))

  reckon parse_owned_facet(tokens : Sequence, index : Number, owner : Text) -> Sequence =
    parse_owned_facet_after(owner, parse_facet(tokens, index))

  reckon make_warrant(subject : Text, capability : Text, target : Text) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), subject), capability), target)

  reckon warrant_conditional(node : Sequence) -> Truth = length(node) > 3
  reckon parse_warrant_condition(subject : Text, capability : Text, target : Text, expression_state : Sequence) -> Sequence =
    make_node_state(sequence_get(expression_state, 0), sequence_append(make_warrant(subject, capability, target), sequence_get(expression_state, 1)))

  reckon parse_warrant_after_target(tokens : Sequence, subject : Text, capability : Text, target_state : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  sequence_get(target_state, 0)), 1) == "while",
      parse_warrant_condition(subject, capability, sequence_get(target_state, 1), parse_expression(tokens, sequence_get(target_state, 0) + 1, 0)),
      make_node_state(sequence_get(target_state, 0), make_warrant(subject, capability, sequence_get(target_state, 1))))

  reckon parse_warrant_after_capability(tokens : Sequence, subject : Text, capability_state : Sequence) -> Sequence =
    parse_warrant_after_target(tokens, subject, sequence_get(capability_state, 1), parse_path(tokens, sequence_get(capability_state, 0) + 1))

  reckon parse_warrant(tokens : Sequence, index : Number, subject : Text) -> Sequence =
    parse_warrant_after_capability(tokens, subject, parse_path(tokens, index + 1))

  reckon make_subject_state(index : Number, name : Text, facets : Sequence, warrants : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), index), name), facets), warrants)

  reckon parse_subject_body(tokens : Sequence, index : Number, name : Text, facets : Sequence, warrants : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_subject_state(index + 1, name, facets, warrants),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "facet" or sequence_get(sequence_get(tokens,  index), 1) == "input",
        parse_subject_after_facet(tokens, name, parse_owned_facet(tokens, index, name), facets, warrants),
        parse_subject_after_warrant(tokens, name, parse_warrant(tokens, index, name), facets, warrants)))

  reckon parse_subject_after_facet(tokens : Sequence, name : Text, item_state : Sequence, facets : Sequence, warrants : Sequence) -> Sequence =
    parse_subject_body(tokens, sequence_get(item_state, 0), name, sequence_append(facets, sequence_get(item_state, 1)), warrants)

  reckon parse_subject_after_warrant(tokens : Sequence, name : Text, item_state : Sequence, facets : Sequence, warrants : Sequence) -> Sequence =
    parse_subject_body(tokens, sequence_get(item_state, 0), name, facets, sequence_append(warrants, sequence_get(item_state, 1)))

  reckon parse_subject(tokens : Sequence, index : Number) -> Sequence =
    parse_subject_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence())

  reckon make_need(capability : Text, target : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), capability), target)

  reckon make_alter(target : Text, expression : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), target), expression)

  reckon make_rule(kind : Text, name : Text, cause : Text, from_subject : Text, into_subject : Text, when_expression : Sequence, needs : Sequence, preserves : Sequence, alters : Sequence, witnesses : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), kind), name), cause), from_subject), into_subject), when_expression), needs), preserves), alters), witnesses)

  reckon rule_with_cause(node : Sequence, value : Text) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), value, sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_from(node : Sequence, value : Text) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), value, sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_into(node : Sequence, value : Text) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), value, sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_when(node : Sequence, value : Sequence) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), value, sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_need(node : Sequence, value : Sequence) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_append(sequence_get(node, 6), value), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_preserve(node : Sequence, value : Sequence) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_append(sequence_get(node, 7), value), sequence_get(node, 8), sequence_get(node, 9))

  reckon rule_with_alter(node : Sequence, value : Sequence) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_append(sequence_get(node, 8), value), sequence_get(node, 9))

  reckon rule_with_witness(node : Sequence, value : Text) -> Sequence =
    make_rule(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_append(sequence_get(node, 9), value))

  reckon parse_rule_after_expression(tokens : Sequence, expression_state : Sequence, node : Sequence, clause : Text) -> Sequence =
    parse_rule_body(tokens, sequence_get(expression_state, 0),
      choose(clause == "when", rule_with_when(node, sequence_get(expression_state, 1)),
        rule_with_preserve(node, sequence_get(expression_state, 1))))

  reckon parse_rule_after_need_target(tokens : Sequence, capability : Text, target_state : Sequence, node : Sequence) -> Sequence =
    parse_rule_body(tokens, sequence_get(target_state, 0), rule_with_need(node, make_need(capability, sequence_get(target_state, 1))))

  reckon parse_rule_after_need_capability(tokens : Sequence, capability_state : Sequence, node : Sequence) -> Sequence =
    parse_rule_after_need_target(tokens, sequence_get(capability_state, 1), parse_path(tokens, sequence_get(capability_state, 0) + 1), node)

  reckon parse_rule_after_alter_expression(tokens : Sequence, target : Text, node : Sequence, expression_state : Sequence) -> Sequence =
    parse_rule_body(tokens, sequence_get(expression_state, 0), rule_with_alter(node, make_alter(target, sequence_get(expression_state, 1))))

  reckon parse_rule_after_alter_target(tokens : Sequence, target_state : Sequence, node : Sequence) -> Sequence =
    parse_rule_after_alter_expression(tokens, sequence_get(target_state, 1), node,
      parse_expression(tokens, sequence_get(target_state, 0) + 1, 0))

  reckon parse_rule_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "cause",
        parse_rule_body(tokens, index + 2, rule_with_cause(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "from",
          parse_rule_body(tokens, index + 2, rule_with_from(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "into",
            parse_rule_body(tokens, index + 2, rule_with_into(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
            choose(either(sequence_get(sequence_get(tokens,  index), 1) == "when", sequence_get(sequence_get(tokens,  index), 1) == "preserve"),
              parse_rule_after_expression(tokens, parse_expression(tokens, index + 1, 0), node, sequence_get(sequence_get(tokens,  index), 1)),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "needs",
                parse_rule_after_need_capability(tokens, parse_path(tokens, index + 1), node),
                choose(sequence_get(sequence_get(tokens,  index), 1) == "alter",
                  parse_rule_after_alter_target(tokens, parse_path(tokens, index + 1), node),
                  parse_rule_body(tokens, index + 2,
                    rule_with_witness(node, sequence_get(sequence_get(tokens,  index + 1), 1))))))))))

  reckon parse_rule(tokens : Sequence, index : Number) -> Sequence =
    parse_rule_body(tokens, index + 3,
      make_rule(choose(sequence_get(sequence_get(tokens,  index), 1) == "emergence", "Emergence", "Resonance"),
        sequence_get(sequence_get(tokens,  index + 1), 1), "", "", "", empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence()))

  reckon make_directive(kind : Text, name : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), kind), name)

  reckon parse_name_list_after_path(tokens : Sequence, path_state : Sequence, output : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  sequence_get(path_state, 0)), 1) == ",",
      parse_name_list(tokens, sequence_get(path_state, 0) + 1, sequence_append(output, sequence_get(path_state, 1))),
      make_node_state(sequence_get(path_state, 0), sequence_append(output, sequence_get(path_state, 1))))

  reckon parse_name_list(tokens : Sequence, index : Number, output : Sequence) -> Sequence =
    parse_name_list_after_path(tokens, parse_path(tokens, index), output)

  reckon make_offer(capability : Text, return_type : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), capability), return_type)

  reckon parse_host_after_offer_type(tokens : Sequence, capability : Text, type_state : Sequence, name : Text, offers : Sequence) -> Sequence =
    parse_host_body(tokens, sequence_get(type_state, 0), name,
      sequence_append(offers, make_offer(capability, sequence_get(type_state, 1))))

  reckon parse_host_after_offer_capability(tokens : Sequence, capability_state : Sequence, name : Text, offers : Sequence) -> Sequence =
    parse_host_after_offer_type(tokens, sequence_get(capability_state, 1),
      parse_path(tokens, sequence_get(capability_state, 0) + 1), name, offers)

  reckon parse_host_body(tokens : Sequence, index : Number, name : Text, offers : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      make_node_state(index + 1, sequence_append(sequence_append(empty_sequence(), name), offers)),
      parse_host_after_offer_capability(tokens, parse_path(tokens, index + 1), name, offers))

  reckon parse_host(tokens : Sequence, index : Number) -> Sequence =
    parse_host_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence())

  reckon make_effect(name : Text, deterministic : Text, replay : Text, evidence_required : Text, description : Text, lowers_to : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), deterministic), replay), evidence_required), description), lowers_to)

  reckon effect_with_deterministic(node : Sequence, value : Text) -> Sequence =
    make_effect(sequence_get(node, 0), value, sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5))

  reckon effect_with_replay(node : Sequence, value : Text) -> Sequence =
    make_effect(sequence_get(node, 0), sequence_get(node, 1), value, sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5))

  reckon effect_with_evidence(node : Sequence, value : Text) -> Sequence =
    make_effect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), value, sequence_get(node, 4), sequence_get(node, 5))

  reckon effect_with_description(node : Sequence, value : Text) -> Sequence =
    make_effect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), value, sequence_get(node, 5))

  reckon parse_effect_after_lowers(tokens : Sequence, node : Sequence, list_state : Sequence) -> Sequence =
    parse_effect_body(tokens, sequence_get(list_state, 0),
      make_effect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
        sequence_get(node, 4), append_all(sequence_get(list_state, 1), sequence_get(node, 5))))

  reckon parse_effect_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "deterministic",
        parse_effect_body(tokens, index + 2, effect_with_deterministic(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "replay",
          parse_effect_body(tokens, index + 2, effect_with_replay(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "evidence_required",
            parse_effect_body(tokens, index + 2, effect_with_evidence(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "description",
              parse_effect_body(tokens, index + 2, effect_with_description(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
              parse_effect_after_lowers(tokens, node, parse_name_list(tokens, index + 1, empty_sequence())))))))

  reckon parse_effect(tokens : Sequence, index : Number) -> Sequence =
    parse_effect_body(tokens, index + 3,
      make_effect(sequence_get(sequence_get(tokens,  index + 1), 1), "true", "deterministic", "false", "", empty_sequence()))

  reckon make_store(name : Text, branches : Sequence, commits : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), name), branches), commits)

  reckon parse_store_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "branch",
        parse_store_body(tokens, index + 2,
          make_store(sequence_get(node, 0), sequence_append(sequence_get(node, 1), sequence_get(sequence_get(tokens,  index + 1), 1)), sequence_get(node, 2))),
        parse_store_body(tokens, index + 2,
          make_store(sequence_get(node, 0), sequence_get(node, 1), sequence_append(sequence_get(node, 2), sequence_get(sequence_get(tokens,  index + 1), 1))))))

  reckon parse_store(tokens : Sequence, index : Number) -> Sequence =
    parse_store_body(tokens, index + 3, make_store(sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence()))

  reckon make_dialect_operation(name : Text, inputs : Sequence, outputs : Sequence, effects : Sequence, lowers_to : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), inputs), outputs), effects), lowers_to)

  reckon parse_operation_after_type(tokens : Sequence, node : Sequence, clause : Text, type_state : Sequence) -> Sequence =
    parse_dialect_operation_body(tokens, sequence_get(type_state, 0),
      choose(clause == "input",
        make_dialect_operation(sequence_get(node, 0), sequence_append(sequence_get(node, 1), sequence_get(type_state, 1)),
          sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4)),
        make_dialect_operation(sequence_get(node, 0), sequence_get(node, 1),
          sequence_append(sequence_get(node, 2), sequence_get(type_state, 1)), sequence_get(node, 3), sequence_get(node, 4))))

  reckon parse_operation_after_list(tokens : Sequence, node : Sequence, clause : Text, list_state : Sequence) -> Sequence =
    parse_dialect_operation_body(tokens, sequence_get(list_state, 0),
      choose(clause == "lowers_to",
        make_dialect_operation(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
          append_all(sequence_get(list_state, 1), sequence_get(node, 4))),
        make_dialect_operation(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2),
          append_all(sequence_get(list_state, 1), sequence_get(node, 3)), sequence_get(node, 4))))

  reckon parse_dialect_operation_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(either(sequence_get(sequence_get(tokens,  index), 1) == "input", sequence_get(sequence_get(tokens,  index), 1) == "output"),
        parse_operation_after_type(tokens, node, sequence_get(sequence_get(tokens,  index), 1), parse_path(tokens, index + 1)),
        parse_operation_after_list(tokens, node, sequence_get(sequence_get(tokens,  index), 1),
          parse_name_list(tokens, index + 1, empty_sequence()))))

  reckon parse_dialect_operation(tokens : Sequence, index : Number) -> Sequence =
    parse_dialect_operation_body(tokens, index + 3,
      make_dialect_operation(sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence()))

  reckon make_dialect(id : Text, version : Text, layer : Text, domain : Text, description : Text, operations : Sequence, lowers_to : Sequence, invariants : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), id), version), layer), domain), description), operations), lowers_to), invariants)

  reckon dialect_with_version(node : Sequence, value : Text) -> Sequence =
    make_dialect(sequence_get(node, 0), value, sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7))

  reckon dialect_with_layer(node : Sequence, value : Text) -> Sequence =
    make_dialect(sequence_get(node, 0), sequence_get(node, 1), value, sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7))

  reckon dialect_with_domain(node : Sequence, value : Text) -> Sequence =
    make_dialect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), value, sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7))

  reckon dialect_with_description(node : Sequence, value : Text) -> Sequence =
    make_dialect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), value, sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7))

  reckon parse_dialect_after_domain(tokens : Sequence, node : Sequence, path_state : Sequence) -> Sequence =
    parse_dialect_body(tokens, sequence_get(path_state, 0), dialect_with_domain(node, sequence_get(path_state, 1)))

  reckon parse_dialect_after_lowers(tokens : Sequence, node : Sequence, list_state : Sequence) -> Sequence =
    parse_dialect_body(tokens, sequence_get(list_state, 0),
      make_dialect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4),
        sequence_get(node, 5), append_all(sequence_get(list_state, 1), sequence_get(node, 6)), sequence_get(node, 7)))

  reckon parse_dialect_after_operation(tokens : Sequence, node : Sequence, operation_state : Sequence) -> Sequence =
    parse_dialect_body(tokens, sequence_get(operation_state, 0),
      make_dialect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4),
        sequence_append(sequence_get(node, 5), sequence_get(operation_state, 1)), sequence_get(node, 6), sequence_get(node, 7)))

  reckon parse_dialect_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "version",
        parse_dialect_body(tokens, index + 2, dialect_with_version(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "layer",
          parse_dialect_body(tokens, index + 2, dialect_with_layer(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "domain",
            parse_dialect_after_domain(tokens, node, parse_path(tokens, index + 1)),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "description",
              parse_dialect_body(tokens, index + 2, dialect_with_description(node, sequence_get(sequence_get(tokens,  index + 1), 1))),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "lowers_to",
                parse_dialect_after_lowers(tokens, node, parse_name_list(tokens, index + 1, empty_sequence())),
                choose(sequence_get(sequence_get(tokens,  index), 1) == "operation",
                  parse_dialect_after_operation(tokens, node, parse_dialect_operation(tokens, index)),
                  parse_dialect_body(tokens, index + 2,
                    make_dialect(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4),
                      sequence_get(node, 5), sequence_get(node, 6),
                      sequence_append(sequence_get(node, 7), sequence_get(sequence_get(tokens,  index + 1), 1)))))))))))

  reckon parse_dialect(tokens : Sequence, index : Number) -> Sequence =
    parse_dialect_body(tokens, index + 3,
      make_dialect(sequence_get(sequence_get(tokens,  index + 1), 1), "0.14.0-alpha.1", "semantic", "", "",
        empty_sequence(), empty_sequence(), empty_sequence()))

  reckon make_capability(capability : Text, target : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), capability), target)

  reckon make_budget(key : Text, value : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), key), value)

  reckon make_policy(name : Text, allowed : Sequence, denied : Sequence, capabilities : Sequence, host_capabilities : Sequence, budget : Sequence, require_replay : Text) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), allowed), denied), capabilities), host_capabilities), budget), require_replay)

  reckon parse_policy_after_list(tokens : Sequence, node : Sequence, clause : Text, list_state : Sequence) -> Sequence =
    parse_policy_body(tokens, sequence_get(list_state, 0),
      choose(clause == "allow_effect",
        make_policy(sequence_get(node, 0), append_all(sequence_get(list_state, 1), sequence_get(node, 1)), sequence_get(node, 2),
          sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6)),
        choose(clause == "deny_effect",
          make_policy(sequence_get(node, 0), sequence_get(node, 1), append_all(sequence_get(list_state, 1), sequence_get(node, 2)),
            sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6)),
          make_policy(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
            append_all(sequence_get(list_state, 1), sequence_get(node, 4)), sequence_get(node, 5), sequence_get(node, 6)))))

  reckon parse_policy_after_target(tokens : Sequence, node : Sequence, capability : Text, target_state : Sequence) -> Sequence =
    parse_policy_body(tokens, sequence_get(target_state, 0),
      make_policy(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2),
        sequence_append(sequence_get(node, 3), make_capability(capability, sequence_get(target_state, 1))),
        sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6)))

  reckon parse_policy_after_capability(tokens : Sequence, node : Sequence, capability_state : Sequence) -> Sequence =
    parse_policy_after_target(tokens, node, sequence_get(capability_state, 1), parse_path(tokens, sequence_get(capability_state, 0) + 1))

  reckon parse_policy_require(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(either(sequence_get(sequence_get(tokens,  index + 1), 1) == "true", sequence_get(sequence_get(tokens,  index + 1), 1) == "false"),
      parse_policy_body(tokens, index + 2,
        make_policy(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
          sequence_get(node, 4), sequence_get(node, 5), sequence_get(sequence_get(tokens,  index + 1), 1))),
      parse_policy_body(tokens, index + 1,
        make_policy(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
          sequence_get(node, 4), sequence_get(node, 5), "true")))

  reckon parse_policy_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(either(sequence_get(sequence_get(tokens,  index), 1) == "allow_effect", sequence_get(sequence_get(tokens,  index), 1) == "deny_effect"),
        parse_policy_after_list(tokens, node, sequence_get(sequence_get(tokens,  index), 1),
          parse_name_list(tokens, index + 1, empty_sequence())),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "allow",
          parse_policy_after_capability(tokens, node, parse_path(tokens, index + 1)),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "allow_host",
            parse_policy_after_list(tokens, node, sequence_get(sequence_get(tokens,  index), 1),
              parse_name_list(tokens, index + 1, empty_sequence())),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "budget",
              parse_policy_body(tokens, index + 3,
                make_policy(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3),
                  sequence_get(node, 4),
                  sequence_append(sequence_get(node, 5), make_budget(sequence_get(sequence_get(tokens,  index + 1), 1),
                    text(number_from_text(sequence_get(sequence_get(tokens,  index + 2), 1))))), sequence_get(node, 6))),
              parse_policy_require(tokens, index, node))))))

  reckon parse_policy(tokens : Sequence, index : Number) -> Sequence =
    parse_policy_body(tokens, index + 3,
      make_policy(sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), "false"))

  reckon make_ui_property(name : Text, expression : Sequence, inherited : Truth) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), name), expression), inherited)

  reckon parse_ui_property_after_expression(tokens : Sequence, expression_state : Sequence, name : Text, allow_inherit : Truth) -> Sequence =
    make_node_state(
      choose(allow_inherit and sequence_get(sequence_get(tokens,  sequence_get(expression_state, 0)), 1) == "inherit", sequence_get(expression_state, 0) + 1, sequence_get(expression_state, 0)),
      make_ui_property(name, sequence_get(expression_state, 1), allow_inherit and sequence_get(sequence_get(tokens,  sequence_get(expression_state, 0)), 1) == "inherit"))

  reckon parse_ui_property(tokens : Sequence, index : Number, allow_inherit : Truth) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_PROPERTY_NAME"),
      choose(require_token(tokens, index + 2, "=", "RCL_UI_PROPERTY_ASSIGN"),
        parse_ui_property_after_expression(tokens, parse_expression(tokens, index + 3, 0), sequence_get(sequence_get(tokens,  index + 1), 1), allow_inherit),
        empty_sequence()), empty_sequence())

  reckon make_ui_state(name : Text, value_type : Text, expression : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), name), value_type), expression)

  reckon parse_ui_state_after_expression(expression_state : Sequence, name : Text, value_type : Text) -> Sequence =
    make_node_state(sequence_get(expression_state, 0), make_ui_state(name, value_type, sequence_get(expression_state, 1)))

  reckon parse_ui_state_after_type(tokens : Sequence, name : Text, type_state : Sequence) -> Sequence =
    choose(require_token(tokens, sequence_get(type_state, 0), "=", "RCL_UI_STATE_ASSIGN"),
      parse_ui_state_after_expression(parse_expression(tokens, sequence_get(type_state, 0) + 1, 0), name, sequence_get(type_state, 1)),
      empty_sequence())

  reckon parse_ui_state(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_STATE_NAME"),
      choose(require_token(tokens, index + 2, ":", "RCL_UI_STATE_TYPE"),
        parse_ui_state_after_type(tokens, sequence_get(sequence_get(tokens,  index + 1), 1), parse_path(tokens, index + 3)),
        empty_sequence()), empty_sequence())

  reckon make_ui_theme(name : Text, declarations : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), name), declarations)

  reckon parse_ui_theme_after_property(tokens : Sequence, name : Text, property_state : Sequence, declarations : Sequence) -> Sequence =
    parse_ui_theme_body(tokens, sequence_get(property_state, 0), name, sequence_append(declarations, sequence_get(property_state, 1)))

  reckon parse_ui_theme_body(tokens : Sequence, index : Number, name : Text, declarations : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, make_ui_theme(name, declarations)),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "property",
        parse_ui_theme_after_property(tokens, name, parse_ui_property(tokens, index, true), declarations),
        syntax_failure(tokens, index, "RCL_UI_THEME_CLAUSE")))

  reckon parse_ui_theme(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_THEME_NAME"),
      choose(require_token(tokens, index + 2, "{", "RCL_UI_THEME_OPEN"),
        parse_ui_theme_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence()), empty_sequence()), empty_sequence())

  reckon make_ui_style(name : Text, selector_kind : Text, selector_value : Text, priority : Number, declarations : Sequence, order : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), selector_kind), selector_value), priority), declarations), order)

  reckon parse_ui_style_after_property(tokens : Sequence, name : Text, selector_kind : Text, selector_value : Text, priority : Number, declarations : Sequence, order : Number, property_state : Sequence) -> Sequence =
    parse_ui_style_body(tokens, sequence_get(property_state, 0), name, selector_kind, selector_value, priority,
      sequence_append(declarations, sequence_get(property_state, 1)), order)

  reckon parse_ui_style_body(tokens : Sequence, index : Number, name : Text, selector_kind : Text, selector_value : Text, priority : Number, declarations : Sequence, order : Number) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      choose(semantic_check(selector_kind != "", "RCL_UI_STYLE_SELECTOR", name),
        make_node_state(index + 1, make_ui_style(name, selector_kind, selector_value, priority, declarations, order)), empty_sequence()),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "target",
        parse_ui_style_body(tokens, index + 3, name, sequence_get(sequence_get(tokens,  index + 1), 1), sequence_get(sequence_get(tokens,  index + 2), 1), priority, declarations, order),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "priority",
          parse_ui_style_body(tokens, index + 2, name, selector_kind, selector_value,
            number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1)), declarations, order),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "property",
            parse_ui_style_after_property(tokens, name, selector_kind, selector_value, priority, declarations, order,
              parse_ui_property(tokens, index, true)),
            syntax_failure(tokens, index, "RCL_UI_STYLE_CLAUSE")))))

  reckon parse_ui_style(tokens : Sequence, index : Number, order : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_STYLE_NAME"),
      choose(require_token(tokens, index + 2, "{", "RCL_UI_STYLE_OPEN"),
        parse_ui_style_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), "", "", 0, empty_sequence(), order),
        empty_sequence()), empty_sequence())

  reckon make_ui_layout(mode : Text, width_mode : Text, width_value : Text, height_mode : Text, height_value : Text, gap : Number, padding : Number, alignment : Text, distribution : Text, overflow : Text, columns : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), mode), width_mode), width_value), height_mode), height_value), gap), padding), alignment), distribution), overflow), columns)

  reckon default_ui_layout() -> Sequence = make_ui_layout("vertical", "fill", "", "intrinsic", "", 0, 0, "stretch", "start", "visible", 1)
  reckon make_ui_layout_extensions(base : Sequence, adaptive : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), base), adaptive)
  reckon default_ui_layout_extensions() -> Sequence = make_ui_layout_extensions(default_ui_layout(), empty_sequence())
  reckon ui_layout_extensions_with_base(node : Sequence, base : Sequence) -> Sequence =
    make_ui_layout_extensions(base, sequence_get(node, 1))
  reckon ui_layout_extensions_add(node : Sequence, profile : Text, mode : Text) -> Sequence =
    make_ui_layout_extensions(sequence_get(node, 0),
      sequence_append(sequence_get(node, 1), sequence_append(sequence_append(empty_sequence(), profile), mode)))
  reckon find_ui_adaptive_profile(items : Sequence, index : Number, profile : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 0) == profile, index,
        find_ui_adaptive_profile(items, index + 1, profile)))
  reckon ui_layout_with_width(node : Sequence, mode : Text, value : Text) -> Sequence =
    make_ui_layout(sequence_get(node, 0), mode, value, sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9), sequence_get(node, 10))

  reckon ui_layout_with_height(node : Sequence, mode : Text, value : Text) -> Sequence =
    make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), mode, value, sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9), sequence_get(node, 10))

  reckon parse_ui_layout_size(tokens : Sequence, index : Number, node : Sequence, axis : Text) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_LAYOUT_WIDTH_MODE"),
      choose(semantic_check(sequence_get(sequence_get(tokens,  index + 1), 1) == "fill"
          or sequence_get(sequence_get(tokens,  index + 1), 1) == "intrinsic" or sequence_get(sequence_get(tokens,  index + 1), 1) == "fixed",
          "RCL_UI_LAYOUT_SIZE_MODE", axis + ":" + sequence_get(sequence_get(tokens,  index + 1), 1)),
        choose(sequence_get(sequence_get(tokens,  index + 1), 1) == "fixed",
          choose(require_kind(tokens, index + 2, "NUMBER", "RCL_UI_LAYOUT_FIXED_SIZE"),
            choose(semantic_check(number_from_text(sequence_get(sequence_get(tokens,  index + 2), 1)) >= 0,
                "RCL_UI_LAYOUT_FIXED_SIZE", axis),
              parse_ui_layout_body(tokens, index + 3,
                choose(axis == "width",
                  ui_layout_with_width(node, "fixed", text(number_from_text(sequence_get(sequence_get(tokens,  index + 2), 1)))),
                  ui_layout_with_height(node, "fixed", text(number_from_text(sequence_get(sequence_get(tokens,  index + 2), 1)))))),
              empty_sequence()), empty_sequence()),
          parse_ui_layout_body(tokens, index + 2,
            choose(axis == "width",
              ui_layout_with_width(node, sequence_get(sequence_get(tokens,  index + 1), 1), ""),
              ui_layout_with_height(node, sequence_get(sequence_get(tokens,  index + 1), 1), "")))),
        empty_sequence()), empty_sequence())

  reckon parse_ui_layout_body(tokens : Sequence, index : Number, node : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", make_node_state(index + 1, node),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "width",
        parse_ui_layout_size(tokens, index, node, "width"),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "height",
          parse_ui_layout_size(tokens, index, node, "height"),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "gap",
            parse_ui_layout_body(tokens, index + 2,
              make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1)), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9), sequence_get(node, 10))),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "padding",
              parse_ui_layout_body(tokens, index + 2,
                make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1)), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9), sequence_get(node, 10))),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "align",
                parse_ui_layout_body(tokens, index + 2,
                  make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(sequence_get(tokens,  index + 1), 1), sequence_get(node, 8), sequence_get(node, 9), sequence_get(node, 10))),
                choose(sequence_get(sequence_get(tokens,  index), 1) == "distribute",
                  parse_ui_layout_body(tokens, index + 2,
                    make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(sequence_get(tokens,  index + 1), 1), sequence_get(node, 9), sequence_get(node, 10))),
                  choose(sequence_get(sequence_get(tokens,  index), 1) == "overflow",
                    parse_ui_layout_body(tokens, index + 2,
                      make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(sequence_get(tokens,  index + 1), 1), sequence_get(node, 10))),
                    choose(sequence_get(sequence_get(tokens,  index), 1) == "columns",
                      parse_ui_layout_body(tokens, index + 2,
                        make_ui_layout(sequence_get(node, 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), sequence_get(node, 4), sequence_get(node, 5), sequence_get(node, 6), sequence_get(node, 7), sequence_get(node, 8), sequence_get(node, 9), number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1)))),
                      syntax_failure(tokens, index, "RCL_UI_LAYOUT_CLAUSE"))))))))))

  reckon parse_ui_layout(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_LAYOUT_MODE"),
      choose(require_token(tokens, index + 2, "{", "RCL_UI_LAYOUT_OPEN"),
        parse_ui_layout_body(tokens, index + 3,
          make_ui_layout(sequence_get(sequence_get(tokens,  index + 1), 1), "fill", "", "intrinsic", "", 0, 0, "stretch", "start", "visible", 1)),
        empty_sequence()), empty_sequence())

  reckon make_ui_parameter(name : Text, value_type : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), name), value_type)

  reckon find_ui_parameter_type(items : Sequence, index : Number, name : Text) -> Text =
    choose(index >= length(items), "",
      choose(sequence_get(sequence_get(items, index), 0) == name, sequence_get(sequence_get(items, index), 1),
        find_ui_parameter_type(items, index + 1, name)))

  reckon ui_event_type_allowed(event_type : Text) -> Truth =
    event_type == "activate" or event_type == "input" or event_type == "change" or event_type == "submit"
      or event_type == "focus" or event_type == "blur" or event_type == "navigate" or event_type == "create"
      or event_type == "resume" or event_type == "suspend" or event_type == "destroy" or event_type == "custom"

  reckon ui_expected_event_parameter_type(event_type : Text, name : Text) -> Text =
    choose((event_type == "input" or event_type == "change") and name == "value", "Text",
      choose(event_type == "navigate" and name == "destination", "Text", ""))

  reckon ui_parameter_value_type(event_type : Text, name : Text, declared_type : Text) -> Text =
    choose(declared_type != "", declared_type, ui_expected_event_parameter_type(event_type, name))

  reckon ui_parameter_type_allowed(value_type : Text) -> Truth =
    value_type == "Number" or value_type == "Text" or value_type == "Truth"

  reckon make_ui_event(event_type : Text, parameters : Sequence, statements : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), event_type), parameters), statements)

  reckon make_ui_set(target : Text, expression : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(empty_sequence(), "set-state"), target), expression)
  reckon ui_statements_have_kind(items : Sequence, index : Number, kind : Text) -> Truth =
    choose(index >= length(items), false,
      sequence_get(sequence_get(items, index), 0) == kind or ui_statements_have_kind(items, index + 1, kind))

  reckon finish_ui_event(index : Number, event_type : Text, parameters : Sequence, statements : Sequence) -> Sequence =
      choose(semantic_check(not ((ui_statements_have_kind(statements, 0, "set-state")
          or ui_statements_have_kind(statements, 0, "navigate"))
        and ui_statements_have_kind(statements, 0, "realize-reality")),
        "RCL_UI_EVENT_MIXED_AUTHORITY", event_type),
      make_node_state(index, make_ui_event(event_type, parameters, statements)), empty_sequence())

  reckon parse_ui_event_after_expression(tokens : Sequence, event_type : Text, parameters : Sequence, target : Text, statements : Sequence, expression_state : Sequence) -> Sequence =
    parse_ui_event_body(tokens, sequence_get(expression_state, 0), event_type, parameters,
      sequence_append(statements, make_ui_set(target, sequence_get(expression_state, 1))))

  reckon parse_ui_event_after_target(tokens : Sequence, event_type : Text, parameters : Sequence, statements : Sequence, target_state : Sequence) -> Sequence =
    choose(require_token(tokens, sequence_get(target_state, 0), "<-", "RCL_UI_EVENT_ASSIGN"),
      parse_ui_event_after_expression(tokens, event_type, parameters, sequence_get(target_state, 1), statements,
        parse_expression(tokens, sequence_get(target_state, 0) + 1, 0)), empty_sequence())

  reckon parse_ui_event_body(tokens : Sequence, index : Number, event_type : Text, parameters : Sequence, statements : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}", finish_ui_event(index + 1, event_type, parameters, statements),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "set",
        parse_ui_event_after_target(tokens, event_type, parameters, statements, parse_path(tokens, index + 1)),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "realize",
          choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_REALITY_RULE"),
            parse_ui_event_body(tokens, index + 2, event_type, parameters,
              sequence_append(statements,
                sequence_append(sequence_append(empty_sequence(), "realize-reality"), sequence_get(sequence_get(tokens,  index + 1), 1)))), empty_sequence()),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "navigate",
            choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_NAVIGATION_ROUTE"),
              choose(semantic_check(not ui_statements_have_kind(statements, 0, "navigate"),
                  "RCL_UI_EVENT_MULTIPLE_NAVIGATION", event_type),
                parse_ui_event_body(tokens, index + 2, event_type, parameters,
                  sequence_append(statements,
                    sequence_append(sequence_append(empty_sequence(), "navigate"), sequence_get(sequence_get(tokens,  index + 1), 1)))), empty_sequence()), empty_sequence()),
            syntax_failure(tokens, index, "RCL_UI_EVENT_STATEMENT")))))

  reckon parse_ui_event_parameter_finish(tokens : Sequence, index : Number, event_type : Text, parameters : Sequence, name : Text, declared_type : Text) -> Sequence =
    choose(semantic_check(find_ui_parameter_type(parameters, 0, name) == "", "RCL_UI_EVENT_PARAMETER_DUPLICATE", name),
      choose(semantic_check((event_type == "custom" or ui_expected_event_parameter_type(event_type, name) != "")
          and ui_parameter_type_allowed(ui_parameter_value_type(event_type, name, declared_type))
          and (ui_expected_event_parameter_type(event_type, name) == ""
            or ui_parameter_value_type(event_type, name, declared_type) == ui_expected_event_parameter_type(event_type, name)),
          "RCL_UI_EVENT_PARAMETER_TYPE", event_type + ":" + name),
        choose(sequence_get(sequence_get(tokens,  index), 1) == ",",
          parse_ui_event_parameters(tokens, index + 1, event_type,
            sequence_append(parameters, make_ui_parameter(name, ui_parameter_value_type(event_type, name, declared_type)))),
          choose(sequence_get(sequence_get(tokens,  index), 1) == ")",
            make_node_state(index + 1,
              sequence_append(parameters, make_ui_parameter(name, ui_parameter_value_type(event_type, name, declared_type)))),
            syntax_failure(tokens, index, "RCL_UI_EVENT_PARAMETER_DELIMITER"))), empty_sequence()), empty_sequence())

  reckon parse_ui_event_parameter_after_name(tokens : Sequence, index : Number, event_type : Text, parameters : Sequence, name : Text) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == ":",
      choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_EVENT_PARAMETER_TYPE"),
        parse_ui_event_parameter_finish(tokens, index + 2, event_type, parameters, name, sequence_get(sequence_get(tokens,  index + 1), 1)), empty_sequence()),
      parse_ui_event_parameter_finish(tokens, index, event_type, parameters, name, ""))

  reckon parse_ui_event_parameters(tokens : Sequence, index : Number, event_type : Text, parameters : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == ")", make_node_state(index + 1, parameters),
      choose(require_kind(tokens, index, "IDENT", "RCL_UI_EVENT_PARAMETER"),
        parse_ui_event_parameter_after_name(tokens, index + 1, event_type, parameters, sequence_get(sequence_get(tokens,  index), 1)), empty_sequence()))

  reckon parse_ui_event_after_parameters(tokens : Sequence, event_type : Text, parameter_state : Sequence) -> Sequence =
    choose(require_token(tokens, sequence_get(parameter_state, 0), "{", "RCL_UI_EVENT_OPEN"),
      parse_ui_event_body(tokens, sequence_get(parameter_state, 0) + 1, event_type, sequence_get(parameter_state, 1), empty_sequence()), empty_sequence())

  reckon parse_ui_event(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_EVENT_TYPE"),
      choose(semantic_check(ui_event_type_allowed(sequence_get(sequence_get(tokens,  index + 1), 1)), "RCL_UI_EVENT_TYPE", sequence_get(sequence_get(tokens,  index + 1), 1)),
        choose(sequence_get(sequence_get(tokens,  index + 2), 1) == "(",
          parse_ui_event_after_parameters(tokens, sequence_get(sequence_get(tokens,  index + 1), 1),
            parse_ui_event_parameters(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence())),
          choose(require_token(tokens, index + 2, "{", "RCL_UI_EVENT_OPEN"),
            parse_ui_event_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence()), empty_sequence())),
        empty_sequence()), empty_sequence())

  reckon make_ui_view(id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, layout : Sequence, children : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), id), role), classes), properties), bindings), events), layout), children)

  reckon ui_view_layout(node : Sequence) -> Sequence = sequence_get(sequence_get(node, 6), 0)
  reckon ui_view_adaptive_layouts(node : Sequence) -> Sequence = sequence_get(sequence_get(node, 6), 1)
  reckon parse_ui_view_after_expression(tokens : Sequence, id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, layout : Sequence, children : Sequence, property : Text, binding : Truth, expression_state : Sequence) -> Sequence =
    parse_ui_view_body(tokens, sequence_get(expression_state, 0), id, role, classes,
      choose(binding, properties, sequence_append(properties, make_ui_property(property, sequence_get(expression_state, 1), false))),
      choose(binding, sequence_append(bindings, make_ui_property(property, sequence_get(expression_state, 1), false)), bindings),
      events, layout, children)

  reckon parse_ui_view_after_child(tokens : Sequence, id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, layout : Sequence, children : Sequence, child_state : Sequence) -> Sequence =
    parse_ui_view_body(tokens, sequence_get(child_state, 0), id, role, classes, properties, bindings, events, layout,
      sequence_append(children, sequence_get(child_state, 1)))

  reckon parse_ui_view_after_layout(tokens : Sequence, id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, children : Sequence, layout_state : Sequence) -> Sequence =
    parse_ui_view_body(tokens, sequence_get(layout_state, 0), id, role, classes, properties, bindings, events,
      ui_layout_extensions_with_base(default_ui_layout_extensions(), sequence_get(layout_state, 1)), children)

  reckon parse_ui_view_after_event(tokens : Sequence, id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, layout : Sequence, children : Sequence, event_state : Sequence) -> Sequence =
    parse_ui_view_body(tokens, sequence_get(event_state, 0), id, role, classes, properties, bindings,
      sequence_append(events, sequence_get(event_state, 1)), layout, children)

  reckon is_ui_view_keyword(keyword : Text) -> Truth =
    keyword == "view" or keyword == "text" or keyword == "action" or keyword == "input"

  reckon is_ui_content_property(keyword : Text) -> Truth =
    keyword == "value" or keyword == "label" or keyword == "placeholder" or keyword == "accessibility_label"

  reckon parse_ui_view_body(tokens : Sequence, index : Number, id : Text, role : Text, classes : Sequence, properties : Sequence, bindings : Sequence, events : Sequence, layout : Sequence, children : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      make_node_state(index + 1, make_ui_view(id, role, classes, properties, bindings, events, layout, children)),
      choose(is_ui_view_keyword(sequence_get(sequence_get(tokens,  index), 1)),
        parse_ui_view_after_child(tokens, id, role, classes, properties, bindings, events, layout, children,
          parse_ui_view(tokens, index)),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "class",
          parse_ui_view_body(tokens, index + 2, id, role, sequence_append(classes, sequence_get(sequence_get(tokens,  index + 1), 1)), properties, bindings, events, layout, children),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "layout",
            parse_ui_view_after_layout(tokens, id, role, classes, properties, bindings, events, children,
              parse_ui_layout(tokens, index)),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "adapt",
              choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_DEVICE_ADAPTATION_PROFILE"),
                choose(require_token(tokens, index + 2, "layout", "RCL_UI_DEVICE_ADAPTATION_LAYOUT"),
                  choose(require_kind(tokens, index + 3, "IDENT", "RCL_UI_DEVICE_ADAPTATION_LAYOUT_MODE"),
                    choose(semantic_check(find_ui_adaptive_profile(sequence_get(layout, 1), 0, sequence_get(sequence_get(tokens,  index + 1), 1)) < 0,
                        "RCL_UI_DEVICE_ADAPTATION_LAYOUT_DUPLICATE", id + ":" + sequence_get(sequence_get(tokens,  index + 1), 1)),
                      choose(semantic_check(role == "container"
                            and (sequence_get(sequence_get(layout, 0), 0) == "vertical" or sequence_get(sequence_get(layout, 0), 0) == "horizontal")
                            and (sequence_get(sequence_get(tokens,  index + 3), 1) == "vertical" or sequence_get(sequence_get(tokens,  index + 3), 1) == "horizontal"),
                          "RCL_UI_DEVICE_ADAPTATION_LAYOUT_MODE", id + ":" + sequence_get(sequence_get(tokens,  index + 3), 1)),
                        parse_ui_view_body(tokens, index + 4, id, role, classes, properties, bindings, events,
                          ui_layout_extensions_add(layout, sequence_get(sequence_get(tokens,  index + 1), 1), sequence_get(sequence_get(tokens,  index + 3), 1)), children),
                        empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()),
              choose(is_ui_content_property(sequence_get(sequence_get(tokens,  index), 1)),
              parse_ui_view_after_expression(tokens, id, role, classes, properties, bindings, events, layout, children,
                sequence_get(sequence_get(tokens,  index), 1), false, parse_expression(tokens, index + 1, 0)),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "property",
                parse_ui_view_after_expression(tokens, id, role, classes, properties, bindings, events, layout, children,
                  sequence_get(sequence_get(tokens,  index + 1), 1), false, parse_expression(tokens, index + 3, 0)),
                choose(sequence_get(sequence_get(tokens,  index), 1) == "bind",
                  choose(require_token(tokens, index + 2, "<-", "RCL_UI_BIND_ASSIGN"),
                    parse_ui_view_after_expression(tokens, id, role, classes, properties, bindings, events, layout, children,
                      sequence_get(sequence_get(tokens,  index + 1), 1), true, parse_expression(tokens, index + 3, 0)), empty_sequence()),
                  choose(sequence_get(sequence_get(tokens,  index), 1) == "on",
                    parse_ui_view_after_event(tokens, id, role, classes, properties, bindings, events, layout, children,
                      parse_ui_event(tokens, index)),
                    syntax_failure(tokens, index, "RCL_UI_NODE_CLAUSE"))))))))))

  reckon parse_ui_view(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_NODE_ID"),
      choose(require_token(tokens, index + 2, "{", "RCL_UI_NODE_OPEN"),
        parse_ui_view_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "view", "container",
            choose(sequence_get(sequence_get(tokens,  index), 1) == "text", "text", choose(sequence_get(sequence_get(tokens,  index), 1) == "action", "action", "input"))),
          empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), default_ui_layout_extensions(), empty_sequence()),
        empty_sequence()), empty_sequence())

  reckon parse_ui_navigation_body(tokens : Sequence, index : Number, initial : Text, route_ids : Sequence, route_targets : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      choose(semantic_check(initial != "", "RCL_UI_NAVIGATION_INITIAL_REQUIRED", "navigation"),
        choose(semantic_check(length(route_ids) > 0, "RCL_UI_NAVIGATION_ROUTE_REQUIRED", "navigation"),
          make_node_state(index + 1, sequence_append(sequence_append(sequence_append(empty_sequence(), initial), route_ids), route_targets)), empty_sequence()), empty_sequence()),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "initial",
        choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_NAVIGATION_INITIAL"),
          choose(semantic_check(initial == "", "RCL_UI_NAVIGATION_INITIAL_DUPLICATE", sequence_get(sequence_get(tokens,  index + 1), 1)),
            parse_ui_navigation_body(tokens, index + 2, sequence_get(sequence_get(tokens,  index + 1), 1), route_ids, route_targets), empty_sequence()), empty_sequence()),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "route",
          choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_NAVIGATION_ROUTE"),
            choose(require_token(tokens, index + 2, "->", "RCL_UI_NAVIGATION_TARGET"),
              choose(require_kind(tokens, index + 3, "IDENT", "RCL_UI_NAVIGATION_TARGET"),
                choose(semantic_check(find_text(route_ids, 0, sequence_get(sequence_get(tokens,  index + 1), 1)) < 0,
                    "RCL_UI_NAVIGATION_ROUTE_DUPLICATE", sequence_get(sequence_get(tokens,  index + 1), 1)),
                  choose(semantic_check(find_text(route_targets, 0, sequence_get(sequence_get(tokens,  index + 3), 1)) < 0,
                      "RCL_UI_NAVIGATION_TARGET_DUPLICATE", sequence_get(sequence_get(tokens,  index + 3), 1)),
                    parse_ui_navigation_body(tokens, index + 4, initial,
                      sequence_append(route_ids, sequence_get(sequence_get(tokens,  index + 1), 1)),
                      sequence_append(route_targets, sequence_get(sequence_get(tokens,  index + 3), 1))),
                    empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()),
          syntax_failure(tokens, index, "RCL_UI_NAVIGATION_CLAUSE"))))

  reckon ui_device_ranges_overlap(mins : Sequence, maxs : Sequence, index : Number, min_width : Number, max_width : Number) -> Truth =
    choose(index >= length(mins), false,
      choose(sequence_get(mins, index) <= choose(max_width < 0, 1000000000, max_width)
          and min_width <= choose(sequence_get(maxs, index) < 0, 1000000000, sequence_get(maxs, index)),
        true, ui_device_ranges_overlap(mins, maxs, index + 1, min_width, max_width)))

  reckon parse_ui_adaptation_body(tokens : Sequence, index : Number, default_profile : Text, ids : Sequence, mins : Sequence, maxs : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      choose(semantic_check(default_profile != "", "RCL_UI_DEVICE_ADAPTATION_DEFAULT_REQUIRED", "adaptation"),
        choose(semantic_check(length(ids) > 0, "RCL_UI_DEVICE_ADAPTATION_PROFILE_REQUIRED", "adaptation"),
          choose(semantic_check(find_text(ids, 0, default_profile) >= 0,
              "RCL_UI_DEVICE_ADAPTATION_DEFAULT_UNKNOWN", default_profile),
            make_node_state(index + 1,
              sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), default_profile), ids), mins), maxs)),
            empty_sequence()), empty_sequence()), empty_sequence()),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "default",
        choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_DEVICE_ADAPTATION_DEFAULT"),
          choose(semantic_check(default_profile == "", "RCL_UI_DEVICE_ADAPTATION_DEFAULT_DUPLICATE", sequence_get(sequence_get(tokens,  index + 1), 1)),
            parse_ui_adaptation_body(tokens, index + 2, sequence_get(sequence_get(tokens,  index + 1), 1), ids, mins, maxs), empty_sequence()), empty_sequence()),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "profile",
          choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_DEVICE_ADAPTATION_PROFILE"),
            parse_ui_adaptation_profile(tokens, index + 2, default_profile, ids, mins, maxs,
              sequence_get(sequence_get(tokens,  index + 1), 1), -1, -1), empty_sequence()),
          syntax_failure(tokens, index, "RCL_UI_DEVICE_ADAPTATION_CLAUSE"))))

  reckon parse_ui_adaptation_profile(tokens : Sequence, index : Number, default_profile : Text, ids : Sequence, mins : Sequence, maxs : Sequence, id : Text, min_width : Number, max_width : Number) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "min_width",
      choose(require_kind(tokens, index + 1, "NUMBER", "RCL_UI_DEVICE_ADAPTATION_MIN_WIDTH"),
        choose(semantic_check(min_width < 0, "RCL_UI_DEVICE_ADAPTATION_MIN_WIDTH_DUPLICATE", id),
          parse_ui_adaptation_profile(tokens, index + 2, default_profile, ids, mins, maxs, id,
            number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1)), max_width), empty_sequence()), empty_sequence()),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "max_width",
        choose(require_kind(tokens, index + 1, "NUMBER", "RCL_UI_DEVICE_ADAPTATION_MAX_WIDTH"),
          choose(semantic_check(max_width < 0, "RCL_UI_DEVICE_ADAPTATION_MAX_WIDTH_DUPLICATE", id),
            parse_ui_adaptation_profile(tokens, index + 2, default_profile, ids, mins, maxs, id,
              min_width, number_from_text(sequence_get(sequence_get(tokens,  index + 1), 1))), empty_sequence()), empty_sequence()),
        choose(semantic_check(find_text(ids, 0, id) < 0, "RCL_UI_DEVICE_ADAPTATION_PROFILE_DUPLICATE", id),
          choose(semantic_check(choose(min_width < 0, 0, min_width) >= 0
                and (max_width < 0 or max_width >= choose(min_width < 0, 0, min_width)),
              "RCL_UI_DEVICE_ADAPTATION_WIDTH", id),
            choose(semantic_check(not ui_device_ranges_overlap(mins, maxs, 0,
                  choose(min_width < 0, 0, min_width), max_width),
                "RCL_UI_DEVICE_ADAPTATION_PROFILE_OVERLAP", id),
              parse_ui_adaptation_body(tokens, index, default_profile,
                sequence_append(ids, id), sequence_append(mins, choose(min_width < 0, 0, min_width)),
                sequence_append(maxs, max_width)), empty_sequence()), empty_sequence()), empty_sequence())))

  reckon make_ui_extensions(navigation : Sequence, adaptation : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), navigation), adaptation)
  reckon default_ui_extensions() -> Sequence = make_ui_extensions(empty_sequence(), empty_sequence())
  reckon ui_extensions_with_navigation(node : Sequence, navigation : Sequence) -> Sequence =
    make_ui_extensions(navigation, sequence_get(node, 1))
  reckon ui_extensions_with_adaptation(node : Sequence, adaptation : Sequence) -> Sequence =
    make_ui_extensions(sequence_get(node, 0), adaptation)

  reckon make_ui(name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, extensions : Sequence, views : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), states), derived), stages), restore), themes), styles), extensions), views)

  reckon ui_navigation(node : Sequence) -> Sequence = sequence_get(sequence_get(node, 7), 0)
  reckon ui_adaptation(node : Sequence) -> Sequence = sequence_get(sequence_get(node, 7), 1)
  reckon parse_ui_lifecycle_body(tokens : Sequence, index : Number, stages : Sequence, restore : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      make_node_state(index + 1, sequence_append(sequence_append(empty_sequence(), stages), restore)),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "restore",
        parse_ui_lifecycle_body(tokens, index + 2, stages, sequence_append(restore, sequence_get(sequence_get(tokens,  index + 1), 1))),
        parse_ui_lifecycle_body(tokens, index + 1, sequence_append(stages, sequence_get(sequence_get(tokens,  index), 1)), restore)))

  reckon parse_ui_body_after_state(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence, derived_state : Truth, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name,
      choose(derived_state, states, sequence_append(states, sequence_get(item_state, 1))),
      choose(derived_state, sequence_append(derived, sequence_get(item_state, 1)), derived), stages, restore, themes, styles, navigation, views)

  reckon parse_ui_body_after_theme(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name, states, derived, stages, restore,
      sequence_append(themes, sequence_get(item_state, 1)), styles, navigation, views)

  reckon parse_ui_body_after_style(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name, states, derived, stages, restore, themes,
      sequence_append(styles, sequence_get(item_state, 1)), navigation, views)

  reckon parse_ui_body_after_view(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name, states, derived, stages, restore, themes, styles, navigation,
      sequence_append(views, sequence_get(item_state, 1)))

  reckon parse_ui_body_after_structure(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence, navigation_state : Truth, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name, states, derived,
      choose(navigation_state, stages, sequence_get(sequence_get(item_state, 1), 0)),
      choose(navigation_state, restore, sequence_get(sequence_get(item_state, 1), 1)), themes, styles,
      choose(navigation_state, ui_extensions_with_navigation(navigation, sequence_get(item_state, 1)), navigation), views)

  reckon parse_ui_body_after_adaptation(tokens : Sequence, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, extensions : Sequence, views : Sequence, item_state : Sequence) -> Sequence =
    parse_ui_body(tokens, sequence_get(item_state, 0), name, states, derived, stages, restore, themes, styles,
      ui_extensions_with_adaptation(extensions, sequence_get(item_state, 1)), views)

  reckon parse_ui_body(tokens : Sequence, index : Number, name : Text, states : Sequence, derived : Sequence, stages : Sequence, restore : Sequence, themes : Sequence, styles : Sequence, navigation : Sequence, views : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
      choose(semantic_check(length(views) == 1, "RCL_UI_VIEW_TREE_COUNT", name),
        make_node_state(index + 1, make_ui(name, states, derived,
          choose(length(stages) == 0, sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), "create"), "activate"), "suspend"), "resume"), "destroy"), stages),
          restore, themes, styles, navigation, views)), empty_sequence()),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "state",
        parse_ui_body_after_state(tokens, name, states, derived, stages, restore, themes, styles, navigation, views, false,
          parse_ui_state(tokens, index)),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "derived",
          parse_ui_body_after_state(tokens, name, states, derived, stages, restore, themes, styles, navigation, views, true,
            parse_ui_state(tokens, index)),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "theme",
            parse_ui_body_after_theme(tokens, name, states, derived, stages, restore, themes, styles, navigation, views,
              parse_ui_theme(tokens, index)),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "style",
              parse_ui_body_after_style(tokens, name, states, derived, stages, restore, themes, styles, navigation, views,
                parse_ui_style(tokens, index, length(styles))),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "lifecycle",
                choose(require_token(tokens, index + 1, "{", "RCL_UI_LIFECYCLE_OPEN"),
                  parse_ui_body_after_structure(tokens, name, states, derived, stages, restore, themes, styles, navigation, views, false,
                    parse_ui_lifecycle_body(tokens, index + 2, empty_sequence(), empty_sequence())), empty_sequence()),
                choose(sequence_get(sequence_get(tokens,  index), 1) == "navigation",
                  choose(semantic_check(length(sequence_get(navigation, 0)) == 0, "RCL_UI_NAVIGATION_DUPLICATE", name),
                    choose(require_token(tokens, index + 1, "{", "RCL_UI_NAVIGATION_OPEN"),
                      parse_ui_body_after_structure(tokens, name, states, derived, stages, restore, themes, styles, navigation, views, true,
                        parse_ui_navigation_body(tokens, index + 2, "", empty_sequence(), empty_sequence())), empty_sequence()), empty_sequence()),
                  choose(sequence_get(sequence_get(tokens,  index), 1) == "adaptation",
                    choose(semantic_check(length(sequence_get(navigation, 1)) == 0, "RCL_UI_DEVICE_ADAPTATION_DUPLICATE", name),
                      choose(require_token(tokens, index + 1, "{", "RCL_UI_DEVICE_ADAPTATION_OPEN"),
                        parse_ui_body_after_adaptation(tokens, name, states, derived, stages, restore, themes, styles, navigation, views,
                          parse_ui_adaptation_body(tokens, index + 2, "", empty_sequence(), empty_sequence(), empty_sequence())),
                        empty_sequence()), empty_sequence()),
                    choose(sequence_get(sequence_get(tokens,  index), 1) == "view",
                      parse_ui_body_after_view(tokens, name, states, derived, stages, restore, themes, styles, navigation, views,
                        parse_ui_view(tokens, index)),
                      syntax_failure(tokens, index, "RCL_UI_DECLARATION"))))))))))

  reckon pui(tokens : Sequence, index : Number) -> Sequence =
    choose(require_kind(tokens, index + 1, "IDENT", "RCL_UI_NAME"),
      choose(require_token(tokens, index + 2, "{", "RCL_UI_OPEN"),
        parse_ui_body(tokens, index + 3, sequence_get(sequence_get(tokens,  index + 1), 1), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), default_ui_extensions(), empty_sequence()),
        empty_sequence()), empty_sequence())

  reckon make_extras() -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence()), empty_sequence())

  reckon replace_extra(items : Sequence, target : Number, value : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      replace_extra(items, target, value, index + 1,
        sequence_append(output, choose(index == target, value, sequence_get(items, index)))))

  reckon append_extra(items : Sequence, target : Number, value : Sequence) -> Sequence =
    replace_extra(items, target, sequence_append(sequence_get(items, target), value), 0, empty_sequence())

  reckon make_absorption(kind : Text, target : Text) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), kind), target)

  reckon make_program(name : Text, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), name), facets), reckons), subjects), warrants), rules), directives), extras)

  reckon program_hosts(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 0)
  reckon program_dialects(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 1)
  reckon program_effects(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 2)
  reckon program_policies(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 3)
  reckon program_stores(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 4)
  reckon program_absorption(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 5)
  reckon uis(program : Sequence) -> Sequence = sequence_get(sequence_get(program, 7), 6)

  reckon parse_top(tokens : Sequence, index : Number, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 0) == "EOF", syntax_failure(tokens, index, "RCL_REALITY_UNCLOSED"),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "}",
        make_node_state(index + 1, make_program(sequence_get(sequence_get(tokens,  1), 1), facets, reckons, subjects, warrants, rules, directives, extras)),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "facet" or sequence_get(sequence_get(tokens,  index), 1) == "input",
        parse_top_after_facet(tokens, parse_facet(tokens, index), facets, reckons, subjects, warrants, rules, directives, extras),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "reckon",
          parse_top_after_reckon(tokens, parse_reckon(tokens, index), facets, reckons, subjects, warrants, rules, directives, extras),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "subject",
            parse_top_after_subject(tokens, parse_subject(tokens, index), facets, reckons, subjects, warrants, rules, directives, extras),
            choose(either(sequence_get(sequence_get(tokens,  index), 1) == "emergence", sequence_get(sequence_get(tokens,  index), 1) == "resonance"),
              parse_top_after_rule(tokens, parse_rule(tokens, index), facets, reckons, subjects, warrants, rules, directives, extras),
              choose(either(sequence_get(sequence_get(tokens,  index), 1) == "foresee", sequence_get(sequence_get(tokens,  index), 1) == "realize"),
                parse_top(tokens, index + 2, facets, reckons, subjects, warrants, rules,
                  sequence_append(directives,
                    make_directive(choose(sequence_get(sequence_get(tokens,  index), 1) == "foresee", "Foresee", "Realize"), sequence_get(sequence_get(tokens,  index + 1), 1))), extras),
                parse_metadata_top(tokens, index, facets, reckons, subjects, warrants, rules, directives, extras))))))))

  reckon parse_top_after_facet(tokens : Sequence, item_state : Sequence, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    parse_top(tokens, sequence_get(item_state, 0), sequence_append(facets, sequence_get(item_state, 1)), reckons, subjects, warrants, rules, directives, extras)

  reckon parse_top_after_reckon(tokens : Sequence, item_state : Sequence, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    parse_top(tokens, sequence_get(item_state, 0), facets, sequence_append(reckons, sequence_get(item_state, 1)), subjects, warrants, rules, directives, extras)

  reckon parse_top_after_subject(tokens : Sequence, subject_state : Sequence, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    parse_top(tokens, sequence_get(subject_state, 0), append_all(sequence_get(subject_state, 2), facets), reckons,
      sequence_append(subjects, sequence_get(subject_state, 1)), append_all(sequence_get(subject_state, 3), warrants), rules, directives, extras)

  reckon parse_top_after_rule(tokens : Sequence, item_state : Sequence, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    parse_top(tokens, sequence_get(item_state, 0), facets, reckons, subjects, warrants,
      sequence_append(rules, sequence_get(item_state, 1)), directives, extras)

  reckon parse_top_after_extra(tokens : Sequence, item_state : Sequence, target : Number, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    parse_top(tokens, sequence_get(item_state, 0), facets, reckons, subjects, warrants, rules, directives,
      append_extra(extras, target, sequence_get(item_state, 1)))

  reckon parse_metadata_top(tokens : Sequence, index : Number, facets : Sequence, reckons : Sequence, subjects : Sequence, warrants : Sequence, rules : Sequence, directives : Sequence, extras : Sequence) -> Sequence =
    choose(sequence_get(sequence_get(tokens,  index), 1) == "host",
      parse_top_after_extra(tokens, parse_host(tokens, index), 0, facets, reckons, subjects, warrants, rules, directives, extras),
      choose(sequence_get(sequence_get(tokens,  index), 1) == "dialect",
        parse_top_after_extra(tokens, parse_dialect(tokens, index), 1, facets, reckons, subjects, warrants, rules, directives, extras),
        choose(sequence_get(sequence_get(tokens,  index), 1) == "effect",
          parse_top_after_extra(tokens, parse_effect(tokens, index), 2, facets, reckons, subjects, warrants, rules, directives, extras),
          choose(sequence_get(sequence_get(tokens,  index), 1) == "capability_policy",
            parse_top_after_extra(tokens, parse_policy(tokens, index), 3, facets, reckons, subjects, warrants, rules, directives, extras),
            choose(sequence_get(sequence_get(tokens,  index), 1) == "store",
              parse_top_after_extra(tokens, parse_store(tokens, index), 4, facets, reckons, subjects, warrants, rules, directives, extras),
              choose(sequence_get(sequence_get(tokens,  index), 1) == "ui",
                parse_top_after_extra(tokens, pui(tokens, index), 6, facets, reckons, subjects, warrants, rules, directives, extras),
                choose(either(sequence_get(sequence_get(tokens,  index), 1) == "verify", sequence_get(sequence_get(tokens,  index), 1) == "snapshot"),
                  parse_top(tokens, index + 2, facets, reckons, subjects, warrants, rules, directives,
                    append_extra(extras, 5,
                      make_absorption(choose(sequence_get(sequence_get(tokens,  index), 1) == "verify", "VerifyCapabilities", "SnapshotStore"),
                        sequence_get(sequence_get(tokens,  index + 1), 1)))),
                  syntax_failure(tokens, index, "RCL_UNKNOWN_TOP_LEVEL"))))))))

  reckon parse_program_after_top(tokens : Sequence, parse_state : Sequence) -> Sequence =
    choose(require_kind(tokens, sequence_get(parse_state, 0), "EOF", "RCL_TRAILING_CONTENT"),
      sequence_get(parse_state, 1), sequence_get(parse_state, 1))

  reckon parse_program_header(tokens : Sequence) -> Sequence =
    choose(require_token(tokens, 0, "reality", "RCL_REALITY_HEADER_REQUIRED"),
      choose(require_kind(tokens, 1, "IDENT", "RCL_REALITY_NAME_REQUIRED"),
        choose(require_token(tokens, 2, "{", "RCL_REALITY_OPEN_REQUIRED"),
          parse_program_after_top(tokens,
            parse_top(tokens, 3, empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), empty_sequence(), make_extras())),
          empty_sequence()), empty_sequence()), empty_sequence())

  reckon parse_program(tokens : Sequence) -> Sequence = parse_program_header(tokens)
  reckon quote_character() -> Text = char_at("\"x", 0)
  reckon slash_character() -> Text = char_at("\\x", 0)

  reckon json_escape_character(value : Text) -> Text =
    choose(contains("\"\\\n\r\t", value),
      choose(value == quote_character(), slash_character() + quote_character(),
        choose(value == slash_character(), slash_character() + slash_character(),
          choose(value == "\n", slash_character() + "n", choose(value == "\r", slash_character() + "r", slash_character() + "t")))), value)

  reckon json_escape_from(value : Text, index : Number, output : Text) -> Text =
    choose(index >= length(value), output,
      json_escape_from(value, index + 1, output + json_escape_character(char_at(value, index))))

  reckon json_quote(value : Text) -> Text =
    quote_character() + choose(contains(value, quote_character()) or contains(value, slash_character())
      or contains(value, "\n") or contains(value, "\r") or contains(value, "\t"),
      json_escape_from(value, 0, ""), value) + quote_character()

  reckon json_truth(value : Text) -> Text = choose(value == "true", "true", "false")

  reckon ui_literal_json(node : Sequence) -> Text =
    choose(sequence_get(node, 1) == "Text", json_quote(sequence_get(node, 2)),
      choose(sequence_get(node, 1) == "Truth", json_truth(sequence_get(node, 2)), sequence_get(node, 2)))

  reckon find_ui_state_type(items : Sequence, index : Number, name : Text) -> Text =
    choose(index >= length(items), "",
      choose(sequence_get(sequence_get(items, index), 0) == name, sequence_get(sequence_get(items, index), 1),
        find_ui_state_type(items, index + 1, name)))

  reckon ui_reference_type(name : Text, states : Sequence, derived : Sequence, parameters : Sequence) -> Text =
    choose(find_ui_state_type(states, 0, name) != "", find_ui_state_type(states, 0, name),
      choose(find_ui_state_type(derived, 0, name) != "", find_ui_state_type(derived, 0, name),
        choose(find_ui_parameter_type(parameters, 0, name) != "", find_ui_parameter_type(parameters, 0, name),
          choose(semantic_check(false, "RCL_UI_REFERENCE_UNKNOWN", name), "", ""))))

  reckon ui_reference_scope(name : Text, states : Sequence, derived : Sequence, parameters : Sequence) -> Text =
    choose(find_ui_state_type(states, 0, name) != "", "state",
      choose(find_ui_state_type(derived, 0, name) != "", "derived",
        choose(find_ui_parameter_type(parameters, 0, name) != "", "event",
          choose(semantic_check(false, "RCL_UI_REFERENCE_UNKNOWN", name), "", ""))))

  reckon ui_expression_type(node : Sequence, states : Sequence, derived : Sequence, parameters : Sequence) -> Text =
    choose(sequence_get(node, 0) == "LiteralExpr", sequence_get(node, 1),
      choose(sequence_get(node, 0) == "PathExpr", ui_reference_type(sequence_get(node, 1), states, derived, parameters),
        choose(sequence_get(node, 0) == "UnaryExpr", choose(sequence_get(node, 1) == not_operator(), "Truth", "Number"),
          choose(sequence_get(node, 0) == "BinaryExpr",
            choose(sequence_get(node, 1) == "+",
              choose(ui_expression_type(sequence_get(node, 2), states, derived, parameters) == "Text" or ui_expression_type(sequence_get(node, 3), states, derived, parameters) == "Text", "Text", "Number"),
              choose(sequence_get(node, 1) == minus_operator() or sequence_get(node, 1) == "*" or sequence_get(node, 1) == "/" or sequence_get(node, 1) == "%", "Number", "Truth")),
            choose(sequence_get(node, 1) == "choose", ui_expression_type(sequence_get(sequence_get(node, 2), 1), states, derived, parameters), "")))))

  reckon canonical_ui_expression_array(items : Sequence, index : Number, states : Sequence, derived : Sequence, parameters : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_expression_array(items, index + 1, states, derived, parameters,
        output + choose(index > 0, ",", "") + canonical_ui_expression(sequence_get(items, index), states, derived, parameters)))

  reckon canonical_ui_expression(node : Sequence, states : Sequence, derived : Sequence, parameters : Sequence) -> Text =
    choose(sequence_get(node, 0) == "LiteralExpr",
      "{\"kind\":\"literal\",\"value\":" + ui_literal_json(node) + ",\"valueType\":" + json_quote(sequence_get(node, 1)) + "}",
      choose(sequence_get(node, 0) == "PathExpr",
        "{\"id\":" + json_quote(sequence_get(node, 1)) + ",\"kind\":\"reference\",\"scope\":"
          + json_quote(ui_reference_scope(sequence_get(node, 1), states, derived, parameters)) + ",\"valueType\":"
          + json_quote(ui_reference_type(sequence_get(node, 1), states, derived, parameters)) + "}",
        choose(sequence_get(node, 0) == "UnaryExpr",
          "{\"expression\":" + canonical_ui_expression(sequence_get(node, 2), states, derived, parameters) + ",\"kind\":\"unary\",\"operator\":"
            + json_quote(sequence_get(node, 1)) + ",\"valueType\":" + json_quote(ui_expression_type(node, states, derived, parameters)) + "}",
          choose(sequence_get(node, 0) == "BinaryExpr",
            "{\"kind\":\"binary\",\"left\":" + canonical_ui_expression(sequence_get(node, 2), states, derived, parameters)
              + ",\"operator\":" + json_quote(sequence_get(node, 1)) + ",\"right\":"
              + canonical_ui_expression(sequence_get(node, 3), states, derived, parameters) + ",\"valueType\":"
              + json_quote(ui_expression_type(node, states, derived, parameters)) + "}",
            "{\"args\":" + canonical_ui_expression_array(sequence_get(node, 2), 0, states, derived, parameters, "[")
              + ",\"kind\":\"choose\",\"valueType\":" + json_quote(ui_expression_type(node, states, derived, parameters)) + "}"))))

  reckon canonical_ui_states(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_states(items, index + 1,
        output + choose(index > 0, ",", "") + "[\"UIState\"," + json_quote(sequence_get(sequence_get(items, index), 0))
          + "," + json_quote(sequence_get(sequence_get(items, index), 1)) + ","
          + ui_literal_json(sequence_get(sequence_get(items, index), 2)) + ",true]"))

  reckon canonical_ui_derived(items : Sequence, index : Number, states : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_derived(items, index + 1, states,
        output + choose(index > 0, ",", "") + "[\"UIDerivedState\"," + json_quote(sequence_get(sequence_get(items, index), 0))
          + "," + json_quote(sequence_get(sequence_get(items, index), 1)) + ","
          + canonical_ui_expression(sequence_get(sequence_get(items, index), 2), states, items, empty_sequence()) + "]"))

  reckon canonical_ui_texts(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_texts(items, index + 1,
        output + choose(index > 0, ",", "") + json_quote(sequence_get(items, index))))

  reckon canonical_ui_properties(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_properties(items, index + 1,
        output + choose(index > 0, ",", "") + "[" + json_quote(sequence_get(sequence_get(items, index), 0))
          + "," + ui_literal_json(sequence_get(sequence_get(items, index), 1)) + ","
          + json_quote(sequence_get(sequence_get(sequence_get(items, index), 1), 1)) + "]"))

  reckon canonical_ui_bindings(items : Sequence, index : Number, node_id : Text, states : Sequence, derived : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_bindings(items, index + 1, node_id, states, derived,
        output + choose(index > 0, ",", "") + "[" + json_quote(node_id + ".binding." + sequence_get(sequence_get(items, index), 0))
          + "," + json_quote(sequence_get(sequence_get(items, index), 0)) + ","
          + canonical_ui_expression(sequence_get(sequence_get(items, index), 1), states, derived, empty_sequence()) + "]"))

  reckon canonical_ui_event_parameters(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_event_parameters(items, index + 1,
        output + choose(index > 0, ",", "") + "{\"id\":" + json_quote(sequence_get(sequence_get(items, index), 0))
          + ",\"valueType\":" + json_quote(sequence_get(sequence_get(items, index), 1)) + "}"))

  reckon canonical_ui_event_statement(node : Sequence, states : Sequence, derived : Sequence, parameters : Sequence) -> Text =
    choose(sequence_get(node, 0) == "realize-reality",
      "{\"kind\":\"realize-reality\",\"rule\":" + json_quote(sequence_get(node, 1)) + "}",
      choose(sequence_get(node, 0) == "navigate",
        "{\"kind\":\"navigate\",\"route\":" + json_quote(sequence_get(node, 1)) + "}",
        choose(semantic_check(find_ui_state_type(states, 0, sequence_get(node, 1)) != "", "RCL_UI_EVENT_TARGET_UNKNOWN", sequence_get(node, 1)),
          choose(semantic_check(ui_expression_type(sequence_get(node, 2), states, derived, parameters)
              == find_ui_state_type(states, 0, sequence_get(node, 1)), "RCL_UI_EVENT_MUTATION_TYPE", sequence_get(node, 1)),
            "{\"expression\":" + canonical_ui_expression(sequence_get(node, 2), states, derived, parameters)
              + ",\"kind\":\"set-state\",\"target\":" + json_quote(sequence_get(node, 1)) + "}", ""), "")))

  reckon canonical_ui_event_statements(items : Sequence, index : Number, states : Sequence, derived : Sequence, parameters : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_event_statements(items, index + 1, states, derived, parameters,
        output + choose(index > 0, ",", "") + canonical_ui_event_statement(sequence_get(items, index), states, derived, parameters)))

  reckon canonical_ui_events(items : Sequence, index : Number, node_id : Text, states : Sequence, derived : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_events(items, index + 1, node_id, states, derived,
        output + choose(index > 0, ",", "") + "[" + json_quote(node_id + ".event." + sequence_get(sequence_get(items, index), 0) + "." + text(index))
          + "," + json_quote(sequence_get(sequence_get(items, index), 0)) + ","
          + canonical_ui_event_parameters(sequence_get(sequence_get(items, index), 1), 0, "[") + ","
          + json_quote(choose(ui_statements_have_kind(sequence_get(sequence_get(items, index), 2), 0, "realize-reality"),
            "reality-transaction", "ui-local")) + ","
          + canonical_ui_event_statements(sequence_get(sequence_get(items, index), 2), 0, states, derived,
            sequence_get(sequence_get(items, index), 1), "[") + "]"))

  reckon canonical_ui_size(mode : Text, value : Text) -> Text =
    "[" + json_quote(mode) + "," + choose(mode == "fixed", value, "null") + "]"

  reckon canonical_ui_layout(node : Sequence) -> Text =
    "[" + json_quote(sequence_get(node, 0)) + "," + canonical_ui_size(sequence_get(node, 1), sequence_get(node, 2))
      + "," + canonical_ui_size(sequence_get(node, 3), sequence_get(node, 4)) + "," + text(sequence_get(node, 5))
      + "," + text(sequence_get(node, 6)) + "," + json_quote(sequence_get(node, 7)) + ","
      + json_quote(sequence_get(node, 8)) + "," + json_quote(sequence_get(node, 9)) + "," + text(sequence_get(node, 10)) + "]"

  reckon find_ui_property(items : Sequence, index : Number, name : Text) -> Sequence =
    choose(index >= length(items), empty_sequence(),
      choose(sequence_get(sequence_get(items, index), 0) == name, sequence_get(items, index),
        find_ui_property(items, index + 1, name)))

  reckon ui_style_property(name : Text) -> Truth =
    name == "foreground" or name == "background" or name == "font_family" or name == "font_size"
      or name == "text_align" or name == "corner_radius" or name == "language"

  reckon ui_inherited_property(name : Text) -> Truth =
    name == "foreground" or name == "font_family" or name == "font_size" or name == "text_align" or name == "language"

  reckon ui_style_specificity(kind : Text) -> Number = choose(kind == "role", 1, choose(kind == "class", 10, 100))

  reckon ui_style_matches(style : Sequence, node : Sequence) -> Truth =
    choose(sequence_get(style, 1) == "role", sequence_get(style, 2) == sequence_get(node, 1),
      choose(sequence_get(style, 1) == "class", find_text(sequence_get(node, 2), 0, sequence_get(style, 2)) >= 0,
        sequence_get(style, 2) == sequence_get(node, 0)))

  reckon make_resolved_property(found : Truth, value : Text, provenance : Text, score : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), found), value), provenance), score)

  reckon resolve_ui_rules(styles : Sequence, index : Number, node : Sequence, property : Text, best : Sequence) -> Sequence =
    choose(index >= length(styles), best,
      resolve_ui_rules(styles, index + 1, node, property,
        choose(ui_style_matches(sequence_get(styles, index), node)
            and length(find_ui_property(sequence_get(sequence_get(styles, index), 4), 0, property)) > 0
            and (sequence_get(sequence_get(styles, index), 3) * 10000
              + ui_style_specificity(sequence_get(sequence_get(styles, index), 1)) * 100
              + sequence_get(sequence_get(styles, index), 5)) >= sequence_get(best, 3),
          make_resolved_property(true,
            ui_literal_json(sequence_get(find_ui_property(sequence_get(sequence_get(styles, index), 4), 0, property), 1)),
            "rule:" + sequence_get(sequence_get(styles, index), 0),
            sequence_get(sequence_get(styles, index), 3) * 10000
              + ui_style_specificity(sequence_get(sequence_get(styles, index), 1)) * 100
              + sequence_get(sequence_get(styles, index), 5)), best)))

  reckon resolve_ui_property_after_rule(node : Sequence, themes : Sequence, property : Text, rule : Sequence) -> Sequence =
    choose(sequence_get(rule, 0), rule,
      choose(length(themes) > 0 and length(find_ui_property(sequence_get(sequence_get(themes, 0), 1), 0, property)) > 0,
        make_resolved_property(true,
          ui_literal_json(sequence_get(find_ui_property(sequence_get(sequence_get(themes, 0), 1), 0, property), 1)),
          "theme:" + sequence_get(sequence_get(themes, 0), 0), 0),
        make_resolved_property(false, "", "", -1)))

  reckon resolve_ui_property(node : Sequence, themes : Sequence, styles : Sequence, property : Text) -> Sequence =
    choose(length(find_ui_property(sequence_get(node, 3), 0, property)) > 0 and ui_style_property(property),
      make_resolved_property(true,
        ui_literal_json(sequence_get(find_ui_property(sequence_get(node, 3), 0, property), 1)),
        "node:" + sequence_get(node, 0), 1000000000),
      resolve_ui_property_after_rule(node, themes, property,
        resolve_ui_rules(styles, 0, node, property, make_resolved_property(false, "", "", -1))))

  reckon ui_style_property_names() -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), "background"), "corner_radius"), "font_family"), "font_size"), "foreground"), "language"), "text_align")

  reckon canonical_resolved_object(names : Sequence, index : Number, node : Sequence, themes : Sequence, styles : Sequence, provenance : Truth, output : Text) -> Text =
    choose(index >= length(names), output + "}",
      canonical_resolved_object(names, index + 1, node, themes, styles, provenance,
        choose(sequence_get(resolve_ui_property(node, themes, styles, sequence_get(names, index)), 0),
          output + choose(output == "{", "", ",") + json_quote(sequence_get(names, index)) + ":"
            + choose(provenance,
              json_quote(sequence_get(resolve_ui_property(node, themes, styles, sequence_get(names, index)), 2)),
              sequence_get(resolve_ui_property(node, themes, styles, sequence_get(names, index)), 1)), output)))

  reckon canonical_ui_resolved_style(node : Sequence, themes : Sequence, styles : Sequence) -> Text =
    "[" + canonical_resolved_object(ui_style_property_names(), 0, node, themes, styles, false, "{")
      + "," + canonical_resolved_object(ui_style_property_names(), 0, node, themes, styles, true, "{") + "]"

  reckon canonical_ui_nodes(items : Sequence, index : Number, states : Sequence, derived : Sequence, themes : Sequence, styles : Sequence, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_nodes(items, index + 1, states, derived, themes, styles,
        output + choose(index > 0, ",", "") + canonical_ui_node(sequence_get(items, index), states, derived, themes, styles)))

  reckon canonical_ui_adaptive_layouts(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_adaptive_layouts(items, index + 1,
        output + choose(index > 0, ",", "") + "[" + json_quote(sequence_get(sequence_get(items, index), 0))
          + "," + json_quote(sequence_get(sequence_get(items, index), 1)) + "]"))

  reckon canonical_ui_node(node : Sequence, states : Sequence, derived : Sequence, themes : Sequence, styles : Sequence) -> Text =
    "[" + json_quote(sequence_get(node, 0)) + "," + json_quote(sequence_get(node, 1)) + ","
      + canonical_ui_texts(sequence_get(node, 2), 0, "[") + ","
      + canonical_ui_properties(sequence_get(node, 3), 0, "[") + ","
      + canonical_ui_bindings(sequence_get(node, 4), 0, sequence_get(node, 0), states, derived, "[") + ","
      + canonical_ui_events(sequence_get(node, 5), 0, sequence_get(node, 0), states, derived, "[") + ","
      + canonical_ui_layout(ui_view_layout(node)) + "," + canonical_ui_adaptive_layouts(ui_view_adaptive_layouts(node), 0, "[")
      + "," + canonical_ui_resolved_style(node, themes, styles) + ","
      + canonical_ui_nodes(sequence_get(node, 7), 0, states, derived, themes, styles, "[") + "]"

  reckon canonical_ui_theme_declarations(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_theme_declarations(items, index + 1,
        output + choose(index > 0, ",", "") + "[" + json_quote(sequence_get(sequence_get(items, index), 0)) + ","
          + ui_literal_json(sequence_get(sequence_get(items, index), 1)) + ","
          + json_truth(text(sequence_get(sequence_get(items, index), 2) or ui_inherited_property(sequence_get(sequence_get(items, index), 0)))) + "]"))

  reckon canonical_ui_themes(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_themes(items, index + 1,
        output + choose(index > 0, ",", "") + "[" + json_quote(sequence_get(sequence_get(items, index), 0)) + ","
          + canonical_ui_theme_declarations(sequence_get(sequence_get(items, index), 1), 0, "[") + "]"))

  reckon canonical_ui_styles(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_ui_styles(items, index + 1,
        output + choose(index > 0, ",", "") + "[" + json_quote(sequence_get(sequence_get(items, index), 0)) + ",["
          + json_quote(sequence_get(sequence_get(items, index), 1)) + "," + json_quote(sequence_get(sequence_get(items, index), 2)) + "],"
          + text(sequence_get(sequence_get(items, index), 3)) + "," + text(ui_style_specificity(sequence_get(sequence_get(items, index), 1)))
          + "," + text(sequence_get(sequence_get(items, index), 5)) + ","
          + canonical_ui_theme_declarations(sequence_get(sequence_get(items, index), 4), 0, "[") + "]"))

  reckon canonical_ui_style_sheet(themes : Sequence, styles : Sequence) -> Text =
    "[" + choose(length(themes) > 0, json_quote(sequence_get(sequence_get(themes, 0), 0)), "null") + ","
      + canonical_ui_themes(themes, 0, "[") + "," + canonical_ui_styles(styles, 0, "[") + "]"

  reckon canonical_ui_routes(ids : Sequence, targets : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(ids), output + "]",
      canonical_ui_routes(ids, targets, index + 1,
        output + choose(index > 0, ",", "") + "{\"id\":" + json_quote(sequence_get(ids, index))
          + ",\"target\":" + json_quote(sequence_get(targets, index)) + "}"))

  reckon canonical_ui_device_profiles(ids : Sequence, mins : Sequence, maxs : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(ids), output + "]",
      canonical_ui_device_profiles(ids, mins, maxs, index + 1,
        output + choose(index > 0, ",", "") + "{\"id\":" + json_quote(sequence_get(ids, index))
          + ",\"maxWidth\":" + choose(sequence_get(maxs, index) < 0, "null", text(sequence_get(maxs, index)))
          + ",\"minWidth\":" + text(sequence_get(mins, index)) + "}"))

  reckon canonical_ui_adaptation(node : Sequence) -> Text =
    choose(length(node) == 0, "null",
      "{\"axis\":\"available-width\",\"defaultProfile\":" + json_quote(sequence_get(node, 0))
        + ",\"format\":\"rcl.native-ui.device-adaptation.v0.1\",\"profiles\":"
        + canonical_ui_device_profiles(sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 3), 0, "[")
        + ",\"unit\":\"dp\"}")

  reckon cui(node : Sequence, reality : Text) -> Text =
    "[\"rcl.native-ui.semantic-genome.v0.1\",\"rcl.native-ui.program.v0.1\",\"0.1.0\",\"UIProgram\"," + json_quote(sequence_get(node, 0))
      + "," + json_quote(reality) + "," + canonical_ui_states(sequence_get(node, 1), 0, "[") + ","
      + canonical_ui_derived(sequence_get(node, 2), 0, sequence_get(node, 1), "[") + ","
      + canonical_ui_node(sequence_get(sequence_get(node, 8), 0), sequence_get(node, 1), sequence_get(node, 2), sequence_get(node, 5), sequence_get(node, 6)) + ","
      + canonical_ui_style_sheet(sequence_get(node, 5), sequence_get(node, 6)) + ",["
      + canonical_ui_texts(sequence_get(node, 3), 0, "[") + "," + canonical_ui_texts(sequence_get(node, 4), 0, "[")
      + "],[" + choose(length(ui_navigation(node)) == 0, "null",
        "{\"format\":\"rcl.native-ui.navigation.v0.1\",\"initialRoute\":"
          + json_quote(sequence_get(ui_navigation(node), 0)) + ",\"routes\":"
          + canonical_ui_routes(sequence_get(ui_navigation(node), 1), sequence_get(ui_navigation(node), 2), 0, "[") + "}")
      + ",[]," + canonical_ui_adaptation(ui_adaptation(node)) + "]]"

  reckon cuis(items : Sequence, index : Number, reality : Text, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      cuis(items, index + 1, reality,
        output + choose(index > 0, ",", "") + "{\"id\":" + json_quote(sequence_get(sequence_get(items, index), 0))
          + ",\"semanticRoot\":" + json_quote(sha256_text(cui(sequence_get(items, index), reality))) + "}"))

  reckon canonical_expression(node : Sequence) -> Text =
    choose(sequence_get(node, 0) == "LiteralExpr",
      "{\"kind\":\"LiteralExpr\",\"value\":"
        + choose(sequence_get(node, 1) == "Text", json_quote(sequence_get(node, 2)),
            choose(sequence_get(node, 1) == "Truth", json_truth(sequence_get(node, 2)), sequence_get(node, 2)))
        + ",\"valueType\":" + json_quote(sequence_get(node, 1)) + "}",
      choose(sequence_get(node, 0) == "PathExpr",
        "{\"kind\":\"PathExpr\",\"path\":" + json_quote(sequence_get(node, 1)) + "}",
        choose(sequence_get(node, 0) == "UnaryExpr",
          "{\"expression\":" + canonical_expression(sequence_get(node, 2)) + ",\"kind\":\"UnaryExpr\",\"operator\":" + json_quote(sequence_get(node, 1)) + "}",
          choose(sequence_get(node, 0) == "BinaryExpr",
            "{\"kind\":\"BinaryExpr\",\"left\":" + canonical_expression(sequence_get(node, 2))
              + ",\"operator\":" + json_quote(sequence_get(node, 1)) + ",\"right\":" + canonical_expression(sequence_get(node, 3)) + "}",
            "{\"args\":" + canonical_expression_array(sequence_get(node, 2), 0, "[")
              + ",\"kind\":\"CallExpr\",\"name\":" + json_quote(sequence_get(node, 1)) + "}"))))

  reckon canonical_expression_array(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_expression_array(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_expression(sequence_get(items, index))))

  reckon canonical_params(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_params(items, index + 1,
        output + choose(index == 0, "", ",")
          + "{\"name\":" + json_quote(sequence_get(sequence_get(items, index), 0))
          + ",\"valueType\":" + json_quote(sequence_get(sequence_get(items, index), 1)) + "}"))

  reckon canonical_facet(node : Sequence) -> Text =
    "{" + choose(facet_input(node), "\"input\":true,", "") + "\"kind\":\"FacetDecl\",\"location\":{\"column\":" + text(sequence_get(node, 5))
      + ",\"line\":" + text(sequence_get(node, 4)) + "},\"owner\":"
      + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3)))
      + ",\"path\":" + json_quote(sequence_get(node, 0)) + ",\"value\":" + canonical_expression(sequence_get(node, 2))
      + ",\"valueType\":" + json_quote(sequence_get(node, 1)) + "}"

  reckon canonical_facets(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_facets(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_facet(sequence_get(items, index))))

  reckon canonical_reckon(node : Sequence) -> Text =
    "{\"expression\":" + canonical_expression(sequence_get(node, 3)) + ",\"kind\":\"ReckonDecl\",\"name\":"
      + json_quote(sequence_get(node, 0)) + ",\"params\":" + canonical_params(sequence_get(node, 1), 0, "[")
      + ",\"returnType\":" + json_quote(sequence_get(node, 2)) + "}"

  reckon canonical_reckons(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_reckons(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_reckon(sequence_get(items, index))))

  reckon canonical_text_array(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_text_array(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(items, index))))

  reckon canonical_warrant(node : Sequence) -> Text =
    "{\"capability\":" + json_quote(sequence_get(node, 1))
      + ",\"condition\":" + choose(warrant_conditional(node), canonical_expression(sequence_get(node, 3)), "null") + ",\"kind\":\"WarrantDecl\",\"subject\":" + json_quote(sequence_get(node, 0))
      + ",\"target\":" + json_quote(sequence_get(node, 2)) + "}"

  reckon canonical_warrants(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_warrants(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_warrant(sequence_get(items, index))))

  reckon canonical_needs(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_needs(items, index + 1,
        output + choose(index == 0, "", ",") + "{\"capability\":"
          + json_quote(sequence_get(sequence_get(items, index), 0)) + ",\"target\":"
          + json_quote(sequence_get(sequence_get(items, index), 1)) + "}"))

  reckon canonical_alter(node : Sequence) -> Text =
    "{\"expression\":" + canonical_expression(sequence_get(node, 1))
      + ",\"target\":" + json_quote(sequence_get(node, 0)) + "}"

  reckon canonical_alters(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_alters(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_alter(sequence_get(items, index))))

  reckon canonical_rule(node : Sequence) -> Text =
    "{\"alters\":" + canonical_alters(sequence_get(node, 8), 0, "[")
      + ",\"calls\":[],\"cause\":" + choose(sequence_get(node, 2) == "", "null", json_quote(sequence_get(node, 2)))
      + ",\"from\":" + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3)))
      + ",\"into\":" + choose(sequence_get(node, 4) == "", "null", json_quote(sequence_get(node, 4)))
      + ",\"kind\":" + json_quote(sequence_get(node, 0)) + ",\"name\":" + json_quote(sequence_get(node, 1))
      + ",\"needs\":" + canonical_needs(sequence_get(node, 6), 0, "[")
      + ",\"preserves\":" + canonical_expression_array(sequence_get(node, 7), 0, "[")
      + ",\"when\":" + choose(length(sequence_get(node, 5)) == 0, "null", canonical_expression(sequence_get(node, 5)))
      + ",\"witnesses\":" + canonical_text_array(sequence_get(node, 9), 0, "[") + "}"

  reckon canonical_rules(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_rules(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_rule(sequence_get(items, index))))

  reckon canonical_directive(node : Sequence) -> Text =
    "{\"kind\":" + json_quote(sequence_get(node, 0)) + ",\"rule\":" + json_quote(sequence_get(node, 1)) + "}"

  reckon canonical_directives(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_directives(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_directive(sequence_get(items, index))))

  reckon canonical_offers(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_offers(items, index + 1,
        output + choose(index == 0, "", ",") + "{\"capability\":"
          + json_quote(sequence_get(sequence_get(items, index), 0)) + ",\"returnType\":"
          + json_quote(sequence_get(sequence_get(items, index), 1)) + "}"))

  reckon canonical_host(node : Sequence) -> Text =
    "{\"kind\":\"HostDecl\",\"name\":" + json_quote(sequence_get(node, 0))
      + ",\"offers\":" + canonical_offers(sequence_get(node, 1), 0, "[") + "}"

  reckon canonical_hosts(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_hosts(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_host(sequence_get(items, index))))

  reckon canonical_dialect_operation(node : Sequence) -> Text =
    "{\"effects\":" + canonical_text_array(sequence_get(node, 3), 0, "[")
      + ",\"inputs\":" + canonical_text_array(sequence_get(node, 1), 0, "[")
      + ",\"lowersTo\":" + canonical_text_array(sequence_get(node, 4), 0, "[")
      + ",\"name\":" + json_quote(sequence_get(node, 0))
      + ",\"outputs\":" + canonical_text_array(sequence_get(node, 2), 0, "[") + "}"

  reckon canonical_dialect_operations(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_dialect_operations(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_dialect_operation(sequence_get(items, index))))

  reckon canonical_dialect(node : Sequence) -> Text =
    "{\"description\":" + json_quote(sequence_get(node, 4))
      + ",\"domain\":" + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3)))
      + ",\"id\":" + json_quote(sequence_get(node, 0))
      + ",\"invariants\":" + canonical_text_array(sequence_get(node, 7), 0, "[")
      + ",\"kind\":\"DialectDecl\",\"layer\":" + json_quote(sequence_get(node, 2))
      + ",\"lowersTo\":" + canonical_text_array(sequence_get(node, 6), 0, "[")
      + ",\"operations\":" + canonical_dialect_operations(sequence_get(node, 5), 0, "[")
      + ",\"version\":" + json_quote(sequence_get(node, 1)) + "}"

  reckon canonical_dialects(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_dialects(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_dialect(sequence_get(items, index))))

  reckon canonical_effect(node : Sequence) -> Text =
    "{\"description\":" + json_quote(sequence_get(node, 4))
      + ",\"deterministic\":" + json_truth(sequence_get(node, 1))
      + ",\"evidenceRequired\":" + json_truth(sequence_get(node, 3))
      + ",\"kind\":\"EffectDecl\",\"lowersTo\":" + canonical_text_array(sequence_get(node, 5), 0, "[")
      + ",\"name\":" + json_quote(sequence_get(node, 0)) + ",\"replay\":" + json_quote(sequence_get(node, 2)) + "}"

  reckon canonical_effects(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_effects(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_effect(sequence_get(items, index))))

  reckon canonical_capabilities(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_capabilities(items, index + 1,
        output + choose(index == 0, "", ",") + "{\"capability\":"
          + json_quote(sequence_get(sequence_get(items, index), 0)) + ",\"target\":"
          + json_quote(sequence_get(sequence_get(items, index), 1)) + "}"))

  reckon append_budget_tail(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      append_budget_tail(items, index + 1, sequence_append(output, sequence_get(items, index))))

  reckon insert_budget_sorted(items : Sequence, node : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), sequence_append(output, node),
      choose(text_less(sequence_get(node, 0), sequence_get(sequence_get(items, index), 0), 0),
        append_budget_tail(items, index, sequence_append(output, node)),
        insert_budget_sorted(items, node, index + 1, sequence_append(output, sequence_get(items, index)))))

  reckon sort_budget(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      sort_budget(items, index + 1, insert_budget_sorted(output, sequence_get(items, index), 0, empty_sequence())))

  reckon canonical_budget_items(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "}",
      canonical_budget_items(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(sequence_get(items, index), 0))
          + ":" + sequence_get(sequence_get(items, index), 1)))

  reckon canonical_policy(node : Sequence) -> Text =
    "{\"allowedEffects\":" + canonical_text_array(sequence_get(node, 1), 0, "[")
      + ",\"budget\":" + canonical_budget_items(sort_budget(sequence_get(node, 5), 0, empty_sequence()), 0, "{")
      + ",\"capabilities\":" + canonical_capabilities(sequence_get(node, 3), 0, "[")
      + ",\"deniedEffects\":" + canonical_text_array(sequence_get(node, 2), 0, "[")
      + ",\"hostCapabilities\":" + canonical_text_array(sequence_get(node, 4), 0, "[")
      + ",\"kind\":\"CapabilityPolicyDecl\",\"name\":" + json_quote(sequence_get(node, 0))
      + ",\"requireDeterministicReplay\":" + json_truth(sequence_get(node, 6)) + "}"

  reckon canonical_policies(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_policies(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_policy(sequence_get(items, index))))

  reckon canonical_store(node : Sequence) -> Text =
    "{\"branches\":" + canonical_text_array(sequence_get(node, 1), 0, "[")
      + ",\"commits\":" + canonical_text_array(sequence_get(node, 2), 0, "[")
      + ",\"kind\":\"StoreDecl\",\"name\":" + json_quote(sequence_get(node, 0)) + "}"

  reckon canonical_stores(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_stores(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_store(sequence_get(items, index))))

  reckon canonical_absorption(node : Sequence) -> Text =
    choose(sequence_get(node, 0) == "VerifyCapabilities",
      "{\"kind\":\"VerifyCapabilities\",\"policy\":" + json_quote(sequence_get(node, 1)) + "}",
      "{\"kind\":\"SnapshotStore\",\"store\":" + json_quote(sequence_get(node, 1)) + "}")

  reckon canonical_absorptions(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "]",
      canonical_absorptions(items, index + 1,
        output + choose(index == 0, "", ",") + canonical_absorption(sequence_get(items, index))))

  reckon append_sorted_tail(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      append_sorted_tail(items, index + 1, sequence_append(output, sequence_get(items, index))))

  reckon text_rank(character : Text, index : Number) -> Number =
    choose(index >= length(".0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"), index,
      choose(char_at(".0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz", index) == character,
        index, text_rank(character, index + 1)))

  reckon text_less(left : Text, right : Text, index : Number) -> Truth =
    choose(index >= length(left), index < length(right),
      choose(index >= length(right), false,
        choose(char_at(left, index) == char_at(right, index), text_less(left, right, index + 1),
          text_rank(char_at(left, index), 0) < text_rank(char_at(right, index), 0))))

  reckon insert_facet_sorted(items : Sequence, node : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), sequence_append(output, node),
      choose(text_less(sequence_get(node, 0), sequence_get(sequence_get(items, index), 0), 0),
        append_sorted_tail(items, index, sequence_append(output, node)),
        insert_facet_sorted(items, node, index + 1, sequence_append(output, sequence_get(items, index)))))

  reckon sort_facets(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      sort_facets(items, index + 1, insert_facet_sorted(output, sequence_get(items, index), 0, empty_sequence())))

  reckon canonical_facet_types(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "}",
      canonical_facet_types(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(sequence_get(items, index), 0))
          + ":" + json_quote(sequence_get(sequence_get(items, index), 1))))

  reckon canonical_source_map_facet(node : Sequence) -> Text =
    "{\"declaredType\":" + json_quote(sequence_get(node, 1)) + ",\"kind\":\"FacetDecl\",\"location\":{\"column\":"
      + text(sequence_get(node, 5)) + ",\"line\":" + text(sequence_get(node, 4)) + "},\"owner\":"
      + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3))) + ",\"path\":" + json_quote(sequence_get(node, 0)) + "}"

  reckon canonical_source_map_facets(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "}",
      canonical_source_map_facets(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(sequence_get(items, index), 0))
          + ":" + canonical_source_map_facet(sequence_get(items, index))))

  reckon canonical_type_binding(node : Sequence) -> Text =
    "{\"canonicalType\":" + json_quote(sequence_get(node, 1)) + ",\"declaredType\":" + json_quote(sequence_get(node, 1))
      + ",\"external\":false,\"location\":{\"column\":" + text(sequence_get(node, 5)) + ",\"line\":" + text(sequence_get(node, 4))
      + "},\"owner\":" + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3)))
      + ",\"path\":" + json_quote(sequence_get(node, 0)) + "}"

  reckon canonical_type_bindings_facets(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "}",
      canonical_type_bindings_facets(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(sequence_get(items, index), 0))
          + ":" + canonical_type_binding(sequence_get(items, index))))

  reckon canonical_semantic_facet(node : Sequence) -> Text =
    "{\"canonicalType\":" + json_quote(sequence_get(node, 1)) + ",\"constructor\":null,\"declaredType\":"
      + json_quote(sequence_get(node, 1)) + ",\"deferred\":false,\"externalType\":false,\"fieldAccesses\":[],\"location\":{\"column\":"
      + text(sequence_get(node, 5)) + ",\"line\":" + text(sequence_get(node, 4)) + "},\"matches\":[],\"owner\":"
      + choose(sequence_get(node, 3) == "", "null", json_quote(sequence_get(node, 3))) + ",\"path\":" + json_quote(sequence_get(node, 0)) + "}"

  reckon canonical_semantic_facets(items : Sequence, index : Number, output : Text) -> Text =
    choose(index >= length(items), output + "}",
      canonical_semantic_facets(items, index + 1,
        output + choose(index == 0, "", ",") + json_quote(sequence_get(sequence_get(items, index), 0))
          + ":" + canonical_semantic_facet(sequence_get(items, index))))

  reckon canonical_semantic_map(program : Sequence, sorted_facets : Sequence) -> Text =
    "{\"constructorCount\":0,\"facetCount\":" + text(length(sequence_get(program, 1)))
      + ",\"facets\":" + canonical_semantic_facets(sorted_facets, 0, "{")
      + ",\"fieldAccessCount\":0,\"format\":\"rcl.typed-compiler.semantic-map.v0.34\",\"matchCount\":0,\"reality\":"
      + json_quote(sequence_get(program, 0)) + ",\"typedFacetCount\":0,\"version\":\"0.34.0-alpha.1\"}"

  reckon canonical_source_map(sorted_facets : Sequence) -> Text =
    "{\"facets\":" + canonical_source_map_facets(sorted_facets, 0, "{") + ",\"format\":\"rcl.source-map.v0.30\"}"

  reckon canonical_type_bindings(sorted_facets : Sequence) -> Text =
    "{\"facets\":" + canonical_type_bindings_facets(sorted_facets, 0, "{") + ",\"format\":\"rcl.type-bindings.v0.30\"}"

  reckon foundation_canonical() -> Text = "{\"compositePlanes\":[{\"composedFrom\":[\"perceptual\",\"knowledge\",\"authority\"],\"id\":\"natural-language-reality\",\"primitives\":[\"language\",\"utterance\",\"intent\",\"interpret\"],\"role\":\"turns human symbols into explicit utterances, candidate meanings and bounded intents without making a language model the whole intelligence\"},{\"composedFrom\":[\"knowledge\",\"quantitative\",\"perceptual\",\"natural-language-reality\"],\"id\":\"understanding-reality\",\"primitives\":[\"understanding\",\"hypothesis\",\"explanation\",\"understand\"],\"role\":\"constructs testable world models that explain evidence, expose confidence and can be rejected by contradiction\"},{\"composedFrom\":[\"understanding-reality\",\"knowledge\",\"meta-computational\",\"authority\"],\"id\":\"creative-reality\",\"primitives\":[\"creation\",\"candidate\",\"select\",\"create\"],\"role\":\"generates bounded novelty, evaluates candidates by utility, feasibility, novelty and risk, then selects without automatically executing\"},{\"composedFrom\":[\"perceptual\",\"neural\",\"living\",\"knowledge\",\"natural-language-reality\",\"understanding-reality\",\"creative-reality\"],\"id\":\"inner-reality\",\"role\":\"the subject-relative model that contains percepts, needs, memories, claims, interpretations, explanations and candidate creations\"},{\"composedFrom\":[\"computational\",\"physical\",\"authority\",\"causality-evidence\"],\"id\":\"execution-reality\",\"role\":\"the bounded transition plane that turns a justified and selected intention into an observed, authorized and evidenced change\"}],\"crossDomainAxes\":[{\"id\":\"authority\",\"primitives\":[\"warrant\",\"needs\",\"preserve\"],\"role\":\"opens bounded powers while constraining which changes can become authoritative reality\"},{\"id\":\"causality-evidence\",\"primitives\":[\"cause\",\"when\",\"witness\",\"evidence\"],\"role\":\"connects change and knowledge to causes, conditions, provenance and reproducible evidence\"}],\"domains\":[{\"id\":\"meta-computational\",\"keyword\":\"meta\",\"question\":\"How can computation inspect, validate and transform computation itself?\"},{\"id\":\"computational\",\"keyword\":\"reckon/host\",\"question\":\"How are symbolic and machine states computed and executed?\"},{\"id\":\"physical\",\"keyword\":\"physical\",\"question\":\"How do matter, energy, fields, space and time evolve?\"},{\"id\":\"energy\",\"keyword\":\"energy\",\"question\":\"How is capacity to cause change stored, transferred, transformed, dissipated and bounded?\"},{\"id\":\"elemental\",\"keyword\":\"element\",\"question\":\"What primitive constituents, properties, bonds and compositions make a reality object what it is?\"},{\"id\":\"perceptual\",\"keyword\":\"perception\",\"question\":\"How does a world become observable and experienced by an observer?\"},{\"id\":\"neural\",\"keyword\":\"neural\",\"question\":\"How do signals become memory, attention, learning, decisions and control?\"},{\"id\":\"embodied\",\"keyword\":\"embodiment\",\"question\":\"How are systems, organs, boundaries and sensorimotor channels integrated into one body?\"},{\"id\":\"living\",\"keyword\":\"living\",\"question\":\"How does a living system maintain continuity, needs and autonomous action?\"},{\"id\":\"genetic\",\"keyword\":\"genetic\",\"question\":\"How are structures encoded, expressed, inherited and changed across generations?\"},{\"id\":\"quantitative\",\"keyword\":\"quantitative\",\"question\":\"What can be measured, on what scale, with what uncertainty, confidence and evidence?\"},{\"id\":\"knowledge\",\"keyword\":\"knowledge\",\"question\":\"How do observations and prior structures become justified, revisable and actionable knowledge?\"},{\"id\":\"science\",\"keyword\":\"science\",\"question\":\"How are hypotheses made falsifiable, tested, replicated, revised and accepted with explicit method and evidence?\"},{\"id\":\"spirit\",\"keyword\":\"spirit\",\"question\":\"How are identity, meaning, values, purposes, affect and will integrated as a subject-relative mental reality?\"}],\"format\":\"rcl.reality-foundation.v0.6\",\"metaRealityPlanes\":[{\"id\":\"meta-spacetime-reality\",\"operatesOn\":[\"all reality domains\",\"all transitions\",\"all observations\"],\"primitives\":[\"spacetime\",\"frame\",\"clock\",\"coordinate\",\"relation\",\"synchronize\"],\"role\":\"locates every state, event and observer in a reference frame and logical/physical time while preserving causal order and synchronization boundaries\"},{\"id\":\"meta-acceleration-reality\",\"operatesOn\":[\"computation\",\"simulation\",\"learning\",\"execution\"],\"primitives\":[\"acceleration\",\"target\",\"strategy\",\"factor\",\"budget\",\"fidelity\",\"accelerate\"],\"role\":\"changes the speed, scheduling and reuse strategy of reality computation while preserving declared fidelity, authority and causal invariants\"},{\"id\":\"meta-compression-reality\",\"operatesOn\":[\"state\",\"history\",\"knowledge\",\"world models\",\"evidence\"],\"primitives\":[\"compression\",\"target\",\"mode\",\"codec\",\"reversible\",\"fidelity\",\"compress\",\"restore\"],\"role\":\"reduces representational cost while preserving a declared reconstruction contract, provenance and reality root\"}]}"

  reckon canonical_program_with(program : Sequence, sorted_facets : Sequence) -> Text =
    "{\"absorptionDirectives\":" + canonical_absorptions(program_absorption(program), 0, "[")
      + ",\"accelerations\":[],\"capabilityPolicies\":" + canonical_policies(program_policies(program), 0, "[")
      + ",\"compressions\":[],\"creations\":[],\"dialects\":" + canonical_dialects(program_dialects(program), 0, "[")
      + ",\"directives\":"
      + canonical_directives(sequence_get(program, 6), 0, "[")
      + ",\"effectDeclarations\":" + canonical_effects(program_effects(program), 0, "[")
      + ",\"elements\":[],\"embodiments\":[],\"energies\":[],\"facetTypes\":"
      + canonical_facet_types(sorted_facets, 0, "{") + ",\"facets\":" + canonical_facets(sequence_get(program, 1), 0, "[")
      + ",\"format\":\"rcl.reality-program.v0.10\",\"foundation\":" + foundation_canonical()
      + ",\"genetics\":[],\"hosts\":" + canonical_hosts(program_hosts(program), 0, "[")
      + ",\"knowledges\":[],\"languageVersion\":\"0.14.0-alpha.1\",\"livings\":[],\"metaDomains\":[],\"name\":"
      + json_quote(sequence_get(program, 0))
      + choose(length(uis(program)) > 0,
        ",\"nativeUis\":" + cuis(uis(program), 0, sequence_get(program, 0), "["), "")
      + ",\"naturalLanguages\":[],\"neurals\":[],\"perceptions\":[],\"physicals\":[],\"quantitatives\":[],\"reckons\":"
      + canonical_reckons(sequence_get(program, 2), 0, "[")
      + ",\"rules\":" + canonical_rules(sequence_get(program, 5), 0, "[")
      + ",\"sciences\":[],\"semanticMap\":" + canonical_semantic_map(program, sorted_facets)
      + ",\"sourceMap\":" + canonical_source_map(sorted_facets)
      + ",\"spacetimes\":[],\"spirits\":[],\"stores\":" + canonical_stores(program_stores(program), 0, "[")
      + ",\"subjects\":" + canonical_text_array(sequence_get(program, 3), 0, "[")
      + ",\"typeBindings\":" + canonical_type_bindings(sorted_facets)
      + ",\"typeModules\":null,\"understandings\":[],\"warrants\":" + canonical_warrants(sequence_get(program, 4), 0, "[") + "}"

  reckon canonical_program(program : Sequence) -> Text =
    canonical_program_with(program, sort_facets(sequence_get(program, 1), 0, empty_sequence()))

  reckon semantic_check(condition : Truth, code : Text, detail : Text) -> Truth =
    semantic_assert(condition, code, code + ":" + detail, make_span(0, 1, 1, 0))

  reckon find_facet_index(items : Sequence, index : Number, path : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 0) == path, index, find_facet_index(items, index + 1, path)))

  reckon validate_expression_array(items : Sequence, index : Number, locals : Sequence, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(validate_expression(sequence_get(items, index), locals, facets, reckons),
        validate_expression_array(items, index + 1, locals, facets, reckons), false))

  reckon validate_user_call(node : Sequence, locals : Sequence, facets : Sequence, reckons : Sequence, reckon_index : Number) -> Truth =
    choose(semantic_check(reckon_index >= 0, "RCL_SEMANTIC_UNKNOWN_CALL", sequence_get(node, 1)),
      choose(semantic_check(length(sequence_get(node, 2)) == length(sequence_get(sequence_get(reckons, reckon_index), 1)),
          "RCL_SEMANTIC_CALL_ARITY", sequence_get(node, 1)),
        validate_expression_array(sequence_get(node, 2), 0, locals, facets, reckons), false), false)

  reckon validate_expression(node : Sequence, locals : Sequence, facets : Sequence, reckons : Sequence) -> Truth =
    choose(sequence_get(node, 0) == "LiteralExpr", true,
      choose(sequence_get(node, 0) == "PathExpr",
        semantic_check(find_text(locals, 0, sequence_get(node, 1)) >= 0 or find_facet_index(facets, 0, sequence_get(node, 1)) >= 0,
          "RCL_SEMANTIC_UNKNOWN_PATH", sequence_get(node, 1)),
        choose(sequence_get(node, 0) == "UnaryExpr", validate_expression(sequence_get(node, 2), locals, facets, reckons),
          choose(sequence_get(node, 0) == "BinaryExpr",
            choose(validate_expression(sequence_get(node, 2), locals, facets, reckons),
              validate_expression(sequence_get(node, 3), locals, facets, reckons), false),
            choose(builtin_id(sequence_get(node, 1)) > 0,
              validate_expression_array(sequence_get(node, 2), 0, locals, facets, reckons),
              choose(sequence_get(node, 1) == "provider_call" or sequence_get(node, 1) == "choose",
                choose(semantic_check(length(sequence_get(node, 2)) == 3, "RCL_SEMANTIC_CALL_ARITY", sequence_get(node, 1)),
                  validate_expression_array(sequence_get(node, 2), 0, locals, facets, reckons), false),
                choose(sequence_get(node, 1) == "typed_ref" or sequence_get(node, 1) == "typed_deref" or sequence_get(node, 1) == "typed_ref_id",
                  choose(semantic_check(length(sequence_get(node, 2)) == 1, "RCL_SEMANTIC_CALL_ARITY", sequence_get(node, 1)),
                    validate_expression_array(sequence_get(node, 2), 0, locals, facets, reckons), false),
                  validate_user_call(node, locals, facets, reckons,
                    indexed_validation_find(sequence_get(node, 1))))))))))

  reckon predicate_accepts(expected : Text, actual : Text) -> Truth =
    actual == "Unknown" or expected == "Any" or expected == actual
      or (expected == "TextOrSequence" and (actual == "Text" or actual == "Sequence"))

  reckon predicate_checked_type(actual : Text, expected : Text, code : Text, detail : Text) -> Text =
    choose(semantic_check(predicate_accepts(expected, actual), code, detail + ":" + expected + ":" + actual), actual, actual)

  reckon predicate_local_index(items : Sequence, index : Number, name : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 0) == name, index, predicate_local_index(items, index + 1, name)))

  reckon predicate_path_type(name : Text, locals : Sequence, facets : Sequence, local_index : Number) -> Text =
    choose(local_index >= 0, sequence_get(sequence_get(locals, local_index), 1),
      sequence_get(sequence_get(facets, find_facet_index(facets, 0, name)), 1))

  reckon predicate_builtin_signature(id : Number) -> Text =
    choose(id >= 1 and id <= 3, "Text,Text:Truth",
      choose(id == 4, "TextOrSequence:Number",
      choose(id == 5 or id == 6 or id == 8 or id == 70, "Text:Text",
      choose(id == 7, "Any:Text",
      choose(id == 9 or id == 10, "Text,Text:Text",
      choose(id == 11, "Text:Number",
      choose(id == 12, ":Sequence",
      choose(id == 13, "Sequence,Any:Sequence",
      choose(id == 14, "Sequence,Number:Unknown",
      choose(id == 15, "Text,Number:Text",
      choose(id == 16, "Text,Number,Number:Text",
      choose(id >= 17 and id <= 20, "Text:Truth",
      choose(id == 21, "Number,Number,Number,Number:Span",
      choose(id == 22, "Text,Text,Span:Token",
      choose(id == 23 or id == 24, "Token:Text",
      choose(id == 25, "Token:Span",
      choose(id >= 26 and id <= 29, "Span:Number",
      choose(id == 30, "Text,Text,Text,Text,Span:AstNode",
      choose(id >= 31 and id <= 35, "AstNode:Text",
      choose(id == 36, "AstNode:Span",
      choose(id == 37, "Number,Sequence:ParseState",
      choose(id == 38, "ParseState:Number",
      choose(id == 39, "ParseState:Sequence",
      choose(id == 40, "Token,Text,Text:Truth",
      choose(id == 41, "Text,Text,Number,Span:Symbol",
      choose(id == 42 or id == 43, "Symbol:Text",
      choose(id == 44, "Symbol:Number",
      choose(id == 45, "Symbol:Span",
      choose(id == 46, "Truth,Text,Text,Span:Truth",
      choose(id == 47, "Text,Text,Text,Text,Number,Span:SemanticNode",
      choose(id >= 48 and id <= 51, "SemanticNode:Text",
      choose(id == 52, "SemanticNode:Number",
      choose(id == 53, "SemanticNode:Span",
      choose(id == 54, "Text,Text,Text,Text,Text,Number,Span:IrNode",
      choose(id >= 55 and id <= 59, "IrNode:Text",
      choose(id == 60, "IrNode:Number",
      choose(id == 61, "IrNode:Span",
      choose(id == 62, "Sequence,Sequence:Sequence",
      choose(id >= 63 and id <= 67, "Number:Sequence",
      choose(id == 68 or id == 69, "Text:Sequence",
      "Unknown:Unknown"))))))))))))))))))))))))))))))))))))))))

  reckon predicate_argument_types(items : Sequence, index : Number, locals : Sequence, facets : Sequence, reckons : Sequence, visited : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      predicate_argument_types(items, index + 1, locals, facets, reckons, visited,
        sequence_append(output, predicate_expression_type(sequence_get(items, index), locals, facets, reckons, visited))))

  reckon predicate_builtin_arguments(types : Sequence, index : Number, signature : Text, name : Text) -> Truth =
    choose(index >= length(types), semantic_check(signature == "", "RCL_CALL_ARITY", name),
      choose(semantic_check(signature != "", "RCL_CALL_ARITY", name),
        choose(semantic_check(predicate_accepts(split_before(signature, ","), sequence_get(types, index)), "RCL_CALL_TYPE", name + ":" + text(index)),
          predicate_builtin_arguments(types, index + 1, choose(contains(signature, ","), split_after(signature, ","), ""), name), false), false))

  reckon predicate_builtin_type(types : Sequence, signature : Text, name : Text) -> Text =
    choose(predicate_builtin_arguments(types, 0, split_before(signature, ":"), name), split_after(signature, ":"), "Unknown")

  reckon predicate_choose_type(condition : Text, yes : Text, no : Text) -> Text =
    choose(semantic_check(predicate_accepts("Truth", condition), "RCL_TYPE_CHOOSE", "condition"),
      choose(semantic_check(yes == no or yes == "Unknown" or no == "Unknown", "RCL_TYPE_CHOOSE", "branches"),
        choose(yes == "Unknown", no, yes), "Unknown"), "Unknown")

  reckon predicate_special_call_type(name : Text, types : Sequence) -> Text =
    choose(name == "choose",
      choose(semantic_check(length(types) == 3, "RCL_CALL_ARITY", name),
        predicate_choose_type(sequence_get(types, 0), sequence_get(types, 1), sequence_get(types, 2)), "Unknown"),
      predicate_builtin_type(types,
        choose(name == "provider_call", "Text,Text,Text:Text",
          choose(name == "typed_ref", "Any:TypedRef", choose(name == "typed_deref", "TypedRef:Unknown", "TypedRef:Number"))), name))

  reckon predicate_user_arguments(types : Sequence, params : Sequence, index : Number, name : Text) -> Truth =
    choose(index >= length(types), semantic_check(index == length(params), "RCL_SEMANTIC_CALL_ARITY", name),
      choose(semantic_check(index < length(params), "RCL_SEMANTIC_CALL_ARITY", name),
        choose(semantic_check(predicate_accepts(sequence_get(sequence_get(params, index), 1), sequence_get(types, index)),
            "RCL_CALL_TYPE", name + ":" + text(index)),
          predicate_user_arguments(types, params, index + 1, name), false), false))

  reckon predicate_function_result(actual : Text, node : Sequence) -> Text =
    choose(semantic_check(predicate_accepts(sequence_get(node, 2), actual), "RCL_RECKON_RETURN_TYPE", sequence_get(node, 0)),
      sequence_get(node, 2), "Unknown")

  reckon predicate_function_type(node : Sequence, facets : Sequence, reckons : Sequence, visited : Sequence) -> Text =
    choose(find_text(visited, 0, sequence_get(node, 0)) >= 0, sequence_get(node, 2),
      predicate_function_result(predicate_expression_type(sequence_get(node, 3), sequence_get(node, 1), facets, reckons, sequence_append(visited, sequence_get(node, 0))), node))

  reckon predicate_user_type(types : Sequence, node : Sequence, facets : Sequence, reckons : Sequence, visited : Sequence) -> Text =
    choose(predicate_user_arguments(types, sequence_get(node, 1), 0, sequence_get(node, 0)),
      predicate_function_type(node, facets, reckons, visited), "Unknown")

  reckon predicate_call_type(name : Text, types : Sequence, facets : Sequence, reckons : Sequence, visited : Sequence) -> Text =
    choose(builtin_id(name) > 0, predicate_builtin_type(types, predicate_builtin_signature(builtin_id(name)), name),
      choose(name == "choose" or name == "provider_call" or name == "typed_ref" or name == "typed_deref" or name == "typed_ref_id",
        predicate_special_call_type(name, types),
        predicate_user_type(types, sequence_get(reckons, indexed_validation_find(name)), facets, reckons, visited)))

  reckon predicate_unary_type(operator : Text, actual : Text) -> Text =
    choose(operator == not_operator(),
      choose(semantic_check(predicate_accepts("Truth", actual), "RCL_TYPE_UNARY", operator), "Truth", "Unknown"),
      predicate_checked_type(actual, "Number", "RCL_TYPE_UNARY", operator))

  reckon predicate_binary_type(operator : Text, left : Text, right : Text) -> Text =
    choose(operator == "and" or operator == "or",
      choose(semantic_check(predicate_accepts("Truth", left) and predicate_accepts("Truth", right), "RCL_TYPE_LOGIC", operator), "Truth", "Unknown"),
      choose(left == "Unknown" or right == "Unknown",
        choose(operator == "==" or operator == "!=" or operator == "<" or operator == "<=" or operator == ">" or operator == ">=", "Truth", "Unknown"),
        choose(operator == "==" or operator == "!=",
          choose(semantic_check(left == right, "RCL_TYPE_BINARY", operator), "Truth", "Unknown"),
          choose(operator == "<" or operator == "<=" or operator == ">" or operator == ">=",
            choose(semantic_check(left == "Number" and right == "Number", "RCL_TYPE_BINARY", operator), "Truth", "Unknown"),
            choose(operator == "+" and left == "Text" and right == "Text", "Text",
              choose(semantic_check(left == "Number" and right == "Number", "RCL_TYPE_BINARY", operator), "Number", "Unknown"))))))

  reckon predicate_expression_type(node : Sequence, locals : Sequence, facets : Sequence, reckons : Sequence, visited : Sequence) -> Text =
    choose(sequence_get(node, 0) == "LiteralExpr", sequence_get(node, 1),
      choose(sequence_get(node, 0) == "PathExpr", predicate_path_type(sequence_get(node, 1), locals, facets, predicate_local_index(locals, 0, sequence_get(node, 1))),
        choose(sequence_get(node, 0) == "UnaryExpr", predicate_unary_type(sequence_get(node, 1), predicate_expression_type(sequence_get(node, 2), locals, facets, reckons, visited)),
          choose(sequence_get(node, 0) == "BinaryExpr",
            predicate_binary_type(sequence_get(node, 1), predicate_expression_type(sequence_get(node, 2), locals, facets, reckons, visited), predicate_expression_type(sequence_get(node, 3), locals, facets, reckons, visited)),
            predicate_call_type(sequence_get(node, 1), predicate_argument_types(sequence_get(node, 2), 0, locals, facets, reckons, visited, empty_sequence()), facets, reckons, visited)))))

  reckon validate_warrant_condition(node : Sequence, facets : Sequence, reckons : Sequence) -> Truth =
    choose(validate_expression(sequence_get(node, 3), empty_sequence(), facets, reckons),
      semantic_check(predicate_accepts("Truth", predicate_expression_type(sequence_get(node, 3), empty_sequence(), facets, reckons, empty_sequence())),
        "RCL_WARRANT_CONDITION_TYPE", sequence_get(node, 0) + ":" + sequence_get(node, 1)), false)

  reckon validate_warrants(items : Sequence, index : Number, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(warrant_conditional(sequence_get(items, index)),
        choose(validate_warrant_condition(sequence_get(items, index), facets, reckons), validate_warrants(items, index + 1, facets, reckons), false),
        validate_warrants(items, index + 1, facets, reckons)))

  reckon validate_facets(items : Sequence, index : Number, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(semantic_check(sequence_get(sequence_get(sequence_get(items, index), 2), 0) != "LiteralExpr"
            or sequence_get(sequence_get(items, index), 1) == sequence_get(sequence_get(sequence_get(items, index), 2), 1),
          "RCL_SEMANTIC_TYPE_MISMATCH", sequence_get(sequence_get(items, index), 0)),
        choose(validate_expression(sequence_get(sequence_get(items, index), 2), empty_sequence(), facets, reckons),
          validate_facets(items, index + 1, facets, reckons), false), false))

  reckon validate_reckons(items : Sequence, index : Number, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(validate_expression(sequence_get(sequence_get(items, index), 3),
          param_names(sequence_get(sequence_get(items, index), 1), 0, empty_sequence()), facets, reckons),
        validate_reckons(items, index + 1, facets, reckons), false))

  reckon validate_alters(items : Sequence, index : Number, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(semantic_check(find_facet_index(facets, 0, sequence_get(sequence_get(items, index), 0)) >= 0,
          "RCL_SEMANTIC_UNKNOWN_ALTER_TARGET", sequence_get(sequence_get(items, index), 0)),
        choose(validate_expression(sequence_get(sequence_get(items, index), 1), empty_sequence(), facets, reckons),
          validate_alters(items, index + 1, facets, reckons), false), false))

  reckon validate_rules(items : Sequence, index : Number, facets : Sequence, reckons : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(validate_expression(sequence_get(sequence_get(items, index), 5), empty_sequence(), facets, reckons),
        choose(validate_alters(sequence_get(sequence_get(items, index), 8), 0, facets, reckons),
          choose(validate_expression_array(sequence_get(sequence_get(items, index), 7), 0, empty_sequence(), facets, reckons),
            validate_rules(items, index + 1, facets, reckons), false), false), false))

  reckon find_ui_rule_index(items : Sequence, index : Number, name : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 1) == name, index, find_ui_rule_index(items, index + 1, name)))

  reckon validate_ui_event_statements(items : Sequence, index : Number, node_id : Text, event_type : Text, rules : Sequence, navigation : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(sequence_get(sequence_get(items, index), 0) == "realize-reality",
        choose(semantic_check(find_ui_rule_index(rules, 0, sequence_get(sequence_get(items, index), 1)) >= 0,
            "RCL_UI_REALITY_RULE_UNKNOWN", node_id + ":" + sequence_get(sequence_get(items, index), 1)),
          validate_ui_event_statements(items, index + 1, node_id, event_type, rules, navigation), false),
        choose(sequence_get(sequence_get(items, index), 0) == "navigate",
          choose(semantic_check(length(navigation) > 0, "RCL_UI_NAVIGATION_REQUIRED", node_id + ":" + event_type),
            choose(semantic_check(find_text(sequence_get(navigation, 1), 0,
                  sequence_get(sequence_get(items, index), 1)) >= 0,
                "RCL_UI_NAVIGATION_ROUTE_UNKNOWN", node_id + ":" + event_type + ":" + sequence_get(sequence_get(items, index), 1)),
              validate_ui_event_statements(items, index + 1, node_id, event_type, rules, navigation), false), false),
          validate_ui_event_statements(items, index + 1, node_id, event_type, rules, navigation))))

  reckon validate_ui_events(items : Sequence, index : Number, node_id : Text, rules : Sequence, navigation : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(validate_ui_event_statements(sequence_get(sequence_get(items, index), 2), 0, node_id,
          sequence_get(sequence_get(items, index), 0), rules, navigation),
        validate_ui_events(items, index + 1, node_id, rules, navigation), false))

  reckon validate_ui_adaptive_layouts(items : Sequence, index : Number, node_id : Text, adaptation : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(semantic_check(length(adaptation) > 0, "RCL_UI_DEVICE_ADAPTATION_REQUIRED", node_id),
        choose(semantic_check(find_text(sequence_get(adaptation, 1), 0,
              sequence_get(sequence_get(items, index), 0)) >= 0,
            "RCL_UI_DEVICE_ADAPTATION_PROFILE_UNKNOWN", node_id + ":" + sequence_get(sequence_get(items, index), 0)),
          validate_ui_adaptive_layouts(items, index + 1, node_id, adaptation), false), false))

  reckon validate_ui_node(node : Sequence, rules : Sequence, navigation : Sequence, adaptation : Sequence) -> Truth =
    choose(validate_ui_events(sequence_get(node, 5), 0, sequence_get(node, 0), rules, navigation),
      choose(validate_ui_adaptive_layouts(ui_view_adaptive_layouts(node), 0, sequence_get(node, 0), adaptation),
        validate_ui_nodes(sequence_get(node, 7), 0, rules, navigation, adaptation), false), false)

  reckon validate_ui_nodes(items : Sequence, index : Number, rules : Sequence, navigation : Sequence, adaptation : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(validate_ui_node(sequence_get(items, index), rules, navigation, adaptation),
        validate_ui_nodes(items, index + 1, rules, navigation, adaptation), false))

  reckon find_ui_direct_child(items : Sequence, index : Number, id : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 0) == id, index, find_ui_direct_child(items, index + 1, id)))

  reckon validate_ui_route_targets(ids : Sequence, targets : Sequence, index : Number, root : Sequence) -> Truth =
    choose(index >= length(ids), true,
      choose(semantic_check(find_ui_direct_child(sequence_get(root, 7), 0,
            sequence_get(targets, index)) >= 0,
          "RCL_UI_NAVIGATION_TARGET_UNKNOWN", sequence_get(ids, index) + ":" + sequence_get(targets, index)),
        validate_ui_route_targets(ids, targets, index + 1, root), false))

  reckon validate_uis(items : Sequence, index : Number, rules : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(length(ui_navigation(sequence_get(items, index))) == 0,
        choose(validate_ui_nodes(sequence_get(sequence_get(items, index), 8), 0, rules, ui_navigation(sequence_get(items, index)), ui_adaptation(sequence_get(items, index))),
          validate_uis(items, index + 1, rules), false),
        choose(semantic_check(find_text(sequence_get(ui_navigation(sequence_get(items, index)), 1), 0,
              sequence_get(ui_navigation(sequence_get(items, index)), 0)) >= 0,
            "RCL_UI_NAVIGATION_INITIAL_UNKNOWN", sequence_get(ui_navigation(sequence_get(items, index)), 0)),
          choose(validate_ui_route_targets(sequence_get(ui_navigation(sequence_get(items, index)), 1),
              sequence_get(ui_navigation(sequence_get(items, index)), 2), 0, sequence_get(sequence_get(sequence_get(items, index), 8), 0)),
            choose(validate_ui_nodes(sequence_get(sequence_get(items, index), 8), 0, rules, ui_navigation(sequence_get(items, index)), ui_adaptation(sequence_get(items, index))),
              validate_uis(items, index + 1, rules), false), false), false)))

  reckon validate_program(program : Sequence) -> Truth =
    choose(validate_facets(sequence_get(program, 1), 0, sequence_get(program, 1), sequence_get(program, 2)),
      choose(validate_reckons(sequence_get(program, 2), 0, sequence_get(program, 1), sequence_get(program, 2)),
        choose(validate_warrants(sequence_get(program, 4), 0, sequence_get(program, 1), sequence_get(program, 2)),
          choose(validate_rules(sequence_get(program, 5), 0, sequence_get(program, 1), sequence_get(program, 2)),
            validate_uis(uis(program), 0, sequence_get(program, 5)), false), false), false), false)

  reckon validated_program(program : Sequence) -> Sequence =
    choose(validate_program(program), program, program)

  reckon param_names(params : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(params), output,
      param_names(params, index + 1, sequence_append(output, sequence_get(sequence_get(params, index), 0))))

  reckon collect_expression_numbers(node : Sequence, locals : Sequence, output : Sequence) -> Sequence =
    choose(sequence_get(node, 0) == "LiteralExpr",
      choose(sequence_get(node, 1) == "Number", append_unique_number(output, number_from_text(sequence_get(node, 2))), output),
      choose(sequence_get(node, 0) == "PathExpr", output,
        choose(sequence_get(node, 0) == "UnaryExpr", collect_expression_numbers(sequence_get(node, 2), locals, output),
          choose(sequence_get(node, 0) == "BinaryExpr",
            collect_expression_numbers(sequence_get(node, 3), locals,
              collect_expression_numbers(sequence_get(node, 2), locals, output)),
            collect_expression_numbers_array(sequence_get(node, 2), 0, locals, output)))))

  reckon collect_expression_numbers_array(items : Sequence, index : Number, locals : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_expression_numbers_array(items, index + 1, locals,
        collect_expression_numbers(sequence_get(items, index), locals, output)))

  reckon collect_facet_numbers(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_facet_numbers(items, index + 1,
        collect_expression_numbers(sequence_get(sequence_get(items, index), 2), empty_sequence(), output)))

  reckon find_rule(items : Sequence, index : Number, name : Text) -> Sequence =
    choose(sequence_get(sequence_get(items, index), 1) == name, sequence_get(items, index),
      find_rule(items, index + 1, name))

  reckon rule_actor(node : Sequence) -> Text =
    choose(sequence_get(node, 0) == "Emergence", sequence_get(node, 2), sequence_get(node, 3))

  reckon collect_alter_numbers(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_alter_numbers(items, index + 1,
        collect_expression_numbers(sequence_get(sequence_get(items, index), 1), empty_sequence(), output)))

  reckon collect_rule_numbers(node : Sequence, output : Sequence) -> Sequence =
    collect_expression_numbers_array(sequence_get(node, 7), 0, empty_sequence(),
      collect_alter_numbers(sequence_get(node, 8), 0,
        collect_expression_numbers(sequence_get(node, 5), empty_sequence(), output)))

  reckon collect_directive_numbers(items : Sequence, index : Number, rules : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_directive_numbers(items, index + 1, rules,
        collect_rule_numbers(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)), output)))

  reckon collect_reckon_numbers(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_reckon_numbers(items, index + 1,
        collect_expression_numbers(sequence_get(sequence_get(items, index), 3),
          param_names(sequence_get(sequence_get(items, index), 1), 0, empty_sequence()), output)))

  reckon build_number_pool(program : Sequence) -> Sequence =
    collect_reckon_numbers(sequence_get(program, 2), 0,
      choose(has_conditional_warrants(sequence_get(program, 4), 0),
        collect_dynamic_directive_numbers(sequence_get(program, 6), 0, sequence_get(program, 5), sequence_get(program, 4), collect_facet_numbers(sequence_get(program, 1), 0, empty_sequence())),
        collect_directive_numbers(sequence_get(program, 6), 0, sequence_get(program, 5), collect_facet_numbers(sequence_get(program, 1), 0, empty_sequence()))))

  reckon has_conditional_warrants(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), false,
      choose(warrant_conditional(sequence_get(items, index)), true, has_conditional_warrants(items, index + 1)))

  reckon collect_dynamic_warrant_numbers(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_dynamic_warrant_numbers(items, index + 1,
        choose(warrant_conditional(sequence_get(items, index)), collect_expression_numbers(sequence_get(sequence_get(items, index), 3), empty_sequence(), output), output)))

  reckon collect_dynamic_directive_numbers(items : Sequence, index : Number, rules : Sequence, warrants : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      collect_dynamic_directive_numbers(items, index + 1, rules, warrants,
        collect_rule_numbers(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)), collect_dynamic_warrant_numbers(warrants, 0, output))))

  reckon indexed_builtin_length(name : Text, size : Number) -> Number =
    choose(size < 12, choose(size < 8, choose(size < 6, choose(size < 5, choose(name == "text", 7, choose(name == "trim", 8, 0)), choose(name == "ir_op", 55, 0)), choose(size < 7, choose(name == "length", 4, 0), choose(name == "char_at", 15, choose(name == "ir_path", 56, choose(name == "ir_type", 57, choose(name == "ir_slot", 60, choose(name == "ir_span", 61, 0))))))), choose(size < 10, choose(size < 9, choose(name == "contains", 1, choose(name == "is_digit", 18, choose(name == "ast_kind", 31, choose(name == "ast_path", 32, choose(name == "ast_span", 36, choose(name == "bytes_u8", 63, 0)))))), choose(name == "ends_with", 3, choose(name == "make_span", 21, choose(name == "span_line", 27, choose(name == "facet_ast", 30, choose(name == "hex_bytes", 69, 0)))))), choose(size < 11, choose(name == "lower_text", 5, choose(name == "upper_text", 6, choose(name == "slice_text", 16, choose(name == "make_token", 22, choose(name == "token_kind", 23, choose(name == "token_text", 24, choose(name == "token_span", 25, choose(name == "utf8_bytes", 68, 0)))))))), choose(name == "starts_with", 2, choose(name == "split_after", 10, choose(name == "span_offset", 26, choose(name == "span_column", 28, choose(name == "span_length", 29, choose(name == "parse_index", 38, choose(name == "parse_nodes", 39, choose(name == "make_symbol", 41, choose(name == "symbol_path", 42, choose(name == "symbol_type", 43, choose(name == "symbol_slot", 44, choose(name == "symbol_span", 45, choose(name == "bytes_u16le", 64, choose(name == "bytes_u32le", 65, choose(name == "bytes_i32le", 66, choose(name == "bytes_f64le", 67, choose(name == "sha256_text", 70, 0)))))))))))))))))))), choose(size < 16, choose(size < 14, choose(size < 13, choose(name == "split_before", 9, choose(name == "sequence_get", 14, choose(name == "expect_token", 40, 0))), choose(name == "is_whitespace", 17, choose(name == "semantic_path", 48, choose(name == "semantic_type", 49, choose(name == "semantic_slot", 52, choose(name == "semantic_span", 53, choose(name == "make_ir_store", 54, 0))))))), choose(size < 15, choose(name == "empty_sequence", 12, choose(name == "ast_value_type", 33, 0)), choose(name == "sequence_append", 13, choose(name == "semantic_assert", 46, choose(name == "ir_literal_kind", 58, choose(name == "ir_literal_text", 59, choose(name == "sequence_concat", 62, 0))))))), choose(size < 19, choose(size < 18, choose(name == "number_from_text", 11, choose(name == "ast_literal_kind", 34, choose(name == "ast_literal_text", 35, choose(name == "make_parse_state", 37, 0)))), choose(name == "is_identifier_part", 20, 0)), choose(size < 21, choose(name == "is_identifier_start", 19, choose(name == "make_semantic_facet", 47, 0)), choose(name == "semantic_literal_kind", 50, choose(name == "semantic_literal_text", 51, 0))))))

  reckon builtin_id(name : Text) -> Number = indexed_builtin_length(name, length(name))

  reckon expression_count_array(items : Sequence, index : Number, output : Number) -> Number =
    choose(index >= length(items), output,
      expression_count_array(items, index + 1, output + expression_count(sequence_get(items, index))))

  reckon indexed_expression_count_uncached(node : Sequence) -> Number =
    choose(sequence_get(node, 0) == "LiteralExpr" or sequence_get(node, 0) == "PathExpr", 1,
      choose(sequence_get(node, 0) == "UnaryExpr", expression_count(sequence_get(node, 2)) + 1,
        choose(sequence_get(node, 0) == "BinaryExpr",
          choose(sequence_get(node, 1) == "and" or sequence_get(node, 1) == "or",
            expression_count(sequence_get(node, 2)) + expression_count(sequence_get(node, 3)) + 5,
            expression_count(sequence_get(node, 2)) + expression_count(sequence_get(node, 3)) + 1),
          choose(sequence_get(node, 1) == "choose",
            expression_count(sequence_get(sequence_get(node, 2), 0)) + expression_count(sequence_get(sequence_get(node, 2), 1))
              + expression_count(sequence_get(sequence_get(node, 2), 2)) + 2,
            choose(sequence_get(node, 1) == "provider_call",
              choose(provider_literal_arguments(node), 1, expression_count_array(sequence_get(node, 2), 0, 0) + 1),
              expression_count_array(sequence_get(node, 2), 0, 0) + 1)))))

  reckon indexed_expression_count_cached(node : Sequence) -> Number = sequence_get(node, length(node) - 1)
  reckon indexed_expression_count_dispatch(node : Sequence, count : Number) -> Number =
    choose(count < 0, indexed_expression_count_uncached(node), count)
  reckon expression_count(node : Sequence) -> Number =
    indexed_expression_count_dispatch(node, indexed_expression_count_cached(node))
  reckon indexed_count_sum(items : Sequence, index : Number, count : Number) -> Number =
    choose(count < 0, -1, choose(index >= length(items), count,
      indexed_count_sum_next(items, index, count, indexed_expression_count_cached(sequence_get(items, index)))))
  reckon indexed_count_sum_next(items : Sequence, index : Number, count : Number, next : Number) -> Number =
    choose(next < 0, -1, indexed_count_sum(items, index + 1, count + next))
  reckon indexed_count_add(count : Number, extra : Number) -> Number = choose(count < 0, -1, count + extra)
  reckon indexed_count_binary(left : Number, right : Number, extra : Number) -> Number =
    choose(left < 0 or right < 0, -1, left + right + extra)
  reckon indexed_call_count(node : Sequence) -> Number =
    choose(sequence_get(node, 1) == "choose",
      choose(length(sequence_get(node, 2)) != 3, -1, indexed_count_add(indexed_count_sum(sequence_get(node, 2), 0, 0), 2)),
      choose(sequence_get(node, 1) == "provider_call" and provider_literal_arguments(node), 1,
        indexed_count_add(indexed_count_sum(sequence_get(node, 2), 0, 0), 1)))
  reckon indexed_count_safe(node : Sequence) -> Number =
    choose(sequence_get(node, 0) == "LiteralExpr" or sequence_get(node, 0) == "PathExpr", 1,
      choose(sequence_get(node, 0) == "UnaryExpr", indexed_count_add(indexed_expression_count_cached(sequence_get(node, 2)), 1),
        choose(sequence_get(node, 0) == "BinaryExpr",
          indexed_count_binary(indexed_expression_count_cached(sequence_get(node, 2)), indexed_expression_count_cached(sequence_get(node, 3)),
            choose(sequence_get(node, 1) == "and" or sequence_get(node, 1) == "or", 5, 1)), indexed_call_count(node))))
  reckon indexed_counted_node(node : Sequence) -> Sequence = sequence_append(node, indexed_count_safe(node))


  reckon provider_literal_arguments(node : Sequence) -> Truth =
    choose(length(sequence_get(node, 2)) != 3, false,
      sequence_get(sequence_get(sequence_get(node, 2), 0), 0) == "LiteralExpr"
        and sequence_get(sequence_get(sequence_get(node, 2), 0), 1) == "Text"
        and sequence_get(sequence_get(sequence_get(node, 2), 1), 0) == "LiteralExpr"
        and sequence_get(sequence_get(sequence_get(node, 2), 1), 1) == "Text"
        and sequence_get(sequence_get(sequence_get(node, 2), 2), 0) == "LiteralExpr"
        and sequence_get(sequence_get(sequence_get(node, 2), 2), 1) == "Text")

  reckon facet_instruction_count(items : Sequence, index : Number, output : Number) -> Number =
    choose(index >= length(items), output,
      facet_instruction_count(items, index + 1,
        output + expression_count(sequence_get(sequence_get(items, index), 2)) + 1))

  reckon alter_instruction_count(items : Sequence, index : Number, output : Number) -> Number =
    choose(index >= length(items), output,
      alter_instruction_count(items, index + 1,
        output + expression_count(sequence_get(sequence_get(items, index), 1)) + 1))

  reckon preserve_instruction_count(items : Sequence, index : Number, output : Number) -> Number =
    choose(index >= length(items), output,
      preserve_instruction_count(items, index + 1,
        output + expression_count(sequence_get(items, index)) + 1))

  reckon rule_instruction_count(node : Sequence) -> Number =
    expression_count(sequence_get(node, 5)) + 3 + length(sequence_get(node, 6))
      + alter_instruction_count(sequence_get(node, 8), 0, 0)
      + choose(length(sequence_get(node, 7)) > 0,
          preserve_instruction_count(sequence_get(node, 7), 0, 2), 0)
      + length(sequence_get(node, 9))

  reckon directive_instruction_count(items : Sequence, index : Number, rules : Sequence, output : Number) -> Number =
    choose(index >= length(items), output,
      directive_instruction_count(items, index + 1, rules,
        output + rule_instruction_count(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)))))

  reckon main_instruction_count(program : Sequence) -> Number =
    facet_instruction_count(sequence_get(program, 1), 0,
      choose(has_conditional_warrants(sequence_get(program, 4), 0),
        length(sequence_get(program, 6)) * dynamic_warrant_count(sequence_get(program, 4), 0, 1), length(sequence_get(program, 4)))
        + directive_instruction_count(sequence_get(program, 6), 0, sequence_get(program, 5), 0) + 1)

  reckon dynamic_warrant_count(items : Sequence, index : Number, output : Number) -> Number =
    choose(index >= length(items), output,
      dynamic_warrant_count(items, index + 1, output + 1
        + choose(warrant_conditional(sequence_get(items, index)), expression_count(sequence_get(sequence_get(items, index), 3)), 0)))

  reckon make_instruction(op : Number, a : Number, b : Number, c : Number) -> Sequence =
    sequence_append(sequence_append(sequence_append(sequence_append(empty_sequence(), op), a), b), c)

  reckon make_flagged_instruction(op : Number, a : Number, b : Number, c : Number, flags : Number) -> Sequence =
    sequence_append(make_instruction(op, a, b, c), flags)


  reckon indexed_pair(left : Sequence, right : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), left), right)
  reckon indexed_empty_buckets(n : Number, output : Sequence) -> Sequence =
    choose(n <= 1, empty_sequence(), indexed_pair(indexed_empty_buckets(n / 2, output), indexed_empty_buckets(n / 2, output)))
  reckon indexed_bucket_at(items : Sequence, position : Number, span : Number) -> Sequence =
    choose(span <= 1, items,
      choose(position < span / 2, indexed_bucket_at(sequence_get(items, 0), position, span / 2),
        indexed_bucket_at(sequence_get(items, 1), position - span / 2, span / 2)))
  reckon indexed_bucket_set(items : Sequence, position : Number, value : Sequence, span : Number) -> Sequence =
    choose(span <= 1, value,
      choose(position < span / 2,
        indexed_pair(indexed_bucket_set(sequence_get(items, 0), position, value, span / 2), sequence_get(items, 1)),
        indexed_pair(sequence_get(items, 0), indexed_bucket_set(sequence_get(items, 1), position - span / 2, value, span / 2))))

  reckon indexed_bucket_replace(items : Sequence, position : Number, value : Sequence, index : Number, output : Sequence) -> Sequence =
    indexed_bucket_set(items, position, value, 64)

  reckon indexed_insert(items : Sequence, index : Number, buckets : Sequence) -> Sequence =
    choose(index >= length(items), buckets,
      indexed_insert(items, index + 1,
        indexed_bucket_replace(buckets, length(sequence_get(items, index)) % 64,
          sequence_append(indexed_bucket_at(buckets, length(sequence_get(items, index)) % 64, 64),
            sequence_append(sequence_append(empty_sequence(), sequence_get(items, index)), index)),
          0, empty_sequence())))
  reckon indexed_bucket_find(items : Sequence, index : Number, value : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(sequence_get(items, index), 0) == value,
        sequence_get(sequence_get(items, index), 1), indexed_bucket_find(items, index + 1, value)))
  reckon indexed_pool_find(value : Text) -> Number =
    indexed_bucket_find(indexed_bucket_at(compiler.string_index, length(value) % 64, 64), 0, value)
  reckon indexed_function_insert(items : Sequence, index : Number, address : Number, buckets : Sequence) -> Sequence =
    choose(index >= length(items), buckets,
      indexed_function_insert(items, index + 1, address + sequence_get(sequence_get(items, index), 4) + 1,
        indexed_bucket_replace(buckets, length(sequence_get(sequence_get(items, index), 0)) % 64,
          sequence_append(indexed_bucket_at(buckets, length(sequence_get(sequence_get(items, index), 0)) % 64, 64),
            sequence_append(sequence_append(empty_sequence(), sequence_get(sequence_get(items, index), 0)), address)),
          0, empty_sequence())))
  reckon indexed_function_find(name : Text) -> Number =
    indexed_bucket_find(indexed_bucket_at(compiler.function_index, length(name) % 64, 64), 0, name)
  reckon indexed_names_insert(items : Sequence, index : Number, buckets : Sequence) -> Sequence =
    choose(index >= length(items), buckets,
      indexed_names_insert(items, index + 1,
        indexed_bucket_replace(buckets, length(sequence_get(sequence_get(items, index), 0)) % 64,
          sequence_append(indexed_bucket_at(buckets, length(sequence_get(sequence_get(items, index), 0)) % 64, 64),
            sequence_append(sequence_append(empty_sequence(), sequence_get(sequence_get(items, index), 0)), index)),
          0, empty_sequence())))
  reckon indexed_validation_find(name : Text) -> Number =
    indexed_bucket_find(indexed_bucket_at(compiler.validation_index, length(name) % 64, 64), 0, name)


  reckon indexed_text_state(items : Sequence, buckets : Sequence) -> Sequence =
    sequence_append(sequence_append(empty_sequence(), items), buckets)
  reckon indexed_unique_text_add(state : Sequence, value : Text, bucket : Number) -> Sequence =
    indexed_text_state(sequence_append(sequence_get(state, 0), value),
      indexed_bucket_replace(sequence_get(state, 1), bucket,
        sequence_append(indexed_bucket_at(sequence_get(state, 1), bucket, 64),
          sequence_append(sequence_append(empty_sequence(), value), length(sequence_get(state, 0)))), 0, empty_sequence()))
  reckon indexed_unique_text(state : Sequence, value : Text) -> Sequence =
    choose(indexed_bucket_find(indexed_bucket_at(sequence_get(state, 1), length(value) % 64, 64), 0, value) >= 0, state,
      indexed_unique_text_add(state, value, length(value) % 64))

  reckon indexed_collect_expression_strings(node : Sequence, locals : Sequence, output : Sequence) -> Sequence =
    choose(sequence_get(node, 0) == "LiteralExpr",
      choose(sequence_get(node, 1) == "Text", indexed_unique_text(output, sequence_get(node, 2)), output),
      choose(sequence_get(node, 0) == "PathExpr",
        choose(find_text(locals, 0, sequence_get(node, 1)) >= 0, output, indexed_unique_text(output, sequence_get(node, 1))),
        choose(sequence_get(node, 0) == "UnaryExpr",
          indexed_collect_expression_strings(sequence_get(node, 2), locals, output),
          choose(sequence_get(node, 0) == "BinaryExpr",
            indexed_collect_expression_strings(sequence_get(node, 3), locals,
              indexed_collect_expression_strings(sequence_get(node, 2), locals, output)),
            indexed_collect_expression_strings_array(sequence_get(node, 2), 0, locals, output)))))

  reckon indexed_collect_expression_strings_array(items : Sequence, index : Number, locals : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_expression_strings_array(items, index + 1, locals,
        indexed_collect_expression_strings(sequence_get(items, index), locals, output)))

  reckon indexed_collect_facet_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_facet_strings(items, index + 1,
        indexed_unique_text(indexed_collect_expression_strings(sequence_get(sequence_get(items, index), 2), empty_sequence(), output),
          sequence_get(sequence_get(items, index), 0))))

  reckon indexed_collect_warrant_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_warrant_strings(items, index + 1,
        indexed_unique_text(
          indexed_unique_text(indexed_unique_text(output, sequence_get(sequence_get(items, index), 0)),
            sequence_get(sequence_get(items, index), 1)), sequence_get(sequence_get(items, index), 2))))

  reckon indexed_collect_need_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_need_strings(items, index + 1,
        indexed_unique_text(indexed_unique_text(output, sequence_get(sequence_get(items, index), 0)),
          sequence_get(sequence_get(items, index), 1))))

  reckon indexed_collect_alter_strings(items : Sequence, index : Number, reckons : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_alter_strings(items, index + 1, reckons,
        indexed_unique_text(
          indexed_collect_expression_strings(sequence_get(sequence_get(items, index), 1), empty_sequence(), output),
          sequence_get(sequence_get(items, index), 0))))

  reckon indexed_collect_rule_strings(node : Sequence, reckons : Sequence, output : Sequence) -> Sequence =
    indexed_collect_expression_strings_array(sequence_get(node, 7), 0, empty_sequence(),
      indexed_collect_alter_strings(sequence_get(node, 8), 0, reckons,
        indexed_collect_need_strings(sequence_get(node, 6), 0,
          indexed_unique_text(
            indexed_unique_text(indexed_collect_expression_strings(sequence_get(node, 5), empty_sequence(), output), sequence_get(node, 1)),
            rule_actor(node)))))

  reckon indexed_collect_witness_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_witness_strings(items, index + 1, indexed_unique_text(output, sequence_get(items, index))))

  reckon indexed_collect_rule_strings_complete(node : Sequence, reckons : Sequence, output : Sequence) -> Sequence =
    indexed_collect_witness_strings(sequence_get(node, 9), 0, indexed_collect_rule_strings(node, reckons, output))

  reckon indexed_collect_directive_strings(items : Sequence, index : Number, rules : Sequence, reckons : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_directive_strings(items, index + 1, rules, reckons,
        indexed_collect_rule_strings_complete(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)), reckons, output)))

  reckon indexed_collect_reckon_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_reckon_strings(items, index + 1,
        indexed_collect_expression_strings(sequence_get(sequence_get(items, index), 3),
          param_names(sequence_get(sequence_get(items, index), 1), 0, empty_sequence()), output)))

  reckon indexed_collect_dynamic_warrant_strings(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_dynamic_warrant_strings(items, index + 1,
        indexed_unique_text(indexed_unique_text(indexed_unique_text(
          choose(warrant_conditional(sequence_get(items, index)), indexed_collect_expression_strings(sequence_get(sequence_get(items, index), 3), empty_sequence(), output), output),
          sequence_get(sequence_get(items, index), 0)), sequence_get(sequence_get(items, index), 1)), sequence_get(sequence_get(items, index), 2))))

  reckon indexed_collect_dynamic_directive_strings(items : Sequence, index : Number, rules : Sequence, reckons : Sequence, warrants : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      indexed_collect_dynamic_directive_strings(items, index + 1, rules, reckons, warrants,
        indexed_collect_rule_strings_complete(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)), reckons, indexed_collect_dynamic_warrant_strings(warrants, 0, output))))

  reckon indexed_build_string_pool(program : Sequence, root : Text) -> Sequence =
    sequence_get(indexed_collect_reckon_strings(sequence_get(program, 2), 0,
      choose(has_conditional_warrants(sequence_get(program, 4), 0),
        indexed_collect_dynamic_directive_strings(sequence_get(program, 6), 0, sequence_get(program, 5), sequence_get(program, 2), sequence_get(program, 4),
          indexed_collect_facet_strings(sequence_get(program, 1), 0, indexed_unique_text(indexed_unique_text(indexed_text_state(empty_sequence(), indexed_empty_buckets(64, empty_sequence())), sequence_get(program, 0)), root))),
        indexed_collect_directive_strings(sequence_get(program, 6), 0, sequence_get(program, 5), sequence_get(program, 2),
          indexed_collect_warrant_strings(sequence_get(program, 4), 0,
            indexed_collect_facet_strings(sequence_get(program, 1), 0, indexed_unique_text(indexed_unique_text(indexed_text_state(empty_sequence(), indexed_empty_buckets(64, empty_sequence())), sequence_get(program, 0)), root)))))), 0)

  reckon one_instruction(op : Number, a : Number, b : Number, c : Number) -> Sequence =
    sequence_append(empty_sequence(), make_instruction(op, a, b, c))

  reckon one_flagged_instruction(op : Number, a : Number, b : Number, c : Number, flags : Number) -> Sequence =
    sequence_append(empty_sequence(), make_flagged_instruction(op, a, b, c, flags))

  reckon binary_opcode(operator : Text) -> Number =
    choose(operator == "+", 6,
      choose(operator == minus_operator(), 7,
        choose(operator == "*", 8,
          choose(operator == "/", 9,
            choose(operator == "==", 10,
              choose(operator == "!=", 11,
                choose(operator == "<", 12,
                  choose(operator == "<=", 13,
                    choose(operator == ">", 14,
                      choose(operator == ">=", 15, 44))))))))))

  reckon emit_expression_array(items : Sequence, index : Number, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_expression_array(items, index + 1, locals, reckons, strings, numbers, main_count,
        start, append_all(emit_expression(sequence_get(items, index), locals, reckons, strings, numbers, main_count, start + length(output)), output)))

  reckon emit_short_binary(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    choose(sequence_get(node, 1) == "and",
      append_all(one_instruction(2, 0, 0, 0),
        append_all(one_instruction(20, start + expression_count(node), 0, 0),
          append_all(one_instruction(18, 0, 0, 0),
            append_all(one_instruction(18, 0, 0, 0),
              append_all(emit_expression(sequence_get(node, 3), locals, reckons, strings, numbers, main_count,
                  start + expression_count(sequence_get(node, 2)) + 1),
                append_all(one_instruction(21, start + expression_count(node) - 1, 0, 0),
                  emit_expression(sequence_get(node, 2), locals, reckons, strings, numbers, main_count, start))))))),
      append_all(one_instruction(18, 0, 0, 0),
        append_all(one_instruction(18, 0, 0, 0),
          append_all(emit_expression(sequence_get(node, 3), locals, reckons, strings, numbers, main_count,
              start + expression_count(sequence_get(node, 2)) + 3),
            append_all(one_instruction(20, start + expression_count(node), 0, 0),
              append_all(one_instruction(2, 1, 0, 0),
                append_all(one_instruction(21, start + expression_count(sequence_get(node, 2)) + 3, 0, 0),
                  emit_expression(sequence_get(node, 2), locals, reckons, strings, numbers, main_count, start))))))))

  reckon emit_binary(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    choose(sequence_get(node, 1) == "and" or sequence_get(node, 1) == "or",
      emit_short_binary(node, locals, reckons, strings, numbers, main_count, start),
      append_all(one_instruction(binary_opcode(sequence_get(node, 1)), 0, 0, 0),
        append_all(emit_expression(sequence_get(node, 3), locals, reckons, strings, numbers, main_count,
            start + expression_count(sequence_get(node, 2))),
          emit_expression(sequence_get(node, 2), locals, reckons, strings, numbers, main_count, start))))

  reckon emit_choose(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    append_all(emit_expression(sequence_get(sequence_get(node, 2), 2), locals, reckons, strings, numbers, main_count,
        start + expression_count(sequence_get(sequence_get(node, 2), 0)) + expression_count(sequence_get(sequence_get(node, 2), 1)) + 2),
      append_all(one_instruction(20, start + expression_count(node), 0, 0),
        append_all(emit_expression(sequence_get(sequence_get(node, 2), 1), locals, reckons, strings, numbers, main_count,
            start + expression_count(sequence_get(sequence_get(node, 2), 0)) + 1),
          append_all(one_instruction(21,
              start + expression_count(sequence_get(sequence_get(node, 2), 0)) + expression_count(sequence_get(sequence_get(node, 2), 1)) + 2, 0, 0),
            emit_expression(sequence_get(sequence_get(node, 2), 0), locals, reckons, strings, numbers, main_count, start)))))

  reckon emit_call(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    choose(sequence_get(node, 1) == "provider_call",
      choose(provider_literal_arguments(node),
        one_instruction(35,
          indexed_pool_find( sequence_get(sequence_get(sequence_get(node, 2), 0), 2)),
          indexed_pool_find( sequence_get(sequence_get(sequence_get(node, 2), 1), 2)),
          indexed_pool_find( sequence_get(sequence_get(sequence_get(node, 2), 2), 2))),
        append_all(one_flagged_instruction(35, 0, 0, 0, 1),
          emit_expression_array(sequence_get(node, 2), 0, locals, reckons, strings, numbers, main_count, start, empty_sequence()))),
      choose(sequence_get(node, 1) == "choose", emit_choose(node, locals, reckons, strings, numbers, main_count, start),
        indexed_emit_call_builtin(node, locals, reckons, strings, numbers, main_count, start, builtin_id(sequence_get(node, 1)))))

  reckon indexed_emit_call_builtin(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, builtin : Number) -> Sequence =
    append_all(one_instruction(
            choose(builtin > 0, 30, 33),
            choose(builtin > 0, builtin,
              main_count + indexed_function_find(sequence_get(node, 1))),
            length(sequence_get(node, 2)), 0),
          emit_expression_array(sequence_get(node, 2), 0, locals, reckons, strings, numbers, main_count, start, empty_sequence()))

  reckon emit_expression(node : Sequence, locals : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    choose(sequence_get(node, 0) == "LiteralExpr",
      choose(sequence_get(node, 1) == "Number", one_instruction(1, find_number(numbers, 0, number_from_text(sequence_get(node, 2))), 0, 0),
        choose(sequence_get(node, 1) == "Truth", one_instruction(2, choose(sequence_get(node, 2) == "true", 1, 0), 0, 0),
          one_instruction(3, indexed_pool_find( sequence_get(node, 2)), 0, 0))),
      choose(sequence_get(node, 0) == "PathExpr",
        indexed_emit_path_index(sequence_get(node, 1), find_text(locals, 0, sequence_get(node, 1))),
        choose(sequence_get(node, 0) == "UnaryExpr",
          append_all(one_instruction(choose(sequence_get(node, 1) == not_operator(), 18, 19), 0, 0, 0),
            emit_expression(sequence_get(node, 2), locals, reckons, strings, numbers, main_count, start)),
          choose(sequence_get(node, 0) == "BinaryExpr",
            emit_binary(node, locals, reckons, strings, numbers, main_count, start),
            emit_call(node, locals, reckons, strings, numbers, main_count, start)))))

  reckon indexed_emit_path_index(name : Text, index : Number) -> Sequence =
    choose(index >= 0, one_instruction(32, index, 0, 0), one_instruction(4, indexed_pool_find(name), 0, 0))

  reckon emit_facets(items : Sequence, index : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_facets(items, index + 1, reckons, strings, numbers, main_count, start,
        append_all(one_instruction(5, indexed_pool_find( sequence_get(sequence_get(items, index), 0)), 0, 0),
          append_all(emit_expression(sequence_get(sequence_get(items, index), 2), empty_sequence(), reckons, strings, numbers,
              main_count, start + length(output)), output))))

  reckon emit_warrants(items : Sequence, index : Number, strings : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_warrants(items, index + 1, strings,
        append_all(one_instruction(22,
            indexed_pool_find( sequence_get(sequence_get(items, index), 0)),
            indexed_pool_find( sequence_get(sequence_get(items, index), 1)),
            indexed_pool_find( sequence_get(sequence_get(items, index), 2))), output)))

  reckon emit_dynamic_warrants(items : Sequence, index : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_dynamic_warrants(items, index + 1, reckons, strings, numbers, main_count, start,
        append_all(sequence_append(empty_sequence(), make_flagged_instruction(22,
            indexed_pool_find( sequence_get(sequence_get(items, index), 0)),
            indexed_pool_find( sequence_get(sequence_get(items, index), 1)),
            indexed_pool_find( sequence_get(sequence_get(items, index), 2)), choose(warrant_conditional(sequence_get(items, index)), 1, 0))),
          choose(warrant_conditional(sequence_get(items, index)),
            append_all(emit_expression(sequence_get(sequence_get(items, index), 3), empty_sequence(), reckons, strings, numbers, main_count, start + length(output)), output), output))))

  reckon emit_warrant_refresh(items : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    emit_dynamic_warrants(items, 0, reckons, strings, numbers, main_count, start, one_instruction(47, 0, 0, 0))

  reckon emit_rule_needs(items : Sequence, index : Number, actor : Text, strings : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_rule_needs(items, index + 1, actor, strings,
        append_all(one_instruction(24,
            indexed_pool_find( actor),
            indexed_pool_find( sequence_get(sequence_get(items, index), 0)),
            indexed_pool_find( sequence_get(sequence_get(items, index), 1))), output)))

  reckon emit_rule_alters(items : Sequence, index : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_rule_alters(items, index + 1, reckons, strings, numbers, main_count, start,
        append_all(one_instruction(25, indexed_pool_find( sequence_get(sequence_get(items, index), 0)), 0, 0),
          append_all(emit_expression(sequence_get(sequence_get(items, index), 1), empty_sequence(), reckons, strings, numbers,
              main_count, start + length(output)), output))))

  reckon emit_preserve_items(items : Sequence, index : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_preserve_items(items, index + 1, reckons, strings, numbers, main_count, start,
        append_all(one_instruction(27, 0, 0, 0),
          append_all(emit_expression(sequence_get(items, index), empty_sequence(), reckons, strings, numbers,
              main_count, start + length(output)), output))))

  reckon emit_rule_preserves(items : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    choose(length(items) == 0, empty_sequence(),
      append_all(one_instruction(26, 0, 0, 0),
        emit_preserve_items(items, 0, reckons, strings, numbers, main_count, start,
          one_instruction(26, 1, 0, 0))))

  reckon emit_rule_witnesses(items : Sequence, index : Number, strings : Sequence, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_rule_witnesses(items, index + 1, strings,
        append_all(one_instruction(28, indexed_pool_find( sequence_get(items, index)), 0, 0), output)))

  reckon emit_rule_invocation(node : Sequence, mode : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number) -> Sequence =
    append_all(one_instruction(29, 0, 0, 0),
      append_all(emit_rule_witnesses(sequence_get(node, 9), 0, strings, empty_sequence()),
        append_all(emit_rule_preserves(sequence_get(node, 7), reckons, strings, numbers, main_count,
            start + expression_count(sequence_get(node, 5)) + 2 + length(sequence_get(node, 6))
              + alter_instruction_count(sequence_get(node, 8), 0, 0)),
          append_all(emit_rule_alters(sequence_get(node, 8), 0, reckons, strings, numbers, main_count,
              start + expression_count(sequence_get(node, 5)) + 2 + length(sequence_get(node, 6)), empty_sequence()),
            append_all(emit_rule_needs(sequence_get(node, 6), 0, rule_actor(node), strings, empty_sequence()),
              append_all(one_flagged_instruction(23, mode,
                  indexed_pool_find( sequence_get(node, 1)), indexed_pool_find( rule_actor(node)),
                  choose(sequence_get(node, 0) == "Resonance", 1, 0)),
                append_all(one_instruction(21, start + rule_instruction_count(node), 0, 0),
                  emit_expression(sequence_get(node, 5), empty_sequence(), reckons, strings, numbers, main_count, start))))))))

  reckon emit_directives(items : Sequence, index : Number, rules : Sequence, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_directives(items, index + 1, rules, reckons, strings, numbers, main_count, start,
        append_all(emit_rule_invocation(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)),
            choose(sequence_get(sequence_get(items, index), 0) == "Realize", 1, 0),
            reckons, strings, numbers, main_count, start + length(output)), output)))

  reckon emit_dynamic_directives(items : Sequence, index : Number, rules : Sequence, reckons : Sequence, warrants : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_dynamic_directives(items, index + 1, rules, reckons, warrants, strings, numbers, main_count,
        append_all(emit_rule_invocation(find_rule(rules, 0, sequence_get(sequence_get(items, index), 1)),
            choose(sequence_get(sequence_get(items, index), 0) == "Realize", 1, 0), reckons, strings, numbers, main_count,
            length(output) + dynamic_warrant_count(warrants, 0, 1)),
          append_all(emit_warrant_refresh(warrants, reckons, strings, numbers, main_count, length(output)), output))))

  reckon emit_reckons(items : Sequence, index : Number, reckons : Sequence, strings : Sequence, numbers : Sequence, main_count : Number, start : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      emit_reckons(items, index + 1, reckons, strings, numbers, main_count, start,
        append_all(one_instruction(34, 0, 0, 0),
          append_all(emit_expression(sequence_get(sequence_get(items, index), 3),
              param_names(sequence_get(sequence_get(items, index), 1), 0, empty_sequence()), reckons, strings, numbers,
              main_count, start + length(output)), output))))

  reckon build_instructions(program : Sequence, strings : Sequence, numbers : Sequence) -> Sequence =
    append_all(
      emit_reckons(sequence_get(program, 2), 0, sequence_get(program, 2), strings, numbers,
        main_instruction_count(program), main_instruction_count(program), empty_sequence()),
      append_all(one_instruction(31, 0, 0, 0),
        choose(has_conditional_warrants(sequence_get(program, 4), 0),
          emit_dynamic_directives(sequence_get(program, 6), 0, sequence_get(program, 5), sequence_get(program, 2), sequence_get(program, 4), strings, numbers, main_instruction_count(program),
            emit_facets(sequence_get(program, 1), 0, sequence_get(program, 2), strings, numbers, main_instruction_count(program), 0, empty_sequence())),
          emit_directives(sequence_get(program, 6), 0, sequence_get(program, 5), sequence_get(program, 2), strings, numbers, main_instruction_count(program), 0,
            emit_warrants(sequence_get(program, 4), 0, strings,
              emit_facets(sequence_get(program, 1), 0, sequence_get(program, 2), strings, numbers, main_instruction_count(program), 0, empty_sequence()))))))

  reckon encode_string_record(value : Text) -> Sequence =
    sequence_concat(bytes_u32le(length(utf8_bytes(value))), utf8_bytes(value))

  reckon encode_string_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_string_pool(items, index + 1, sequence_concat(output, encode_string_record(sequence_get(items, index)))))

  reckon encode_number_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_number_pool(items, index + 1, sequence_concat(output, bytes_f64le(sequence_get(items, index)))))

  reckon encode_instruction(node : Sequence) -> Sequence =
    sequence_concat(bytes_u8(sequence_get(node, 0)),
      sequence_concat(bytes_u8(choose(length(node) > 4, sequence_get(node, 4), 0)),
        sequence_concat(bytes_u16le(0),
          sequence_concat(bytes_i32le(sequence_get(node, 1)),
            sequence_concat(bytes_i32le(sequence_get(node, 2)), bytes_i32le(sequence_get(node, 3)))))))

  reckon encode_instructions(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_instructions(items, index + 1, sequence_concat(output, encode_instruction(sequence_get(items, index)))))

  reckon instruction_flags(node : Sequence) -> Number = choose(length(node) > 4, sequence_get(node, 4), 0)

  reckon instructions_require_v12(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), false,
      choose(sequence_get(sequence_get(items, index), 0) == 44
          or (sequence_get(sequence_get(items, index), 0) == 35 and instruction_flags(sequence_get(items, index)) == 1),
        true, instructions_require_v12(items, index + 1)))

  reckon instructions_require_v13(items : Sequence, index : Number) -> Truth =
    choose(index >= length(items), false,
      choose(sequence_get(sequence_get(items, index), 0) >= 45
          or (sequence_get(sequence_get(items, index), 0) == 22 and instruction_flags(sequence_get(items, index)) == 1),
        true, instructions_require_v13(items, index + 1)))

  reckon encode_header(program_index : Number, root_index : Number, string_count : Number, number_count : Number, instruction_count : Number, minor : Number) -> Sequence =
    encode_header_with_flags(program_index, root_index, string_count, number_count, instruction_count, minor, 0)

  reckon encode_header_with_flags(program_index : Number, root_index : Number, string_count : Number, number_count : Number, instruction_count : Number, minor : Number, flags : Number) -> Sequence =
    sequence_concat(utf8_bytes("RCLB"),
      sequence_concat(bytes_u16le(1),
        sequence_concat(bytes_u16le(minor),
          sequence_concat(bytes_u32le(flags),
            sequence_concat(bytes_u32le(program_index),
              sequence_concat(bytes_u32le(root_index),
                sequence_concat(bytes_u32le(string_count),
                  sequence_concat(bytes_u32le(number_count),
                    sequence_concat(bytes_u32le(instruction_count), bytes_u32le(0))))))))))

  reckon encode_rbc(program : Sequence, root : Text, strings : Sequence, numbers : Sequence, instructions : Sequence) -> Sequence =
    sequence_concat(
      encode_header(indexed_pool_find( sequence_get(program, 0)), indexed_pool_find( root),
        length(strings), length(numbers), length(instructions), choose(instructions_require_v13(instructions, 0), 3, choose(instructions_require_v12(instructions, 0), 2, 1))),
      sequence_concat(encode_string_pool(strings, 0, empty_sequence()),
        sequence_concat(encode_number_pool(numbers, 0, empty_sequence()),
          encode_instructions(instructions, 0, empty_sequence()))))

  reckon k337_scope_matches(granted : Text, required : Text) -> Truth =
    choose(granted == "*", true,
      choose(granted == required, true, starts_with(required, granted + ".")))

  reckon k337_warrant_matches(node : Sequence, actor : Text, need : Sequence) -> Truth =
    sequence_get(node, 0) == actor
      and sequence_get(node, 1) == sequence_get(need, 0)
      and k337_scope_matches(sequence_get(node, 2), sequence_get(need, 1))

  reckon k337_warrant_exists(items : Sequence, index : Number, actor : Text, need : Sequence) -> Truth =
    choose(index >= length(items), false,
      choose(k337_warrant_matches(sequence_get(items, index), actor, need), true,
        k337_warrant_exists(items, index + 1, actor, need)))

  reckon k337_validate_rule_needs(items : Sequence, index : Number, warrants : Sequence, actor : Text, name : Text) -> Truth =
    choose(index >= length(items), true,
      choose(actor == "", k337_validate_rule_needs(items, index + 1, warrants, actor, name),
        choose(semantic_check(k337_warrant_exists(warrants, 0, actor, sequence_get(items, index)),
            "RCL_WARRANT_MISSING", name + ":" + actor + ":" + sequence_get(sequence_get(items, index), 0) + ":" + sequence_get(sequence_get(items, index), 1)),
          k337_validate_rule_needs(items, index + 1, warrants, actor, name), false)))

  reckon k337_validate_rules(items : Sequence, index : Number, warrants : Sequence) -> Truth =
    choose(index >= length(items), true,
      choose(k337_validate_rule_needs(sequence_get(sequence_get(items, index), 6), 0, warrants,
          rule_actor(sequence_get(items, index)), sequence_get(sequence_get(items, index), 1)),
        k337_validate_rules(items, index + 1, warrants), false))

  reckon k337_validated_program(program : Sequence) -> Sequence =
    choose(k337_validate_rules(sequence_get(program, 5), 0, sequence_get(program, 4)), program, program)

  facet compiler.source : Text = provider_call("compiler_input", "source", "{}")
  facet compiler.tokens : Sequence = tokenize(compiler.source)
  facet compiler.raw_program : Sequence = parse_program(compiler.tokens)
  facet compiler.validation_index : Sequence = indexed_names_insert(sequence_get(compiler.raw_program, 2), 0, indexed_empty_buckets(64, empty_sequence()))
  facet compiler.program : Sequence = k337_validated_program(validated_program(compiler.raw_program))
  facet compiler.function_index : Sequence = indexed_function_insert(sequence_get(compiler.program, 2), 0, 0, indexed_empty_buckets(64, empty_sequence()))
  facet compiler.canonical : Text = canonical_program(compiler.program)
  facet compiler.root : Text = sha256_text(compiler.canonical)
  facet compiler.strings : Sequence = indexed_build_string_pool(compiler.program, compiler.root)
  facet compiler.string_index : Sequence = indexed_insert(compiler.strings, 0, indexed_empty_buckets(64, empty_sequence()))
  facet compiler.numbers : Sequence = build_number_pool(compiler.program)
  facet compiler.instructions : Sequence = build_instructions(compiler.program, compiler.strings, compiler.numbers)
  facet compiler.output : Sequence = encode_rbc(compiler.program, compiler.root, compiler.strings, compiler.numbers, compiler.instructions)
}
