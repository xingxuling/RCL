reality RCLSelfHostRuntimeTypedValuesInterpreterStage17 {
  facet source.program : Text = "RuntimeTypedValuesTarget"
  facet source.root : Text = "10b6835e4acc69116909bf85b8f933d32bac3d5141039c5864dcec48120db8d9"

  facet selfhost.stage : Text = "stage17_rcl_owned_runtime_typed_values_subset"
