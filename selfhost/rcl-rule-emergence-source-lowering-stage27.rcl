        and source.root == "f5674dfb60b01df609f181eea2370994db01b04baa423f504640021aff3274f3",
      "RCL_STAGE27_RULE_SOURCE_LOWERING_MISMATCH",
      selfhost.stage,
      token_span(sequence_get(parser.tokens, 0)))

  facet target.rbc_strings : Sequence = build_target_strings()
  facet target.rbc_instruction_ops : Sequence = build_instruction_values(0, target.rbc_strings, 0, empty_sequence())
  facet target.rbc_instruction_a_values : Sequence = build_instruction_values(0, target.rbc_strings, 1, empty_sequence())
