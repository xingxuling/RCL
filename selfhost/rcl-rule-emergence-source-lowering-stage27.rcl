reality RCLSelfHostRuleEmergenceSourceLoweringStage27 {
  facet selfhost.stage : Text = "stage27_rcl_owned_rule_emergence_source_lowering_subset"
  facet selfhost.stage_status : Text = "UNVERIFIED"
  facet selfhost.claim : Text = "rcl_parses_single_subject_warrant_emergence_foresee_realize_source_and_lowers_rule_transaction_bytecode_inside_native_vm"
  facet selfhost.boundary : Text = "single_rule_emergence_source_lowering_subset_not_complete_parser_compiler_or_runtime"
  facet selfhost.next_rewrite_target : Text = "rcl_owned_general_rule_and_expression_bytecode_lowering"

  facet gate.full_self_hosting : Truth = false
  facet gate.rcl_owned_tokenizer_subset : Truth = true
  facet gate.rcl_owned_recursive_facet_parser_subset : Truth = true
  facet gate.rcl_owned_expression_ast_subset : Truth = true
  facet gate.rcl_owned_rule_emergence_source_lowering_subset : Truth = true
  facet gate.rcl_owned_rule_transaction_bytecode_subset : Truth = true
  facet gate.rcl_owned_target_native_execution_subset : Truth = true
  facet gate.rcl_owned_parser_complete : Truth = false
  facet gate.rcl_owned_expression_ast_complete : Truth = false
  facet gate.rcl_owned_rule_bytecode_lowering_complete : Truth = false
  facet gate.rcl_compiler_self_emits_without_stage0 : Truth = false
  facet gate.rcl_owned_runtime_complete : Truth = false
  facet gate.rcl_owned_runtime_root_hashing_complete : Truth = false
  facet gate.js_runtime_still_required : Truth = true
  facet gate.native_vm_host_still_required : Truth = true

  facet source.full : Text = "reality RuntimeRuleSourceLoweringTarget { facet world.ready : Truth = true facet world.status : Text = \"draft\" subject founder { warrant world.publish on world } emergence publish { cause founder when world.ready needs world.publish on world alter world.status <- \"published\" preserve world.status == \"published\" witness \"rcl:stage27:published\" } foresee publish realize publish }"
  facet source.root : Text = "f5674dfb60b01df609f181eea2370994db01b04baa423f504640021aff3274f3"

  reckon scan_identifier_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(is_identifier_part(char_at(source, index)),
        scan_identifier_end(source, index + 1),
        index))

  reckon scan_number_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(is_digit(char_at(source, index)),
        scan_number_end(source, index + 1),
        index))

  reckon scan_string_end(source : Text, index : Number) -> Number =
    choose(index >= length(source), index,
      choose(char_at(source, index) == "\"",
        index,
        scan_string_end(source, index + 1)))

  reckon tokenize_from(source : Text, index : Number, line : Number, column : Number, output : Sequence) -> Sequence =
    choose(index >= length(source),
      sequence_append(output, make_token("EOF", "<eof>", make_span(index, line, column, 0))),
      choose(is_whitespace(char_at(source, index)),
        choose(char_at(source, index) == "\n",
          tokenize_from(source, index + 1, line + 1, 1, output),
          tokenize_from(source, index + 1, line, column + 1, output)),
        choose(is_identifier_start(char_at(source, index)),
          tokenize_from(
            source,
            scan_identifier_end(source, index + 1),
            line,
            column + scan_identifier_end(source, index + 1) - index,
            sequence_append(output,
              make_token(
                "IDENT",
                slice_text(source, index, scan_identifier_end(source, index + 1) - index),
                make_span(index, line, column, scan_identifier_end(source, index + 1) - index)))),
          choose(is_digit(char_at(source, index)),
            tokenize_from(
              source,
              scan_number_end(source, index + 1),
              line,
              column + scan_number_end(source, index + 1) - index,
              sequence_append(output,
                make_token(
                  "NUMBER",
                  slice_text(source, index, scan_number_end(source, index + 1) - index),
                  make_span(index, line, column, scan_number_end(source, index + 1) - index)))),
            choose(char_at(source, index) == "\"",
              tokenize_from(
                source,
                scan_string_end(source, index + 1) + 1,
                line,
                column + scan_string_end(source, index + 1) - index + 1,
                sequence_append(output,
                  make_token(
                    "STRING",
                    slice_text(source, index + 1, scan_string_end(source, index + 1) - index - 1),
                    make_span(index, line, column, scan_string_end(source, index + 1) - index + 1)))),
              tokenize_from(
                source,
                index + 1,
                line,
                column + 1,
                sequence_append(output,
                  make_token("SYMBOL", char_at(source, index), make_span(index, line, column, 1)))))))))

  reckon checked_text(tokens : Sequence, index : Number, kind : Text, expected : Text) -> Text =
    token_text(expect_token(sequence_get(tokens, index), kind, expected))

  reckon checked_ident(tokens : Sequence, index : Number, expected : Text) -> Text =
    checked_text(tokens, index, "IDENT", expected)

  reckon checked_symbol(tokens : Sequence, index : Number, expected : Text) -> Text =
    checked_text(tokens, index, "SYMBOL", expected)

  reckon path_end(tokens : Sequence, index : Number) -> Number =
    choose(token_text(sequence_get(tokens, index + 1)) == char_at(".", 0),
      path_end(tokens, index + 2),
      index + 1)

  reckon path_text(tokens : Sequence, index : Number) -> Text =
    choose(token_text(sequence_get(tokens, index + 1)) == char_at(".", 0),
      token_text(expect_token(sequence_get(tokens, index), "IDENT", ""))
        + char_at(".", 0)
        + path_text(tokens, index + 2),
      token_text(expect_token(sequence_get(tokens, index), "IDENT", "")))

  reckon literal_kind_at(tokens : Sequence, index : Number) -> Text =
    choose(token_kind(sequence_get(tokens, index)) == "NUMBER", "Number",
      choose(token_kind(sequence_get(tokens, index)) == "STRING", "Text", "Truth"))

  reckon expr_node(kind : Text, name : Text, value_type : Text, text_value : Text, span : Span) -> Sequence =
    sequence_append(
      sequence_append(
        sequence_append(
          sequence_append(
            sequence_append(empty_sequence(), kind),
            name),
          value_type),
        text_value),
      span)

  reckon expr_kind_of(node : Sequence) -> Text = sequence_get(node, 0)
  reckon expr_name_of(node : Sequence) -> Text = sequence_get(node, 1)
  reckon expr_value_type_of(node : Sequence) -> Text = sequence_get(node, 2)
  reckon expr_text_of(node : Sequence) -> Text = sequence_get(node, 3)
  reckon expr_span_of(node : Sequence) -> Span = sequence_get(node, 4)

  reckon literal_expr_node(tokens : Sequence, index : Number) -> Sequence =
    expr_node(
      "LiteralExpr",
      "",
      literal_kind_at(tokens, index),
      token_text(expect_token(sequence_get(tokens, index), token_kind(sequence_get(tokens, index)), "")),
      token_span(sequence_get(tokens, index)))

  reckon path_expr_node(tokens : Sequence, index : Number) -> Sequence =
    expr_node(
      "PathExpr",
      "",
      "",
      path_text(tokens, index),
      token_span(sequence_get(tokens, index)))

  reckon binary_expr_node(operator : Text, left : Sequence, right : Sequence, span : Span) -> Sequence =
    expr_node("BinaryExpr", operator, "", "", span)

  reckon facet_node(path : Text, value_type : Text, expr : Sequence, span : Span) -> Sequence =
    sequence_append(
      sequence_append(
        sequence_append(
          sequence_append(empty_sequence(), path),
          value_type),
        expr),
      span)

  reckon facet_path_of(node : Sequence) -> Text = sequence_get(node, 0)
  reckon facet_type_of(node : Sequence) -> Text = sequence_get(node, 1)
  reckon facet_expr_of(node : Sequence) -> Sequence = sequence_get(node, 2)
  reckon facet_span_of_node(node : Sequence) -> Span = sequence_get(node, 3)

  reckon facet_colon_index(tokens : Sequence, start : Number) -> Number =
    path_end(tokens, start + 1)

  reckon facet_type_start(tokens : Sequence, start : Number) -> Number =
    facet_colon_index(tokens, start) + 1

  reckon facet_equals_index(tokens : Sequence, start : Number) -> Number =
    path_end(tokens, facet_type_start(tokens, start))

  reckon facet_expr_start(tokens : Sequence, start : Number) -> Number =
    facet_equals_index(tokens, start) + 1

  reckon after_literal_facet(tokens : Sequence, start : Number) -> Number =
    facet_expr_start(tokens, start) + 1

  reckon parse_literal_facet(tokens : Sequence, start : Number) -> Sequence =
    facet_node(
      path_text(tokens, start + 1),
      token_text(expect_token(sequence_get(tokens, facet_type_start(tokens, start)), "IDENT", "")),
      literal_expr_node(tokens, facet_expr_start(tokens, start)),
      token_span(sequence_get(tokens, start)))

  reckon subject_node(name : Text, capability : Text, target : Text, span : Span) -> Sequence =
    sequence_append(
      sequence_append(
        sequence_append(
          sequence_append(empty_sequence(), name),
          capability),
        target),
      span)

  reckon subject_name_of(node : Sequence) -> Text = sequence_get(node, 0)
  reckon subject_capability_of(node : Sequence) -> Text = sequence_get(node, 1)
  reckon subject_target_of(node : Sequence) -> Text = sequence_get(node, 2)

  reckon emergence_node(
    name : Text,
    cause : Text,
    when_path : Text,
    need_capability : Text,
    need_target : Text,
    alter_target : Text,
    alter_value : Text,
    preserve_left : Text,
    preserve_operator : Text,
    preserve_right : Text,
    witness : Text,
    span : Span
  ) -> Sequence =
    sequence_append(
      sequence_append(
        sequence_append(
          sequence_append(
            sequence_append(
              sequence_append(
                sequence_append(
                  sequence_append(
                    sequence_append(
                      sequence_append(
                        sequence_append(
                          sequence_append(empty_sequence(), name),
                          cause),
                        when_path),
                      need_capability),
                    need_target),
                  alter_target),
                alter_value),
              preserve_left),
            preserve_operator),
          preserve_right),
        witness),
      span)

  reckon rule_name_of(node : Sequence) -> Text = sequence_get(node, 0)
  reckon rule_cause_of(node : Sequence) -> Text = sequence_get(node, 1)
  reckon rule_when_path_of(node : Sequence) -> Text = sequence_get(node, 2)
  reckon rule_need_capability_of(node : Sequence) -> Text = sequence_get(node, 3)
  reckon rule_need_target_of(node : Sequence) -> Text = sequence_get(node, 4)
  reckon rule_alter_target_of(node : Sequence) -> Text = sequence_get(node, 5)
  reckon rule_alter_value_of(node : Sequence) -> Text = sequence_get(node, 6)
  reckon rule_preserve_left_of(node : Sequence) -> Text = sequence_get(node, 7)
  reckon rule_preserve_operator_of(node : Sequence) -> Text = sequence_get(node, 8)
  reckon rule_preserve_right_of(node : Sequence) -> Text = sequence_get(node, 9)
  reckon rule_witness_of(node : Sequence) -> Text = sequence_get(node, 10)

  reckon find_token_text(tokens : Sequence, index : Number, text_value : Text) -> Number =
    choose(index >= length(tokens), -1,
      choose(token_text(sequence_get(tokens, index)) == text_value,
        index,
        find_token_text(tokens, index + 1, text_value)))

  reckon find_token_text_after(tokens : Sequence, index : Number, text_value : Text) -> Number =
    find_token_text(tokens, index + 1, text_value)

  reckon parse_subject(tokens : Sequence, start : Number) -> Sequence =
    subject_node(
      token_text(expect_token(sequence_get(tokens, start + 1), "IDENT", "")),
      path_text(tokens, start + 4),
      token_text(expect_token(sequence_get(tokens, path_end(tokens, start + 4) + 1), "IDENT", "")),
      token_span(sequence_get(tokens, start)))

  reckon parse_emergence(tokens : Sequence, start : Number) -> Sequence =
    emergence_node(
      token_text(expect_token(sequence_get(tokens, start + 1), "IDENT", "")),
      token_text(expect_token(sequence_get(tokens, find_token_text(tokens, start, "cause") + 1), "IDENT", "")),
      path_text(tokens, find_token_text(tokens, start, "when") + 1),
      path_text(tokens, find_token_text(tokens, start, "needs") + 1),
      token_text(expect_token(sequence_get(tokens, path_end(tokens, find_token_text(tokens, start, "needs") + 1) + 1), "IDENT", "")),
      path_text(tokens, find_token_text(tokens, start, "alter") + 1),
      token_text(expect_token(sequence_get(tokens, path_end(tokens, find_token_text(tokens, start, "alter") + 1) + 2), "STRING", "")),
      path_text(tokens, find_token_text(tokens, start, "preserve") + 1),
      token_text(expect_token(sequence_get(tokens, path_end(tokens, find_token_text(tokens, start, "preserve") + 1)), "SYMBOL", ""))
        + token_text(expect_token(sequence_get(tokens, path_end(tokens, find_token_text(tokens, start, "preserve") + 1) + 1), "SYMBOL", "")),
      token_text(expect_token(sequence_get(tokens, path_end(tokens, find_token_text(tokens, start, "preserve") + 1) + 2), "STRING", "")),
      token_text(expect_token(sequence_get(tokens, find_token_text(tokens, start, "witness") + 1), "STRING", "")),
      token_span(sequence_get(tokens, start)))

  reckon find_text(items : Sequence, index : Number, text_value : Text) -> Number =
    choose(index >= length(items), -1,
      choose(sequence_get(items, index) == text_value,
        index,
        find_text(items, index + 1, text_value)))

  reckon append_unique_text(items : Sequence, value : Text) -> Sequence =
    choose(find_text(items, 0, value) >= 0, items, sequence_append(items, value))

  reckon build_target_strings() -> Sequence =
    append_unique_text(
      append_unique_text(
        append_unique_text(
          append_unique_text(
            append_unique_text(
              append_unique_text(
                append_unique_text(
                  append_unique_text(
                    append_unique_text(
                      append_unique_text(
                        append_unique_text(empty_sequence(), compiler.program),
                        source.root),
                      facet_path_of(compiler.ready_facet)),
                    expr_text_of(facet_expr_of(compiler.status_facet))),
                  facet_path_of(compiler.status_facet)),
                subject_name_of(compiler.subject)),
              subject_capability_of(compiler.subject)),
            subject_target_of(compiler.subject)),
          rule_name_of(compiler.rule)),
        rule_alter_value_of(compiler.rule)),
      rule_witness_of(compiler.rule))

  reckon string_index(strings : Sequence, value : Text) -> Number =
    find_text(strings, 0, value)

  reckon instruction_op_at(index : Number) -> Number =
    choose(index == 0, 2,
      choose(index == 1, 5,
        choose(index == 2, 3,
          choose(index == 3, 5,
            choose(index == 4, 22,
              choose(index == 5, 4,
                choose(index == 6, 21,
                  choose(index == 7, 23,
                    choose(index == 8, 24,
                      choose(index == 9, 3,
                        choose(index == 10, 25,
                          choose(index == 11, 26,
                            choose(index == 12, 4,
                              choose(index == 13, 3,
                                choose(index == 14, 10,
                                  choose(index == 15, 27,
                                    choose(index == 16, 26,
                                      choose(index == 17, 28,
                                        choose(index == 18, 29,
                                          choose(index == 19, 4,
                                            choose(index == 20, 21,
                                              choose(index == 21, 23,
                                                choose(index == 22, 24,
                                                  choose(index == 23, 3,
                                                    choose(index == 24, 25,
                                                      choose(index == 25, 26,
                                                        choose(index == 26, 4,
                                                          choose(index == 27, 3,
                                                            choose(index == 28, 10,
                                                              choose(index == 29, 27,
                                                                choose(index == 30, 26,
                                                                  choose(index == 31, 28,
                                                                    choose(index == 32, 29, 31)))))))))))))))))))))))))))))))))

  reckon instruction_a_at(index : Number, strings : Sequence) -> Number =
    choose(index == 0, 1,
      choose(index == 1, string_index(strings, facet_path_of(compiler.ready_facet)),
        choose(index == 2, string_index(strings, expr_text_of(facet_expr_of(compiler.status_facet))),
          choose(index == 3, string_index(strings, facet_path_of(compiler.status_facet)),
            choose(index == 4, string_index(strings, subject_name_of(compiler.subject)),
              choose(index == 5, string_index(strings, rule_when_path_of(compiler.rule)),
                choose(index == 6, 19,
                  choose(index == 7, 0,
                    choose(index == 8, string_index(strings, rule_cause_of(compiler.rule)),
                      choose(index == 9, string_index(strings, rule_alter_value_of(compiler.rule)),
                        choose(index == 10, string_index(strings, rule_alter_target_of(compiler.rule)),
                          choose(index == 11, 1,
                            choose(index == 12, string_index(strings, rule_preserve_left_of(compiler.rule)),
                              choose(index == 13, string_index(strings, rule_preserve_right_of(compiler.rule)),
                                choose(index == 14, 0,
                                  choose(index == 15, 0,
                                    choose(index == 16, 0,
                                      choose(index == 17, string_index(strings, rule_witness_of(compiler.rule)),
                                        choose(index == 18, 0,
                                          choose(index == 19, string_index(strings, rule_when_path_of(compiler.rule)),
                                            choose(index == 20, 33,
                                              choose(index == 21, 1,
                                                choose(index == 22, string_index(strings, rule_cause_of(compiler.rule)),
                                                  choose(index == 23, string_index(strings, rule_alter_value_of(compiler.rule)),
                                                    choose(index == 24, string_index(strings, rule_alter_target_of(compiler.rule)),
                                                      choose(index == 25, 1,
                                                        choose(index == 26, string_index(strings, rule_preserve_left_of(compiler.rule)),
                                                          choose(index == 27, string_index(strings, rule_preserve_right_of(compiler.rule)),
                                                            choose(index == 28, 0,
                                                              choose(index == 29, 0,
                                                                choose(index == 30, 0,
                                                                  choose(index == 31, string_index(strings, rule_witness_of(compiler.rule)),
                                                                    choose(index == 32, 0, 0)))))))))))))))))))))))))))))))))

  reckon instruction_b_at(index : Number, strings : Sequence) -> Number =
    choose(index == 4, string_index(strings, subject_capability_of(compiler.subject)),
      choose(index == 7, string_index(strings, rule_name_of(compiler.rule)),
        choose(index == 8, string_index(strings, rule_need_capability_of(compiler.rule)),
          choose(index == 21, string_index(strings, rule_name_of(compiler.rule)),
            choose(index == 22, string_index(strings, rule_need_capability_of(compiler.rule)), 0)))))

  reckon instruction_c_at(index : Number, strings : Sequence) -> Number =
    choose(index == 4, string_index(strings, subject_target_of(compiler.subject)),
      choose(index == 7, string_index(strings, rule_cause_of(compiler.rule)),
        choose(index == 8, string_index(strings, rule_need_target_of(compiler.rule)),
          choose(index == 21, string_index(strings, rule_cause_of(compiler.rule)),
            choose(index == 22, string_index(strings, rule_need_target_of(compiler.rule)), 0)))))

  reckon build_instruction_values(index : Number, strings : Sequence, selector : Number, output : Sequence) -> Sequence =
    choose(index >= 34, output,
      build_instruction_values(
        index + 1,
        strings,
        selector,
        sequence_append(
          output,
          choose(selector == 0, instruction_op_at(index),
            choose(selector == 1, instruction_a_at(index, strings),
              choose(selector == 2, instruction_b_at(index, strings), instruction_c_at(index, strings)))))))

  reckon encode_string_record(value : Text) -> Sequence =
    sequence_concat(bytes_u32le(length(utf8_bytes(value))), utf8_bytes(value))

  reckon encode_string_pool(items : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(items), output,
      encode_string_pool(items, index + 1, sequence_concat(output, encode_string_record(sequence_get(items, index)))))

  reckon encode_instruction(op : Number, a : Number, b : Number, c : Number) -> Sequence =
    sequence_concat(
      bytes_u8(op),
      sequence_concat(
        bytes_u8(0),
        sequence_concat(
          bytes_u16le(0),
          sequence_concat(
            bytes_i32le(a),
            sequence_concat(bytes_i32le(b), bytes_i32le(c))))))

  reckon encode_instruction_plan(op_values : Sequence, a_values : Sequence, b_values : Sequence, c_values : Sequence, index : Number, output : Sequence) -> Sequence =
    choose(index >= length(op_values), output,
      encode_instruction_plan(
        op_values,
        a_values,
        b_values,
        c_values,
        index + 1,
        sequence_concat(
          output,
          encode_instruction(
            sequence_get(op_values, index),
            sequence_get(a_values, index),
            sequence_get(b_values, index),
            sequence_get(c_values, index)))))

  reckon encode_rbc_header(program_index : Number, root_index : Number, string_count : Number, number_count : Number, instruction_count : Number) -> Sequence =
    sequence_concat(
      utf8_bytes("RCLB"),
      sequence_concat(
        bytes_u16le(1),
        sequence_concat(
          bytes_u16le(1),
          sequence_concat(
            bytes_u32le(0),
            sequence_concat(
              bytes_u32le(program_index),
              sequence_concat(
                bytes_u32le(root_index),
                sequence_concat(
                  bytes_u32le(string_count),
                  sequence_concat(
                    bytes_u32le(number_count),
                    sequence_concat(bytes_u32le(instruction_count), bytes_u32le(0))))))))))

  reckon encode_target_rbc(strings : Sequence, ops : Sequence, a_values : Sequence, b_values : Sequence, c_values : Sequence) -> Sequence =
    sequence_concat(
      encode_rbc_header(0, 1, length(strings), 0, length(ops)),
      sequence_concat(
        encode_string_pool(strings, 0, empty_sequence()),
        encode_instruction_plan(ops, a_values, b_values, c_values, 0, empty_sequence())))

  facet parser.tokens : Sequence = tokenize_from(source.full, 0, 1, 1, empty_sequence())
  facet parser.token_count : Number = length(parser.tokens)
  facet parser.first_token : Text = token_text(sequence_get(parser.tokens, 0))
  facet parser.program_token : Text = token_text(sequence_get(parser.tokens, 1))
  facet parser.body_open : Text = token_text(sequence_get(parser.tokens, 2))
  facet parser.subject_start : Number = find_token_text(parser.tokens, 3, "subject")
  facet parser.emergence_start : Number = find_token_text(parser.tokens, 3, "emergence")
  facet parser.foresee_start : Number = find_token_text(parser.tokens, 3, "foresee")
  facet parser.realize_start : Number = find_token_text(parser.tokens, 3, "realize")
  facet parser.body_close : Text = token_text(sequence_get(parser.tokens, 65))
  facet parser.eof_kind : Text = token_kind(sequence_get(parser.tokens, 66))

  facet compiler.program : Text = checked_ident(parser.tokens, 1, "")
  facet compiler.ready_facet : Sequence = parse_literal_facet(parser.tokens, 3)
  facet compiler.status_facet : Sequence = parse_literal_facet(parser.tokens, after_literal_facet(parser.tokens, 3))
  facet compiler.subject : Sequence = parse_subject(parser.tokens, parser.subject_start)
  facet compiler.rule : Sequence = parse_emergence(parser.tokens, parser.emergence_start)
  facet compiler.foresee_rule : Text = checked_ident(parser.tokens, parser.foresee_start + 1, "")
  facet compiler.realize_rule : Text = checked_ident(parser.tokens, parser.realize_start + 1, "")
  facet compiler.facet_count : Number = 2
  facet compiler.subject_count : Number = 1
  facet compiler.warrant_count : Number = 1
  facet compiler.emergence_count : Number = 1
  facet compiler.directive_count : Number = 2
  facet compiler.rule_source_lowering_supported : Truth =
    semantic_assert(
      compiler.facet_count == 2
        and compiler.subject_count == 1
        and compiler.warrant_count == 1
        and compiler.emergence_count == 1
        and compiler.directive_count == 2
        and facet_path_of(compiler.ready_facet) == "world.ready"
        and expr_text_of(facet_expr_of(compiler.ready_facet)) == "true"
        and facet_path_of(compiler.status_facet) == "world.status"
        and expr_text_of(facet_expr_of(compiler.status_facet)) == "draft"
        and subject_name_of(compiler.subject) == "founder"
        and subject_capability_of(compiler.subject) == "world.publish"
        and subject_target_of(compiler.subject) == "world"
        and rule_name_of(compiler.rule) == "publish"
        and rule_cause_of(compiler.rule) == "founder"
        and rule_when_path_of(compiler.rule) == "world.ready"
        and rule_need_capability_of(compiler.rule) == "world.publish"
        and rule_need_target_of(compiler.rule) == "world"
        and rule_alter_target_of(compiler.rule) == "world.status"
        and rule_alter_value_of(compiler.rule) == "published"
        and rule_preserve_left_of(compiler.rule) == "world.status"
